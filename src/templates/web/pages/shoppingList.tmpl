{{ define "content" }}

<header class="page-header">
    <div class="page-header__lead">
        <h1 class="eyebrow">{{ t "nav.shoppingList" }}</h1>
        <div class="page-header__count">{{ .ItemCount }}</div>
        <p class="page-header__sub">{{ t "shoppingList.itemsNeeded" }}</p>
    </div>
    <div class="page-header__aside">
        <div class="page-header__meta">{{ t "shoppingList.checkedOff" .CheckedCount }}</div>
        <button class="btn btn-outline theme-secondary d-none md:d-flex align-items-center gap-3" id="btnPrintShoppingList" type="button">
            <i class="bi bi-printer"></i> {{ t "shoppingList.printList" }}
        </button>
    </div>
</header>

{{ if .HasAutoItems }}
<div class="shopping-list-import-banner mb-5" id="importBanner">
    <div class="import-banner-header" data-bs-toggle="collapse" data-bs-target="#importCollapse" aria-expanded="false">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-cart-plus"></i>
            <span>{{ tn "shoppingList.belowThresholdCount" .AutoItemCount }}</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-sm btn-solid theme-primary" id="btnImportAll">
                {{ t "shoppingList.importAll" }}
            </button>
            <i class="bi bi-chevron-down"></i>
        </div>
    </div>
    <div class="collapse" id="importCollapse">
        <div class="import-banner-body">
            <p class="mb-3 small fg-secondary">{{ t "shoppingList.importBannerDesc" }}</p>
            <div class="d-flex flex-wrap gap-3">
                {{ range .AutoItems }}
                <span class="filter-pill">{{ .ProductName }}</span>
                {{ end }}
            </div>
        </div>
    </div>
</div>
{{ end }}

<div class="shopping-list-add-form mb-5" id="addItemForm">
    <div class="add-item-form-inner">
        <input type="text" class="form-control" id="inputItemName" placeholder="{{ t "shoppingList.itemName" }}" aria-label="{{ t "shoppingList.itemName" }}">
        <div class="qty-stepper">
            <button type="button" data-item-quantity-step="-1" aria-label="{{ t "shoppingList.decreaseQuantityLabel" }}">−</button>
            <input type="number" id="inputItemQuantity" value="1" min="1" placeholder="{{ t "shoppingList.qty" }}" aria-label="{{ t "shoppingList.quantity" }}">
            <button type="button" data-item-quantity-step="1" aria-label="{{ t "shoppingList.increaseQuantityLabel" }}">+</button>
        </div>
        <button type="button" class="btn btn-solid theme-primary" id="btnAddItem" aria-label="{{ t "shoppingList.addItem" }}">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
        </button>
    </div>
</div>

{{ if .Items }}
<div id="shoppingListContainer" class="card shopping-list">
    <div class="card-header shopping-list__header">
        <div class="shopping-list__cell shopping-list__cell--check">
            <input type="checkbox" id="selectAll" class="list-checkbox" aria-label="{{ t "shoppingList.selectAllItems" }}">
        </div>
        <div class="shopping-list__cell shopping-list__cell--name">{{ t "shoppingList.itemColumn" }}</div>
        <div class="shopping-list__cell shopping-list__cell--trailing">{{ t "shoppingList.qty" }}</div>
    </div>

    <div class="list-group list-group-flush">
    {{ range $item := .ItemsSorted }}
    <div class="list-group-item shopping-list__item{{ if $item.Checked }} checked{{ end }}" data-id="{{ $item.ID }}" id="item-{{ $item.ID }}">
        <div class="list-group-item__leading shopping-list__cell shopping-list__cell--check">
            <input type="checkbox" class="item-checkbox list-checkbox"{{ if $item.Checked }} checked{{ end }} data-item-id="{{ $item.ID }}" aria-label="{{ t "shoppingList.markAsDone" $item.Name }}">
        </div>
        <div class="list-group-item__body shopping-list__cell shopping-list__cell--name">
            <div class="list-group-item__title{{ if $item.Checked }} text-decoration-line-through fg-secondary{{ end }}">{{ $item.Name }}</div>
            {{ with $item.PackSize }}
            <div class="list-group-item__meta">{{ . }}</div>
            {{ end }}
        </div>
        <div class="list-group-item__trailing shopping-list__cell shopping-list__cell--trailing">
            <div class="qty-stepper qty-stepper-flat">
                <button type="button" data-qty-action="dec" data-item-id="{{ $item.ID }}" aria-label="{{ t "shoppingList.decreaseQuantity" $item.Name }}">−</button>
                <span id="qty-{{ $item.ID }}" class="qty-amount" data-quantity="{{ $item.Quantity }}">{{ quantityLabel $item.Quantity }}</span>
                <button type="button" data-qty-action="inc" data-item-id="{{ $item.ID }}" aria-label="{{ t "shoppingList.increaseQuantity" $item.Name }}">+</button>
            </div>
            <div class="shopping-list__actions">
                <button type="button" class="btn-icon fg-secondary" data-buy-item="{{ $item.ID }}" title="{{ t "shoppingList.buyItem" }}" aria-label="{{ t "shoppingList.buyItemLabel" $item.Name }}">
                    <i class="bi bi-bag-check" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn-icon fg-secondary" data-notes-toggle="{{ $item.ID }}" title="{{ t "shoppingList.notes" }}" aria-label="{{ t "shoppingList.toggleNotes" $item.Name }}">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn-icon fg-danger" data-delete-item="{{ $item.ID }}" title="{{ t "common.delete" }}" aria-label="{{ t "shoppingList.deleteItemLabel" $item.Name }}">
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="shopping-list__notes" id="notes-{{ $item.ID }}">
            <input type="text" class="form-control form-control-sm" id="notesInput-{{ $item.ID }}" aria-label="{{ t "shoppingList.notesFor" $item.Name }}" placeholder="{{ t "shoppingList.addNotes" }}" value="{{ $item.Notes }}" data-notes-input="{{ $item.ID }}">
        </div>
    </div>
    {{ end }}
    </div>
</div>
{{ else }}
<div class="empty">
    <div class="empty-icon">
        <i class="bi bi-cart3"></i>
    </div>
    <div class="empty-title">{{ t "shoppingList.emptyTitle" }}</div>
    <div class="empty-desc">{{ t "shoppingList.emptyDesc" }}</div>
</div>
{{ end }}

<!-- Purchase dialog: a list item becomes a product of the household -->
<dialog class="dialog" id="purchaseItemDialog" aria-labelledby="purchaseItemDialogLabel">
    <div class="dialog-header">
        <div class="dialog-icon dialog-icon-accent">
            <i class="bi bi-bag-check"></i>
        </div><h5 class="dialog-title mb-0" id="purchaseItemDialogLabel">{{ t "shoppingList.purchaseTitle" }}</h5>
        <div class="dialog-subtitle" id="purchaseItemName"></div>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}">
            <i class="bi bi-x"></i>
        </button>
    </div>
    <form id="purchaseForm" data-bs-validate novalidate>
        <div class="dialog-body">
            <label class="form-label" for="purchaseQuantity">{{ t "shoppingList.purchaseQuantity" }}</label>
            <input type="number" class="form-control mb-5" id="purchaseQuantity" min="1" value="1" required>

            <p class="small fg-secondary d-none mb-5" id="purchaseExistingProduct"></p>

            <div data-purchase-field="expiry">
                <label class="form-label" for="purchaseExpiry">
                    {{ t "shoppingList.purchaseExpiry" }} <span class="fg-danger" aria-hidden="true">*</span>
                </label>
                <input type="date" class="form-control mb-5" id="purchaseExpiry" aria-required="true">
                <small id="purchaseExpiryHint" class="fg-secondary d-none mb-5" aria-live="polite"></small>
            </div>

            <div data-purchase-field="category">
                <label class="form-label" for="purchaseCategory">{{ t "shoppingList.purchaseCategory" }}</label>
                <select class="form-control mb-5" id="purchaseCategory" aria-label="{{ t "shoppingList.purchaseCategory" }}">
                    <option value="">{{ t "shoppingList.purchaseNoneOption" }}</option>
                </select>
            </div>

            <div data-purchase-field="packSize">
                <label class="form-label" for="purchasePackSize">{{ t "shoppingList.purchasePackSize" }}</label>
                <input type="text" class="form-control mb-5" id="purchasePackSize" autocomplete="off">
            </div>

            <div data-purchase-field="location">
                <label class="form-label" for="purchaseStorageLocation">{{ t "shoppingList.purchaseStorageLocation" }}</label>
                <select class="form-control mb-5" id="purchaseStorageLocation" aria-label="{{ t "shoppingList.purchaseStorageLocation" }}">
                    <option value="">{{ t "shoppingList.purchaseNoneOption" }}</option>
                    {{ range .Locations }}
                    <option value="{{ .ID }}">{{ .Icon }} {{ .Name }}</option>
                    {{ end }}
                </select>
            </div>

            <div data-purchase-field="barcode">
                <label class="form-label" for="purchaseBarcode">{{ t "shoppingList.purchaseBarcode" }}</label>
                <input type="text" class="form-control mb-5" id="purchaseBarcode" inputmode="numeric" autocomplete="off">
            </div>
        </div>
        <div class="dialog-footer">
            <button type="button" class="btn btn-outline theme-secondary" data-bs-dismiss="dialog">{{ t "common.cancel" }}</button>
            <button type="submit" class="btn btn-solid theme-primary" id="btnPurchase">
                <span class="btn-label"><i class="bi bi-bag-check me-1" aria-hidden="true"></i>{{ t "shoppingList.purchaseSubmit" }}</span>
                <span class="btn-busy"><span class="spinner-border spinner-sm me-1" role="status" aria-hidden="true"></span>{{ t "shoppingList.purchaseSubmit" }}</span>
            </button>
        </div>
    </form>
</dialog>

<!-- The announcement lives outside the dialog: a closed dialog is hidden, and
     a live region inside it never announces. -->
<div id="purchaseAnnouncement" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>

<!-- The same-item prompt of the product list: the bought product matches one
     the household already has, and the user decides what happens with it. -->
{{ template "duplicateProductModal" . }}

<script type="application/json" id="shoppingListData">
{{ .ItemsJSON }}
</script>

<script type="application/json" id="shoppingListCategories">
{{ .CategoriesJSON }}
</script>

<script src="/assets/js/productsDuplicate.js"></script>
<script src="/assets/js/shoppingList.js"></script>

{{ end }}