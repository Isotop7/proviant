{{ define "content" }}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 invite-icon-wrapper">
                            <i class="bi bi-envelope-check fs-3 text-white"></i>
                        </div>
                        <h3 class="mt-3 mb-1">Email Verification</h3>
                    </div>

                    {{ if .Error }}
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>{{ .Error }}
                    </div>
                    <div class="text-center mt-3">
                        <a href="/web" class="btn btn-proviant-secondary">Go to Dashboard</a>
                    </div>

                    {{ else if .Success }}
                    <div class="alert alert-success" role="alert">
                        <i class="bi bi-check-circle me-2"></i>{{ .Success }}
                    </div>
                    <div class="text-center mt-3">
                        <a href="/web/auth" class="btn btn-proviant-primary">Log In</a>
                    </div>

                    {{ else if .Verifying }}
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-secondary-custom">Verifying your email address...</p>
                    </div>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>
</div>

{{ if .Verifying }}
<script src="/assets/js/verifyEmail.js"></script>
{{ end }}
{{ end }}
