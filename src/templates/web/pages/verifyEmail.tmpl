{{ define "content" }}
<div class="container py-12">
    <div class="row justify-content-center">
        <div class="col-12 md:col-8 lg:col-6">
            <div class="card">
                <div class="card-body p-7 p-md-5">
                    <div class="text-center mb-7">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-5 invite-icon-wrapper">
                            <i class="bi bi-envelope-check fs-2xl fg-white"></i>
                        </div>
                        <h1 class="mt-5 mb-1 h5">{{ t "verify.title" }}</h1>
                    </div>

                    {{ if .Error }}
                    <div class="alert alert theme-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>{{ .Error }}
                    </div>
                    <div class="text-center mt-5">
                        <a href="/web" class="btn btn-outline theme-secondary">{{ t "auth.goToDashboard" }}</a>
                    </div>

                    {{ else if .Success }}
                    <div class="alert alert theme-success" role="alert">
                        <i class="bi bi-check-circle me-2"></i>{{ .Success }}
                    </div>
                    <div class="text-center mt-5">
                        <a href="/web/auth" class="btn btn-solid theme-primary">{{ t "auth.logIn" }}</a>
                    </div>

                    {{ else if .Verifying }}
                    <div class="text-center">
                        <div class="spinner-border fg-primary mb-5" role="status">
                            <span class="visually-hidden">{{ t "verify.loading" }}</span>
                        </div>
                        <p class="fg-secondary">{{ t "verify.verifying" }}</p>
                    </div>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>
</div>

{{ if .Verifying }}
<script src="/assets/js/verifyEmail.js"></script>
{{ end }}
{{ end }}
