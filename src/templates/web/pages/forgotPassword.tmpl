{{ define "content" }}

<div class="auth">

  <!-- Form panel -->
  <div class="auth__form">
    <div class="auth__form-inner">

      <!-- Mobile logo (visible only on mobile) -->
      <div class="mobile-logo">
        <div class="mobile-logo-mark">P</div>
        <div class="mobile-logo-name">proviant</div>
      </div>

      <!-- Heading -->
      <div class="form-heading">
        <h1 class="form-heading-title">{{ t "reset.forgotTitle" }}</h1>
        <div class="form-heading-sub">{{ t "reset.forgotSubtitle" }}</div>
      </div>

      {{ if .Success }}
      <div class="alert alert theme-success" role="alert">
        <i class="bi bi-check-circle me-2"></i>{{ .Success }}
      </div>
      <div class="text-center mt-5">
        <a href="{{ .RouteAuth }}" class="btn btn-outline theme-secondary">{{ t "reset.backToSignIn" }}</a>
      </div>
      {{ else }}
      <form id="forgot-password-form" novalidate data-route-auth="{{ .RouteAuth }}">
        <div class="field">
          <label class="form-label" for="forgot-email">{{ t "reset.emailAddressLabel" }}</label>
          <div class="field-input-wrap">
            <input class="form-control" type="email" id="forgot-email"
              name="mailAddress" placeholder="{{ t "auth.emailPlaceholder" }}"
              autocomplete="email" required
              aria-describedby="forgot-email-error">
            <i class="bi bi-envelope field-icon" aria-hidden="true"></i>
          </div>
          <div class="invalid-feedback" id="forgot-email-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="forgot-email-error-text"></span>
          </div>
        </div>

        <button type="submit" class="btn btn-solid theme-primary w-100 mt-3" id="btn-forgot-submit">
          <i class="bi bi-envelope" id="btn-forgot-icon" aria-hidden="true"></i>
          <span id="btn-forgot-label">{{ t "reset.sendResetLink" }}</span>
        </button>

        <div class="text-center mt-5">
          <a href="{{ .RouteAuth }}" class="fg-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>{{ t "reset.backToSignIn" }}
          </a>
        </div>
      </form>
      {{ end }}

    </div>
  </div>

  {{ template "loginBrand" . }}
</div>

{{ if not .Success }}
<script src="/assets/js/forgotPassword.js"></script>
{{ end }}
{{ end }}
