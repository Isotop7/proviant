{{ define "content" }}

<div class="login-root">

  {{ template "loginBrand" . }}

  <!-- Form panel -->
  <div class="login-form-panel">
    <div class="login-form-inner">

      <!-- Mobile logo (visible only on mobile) -->
      <div class="mobile-logo">
        <div class="mobile-logo-mark">P</div>
        <div class="mobile-logo-name">proviant</div>
      </div>

      <!-- Heading -->
      <div class="form-heading">
        <div class="form-heading-title">Reset your password</div>
        <div class="form-heading-sub">Enter the email address on your account and we'll send you a reset link.</div>
      </div>

      {{ if .Success }}
      <div class="alert alert-success" role="alert">
        <i class="bi bi-check-circle me-2"></i>{{ .Success }}
      </div>
      <div class="text-center mt-3">
        <a href="{{ .RouteAuth }}" class="btn btn-proviant-secondary">Back to Sign In</a>
      </div>
      {{ else }}
      <form id="forgot-password-form" novalidate data-route-auth="{{ .RouteAuth }}">
        <div class="field">
          <label class="field-label" for="forgot-email">Email address</label>
          <div class="field-input-wrap">
            <input class="field-input" type="email" id="forgot-email"
              name="mailAddress" placeholder="you@example.com"
              autocomplete="email" required
              aria-describedby="forgot-email-error">
            <i class="bi bi-envelope field-icon" aria-hidden="true"></i>
          </div>
          <div class="field-error" id="forgot-email-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="forgot-email-error-text"></span>
          </div>
        </div>

        <button type="submit" class="btn-submit" id="btn-forgot-submit">
          <i class="bi bi-envelope" id="btn-forgot-icon" aria-hidden="true"></i>
          <span id="btn-forgot-label">Send Reset Link</span>
        </button>

        <div class="text-center mt-3">
          <a href="{{ .RouteAuth }}" class="link-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Sign In
          </a>
        </div>
      </form>
      {{ end }}

    </div>
  </div>
</div>

{{ if not .Success }}
<script src="/assets/js/forgotPassword.js"></script>
{{ end }}
{{ end }}
