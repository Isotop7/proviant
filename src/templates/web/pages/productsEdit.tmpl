{{ define "content" }}
<div class="pv-edit-page-wrap">

  <!-- ── Mobile: topbar (hidden on desktop) ── -->
  <div class="d-flex align-items-center gap-3 p-3 border-bottom bg-body d-md-none">
    <a href="/web/products" class="text-fg-2 fs-4">
      <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
      <div class="mobile-topbar-title">Edit product</div>
      <div class="mobile-topbar-sub">#{{ .Product.ID }} · {{ .Product.ProductName }}</div>
    </div>
    <span class="badge-status badge-status-sm badge-{{ expiryStatusClass .Product.ExpireAt }}">
      <i class="bi bi-{{ expiryStatusIcon .Product.ExpireAt }}"></i> {{ expiryStatusLabel .Product.ExpireAt }}
    </span>
  </div>

  <!-- ── Mobile: image strip (hidden on desktop) ── -->
  <div class="d-flex align-items-center gap-3 p-3 border-bottom bg-body d-md-none">
    <div class="pv-mobile-thumb">
      {{ if .Product.ImageURL }}
       <img src="{{ .Product.ImageURL }}" alt="{{ .Product.ProductName }}">
      {{ end }}
      <i class="bi bi-image pv-mobile-thumb-icon"></i>
    </div>
    <div class="flex-grow-1 min-w-0">
      <div class="mobile-product-name">{{ .Product.ProductName }}</div>
      <div class="font-mono mobile-product-barcode">{{ .Product.Barcode }}</div>
    </div>
    <button type="button" id="btnMobilePhotoFocus" class="btn btn-sm btn-proviant-secondary">
      <i class="bi bi-image"></i> Photo
    </button>
  </div>

  <!-- ── Desktop: breadcrumb + page header (hidden on mobile) ── -->
  <div class="pv-breadcrumb-row d-none d-md-flex">
    <a href="/web/products"><i class="bi bi-box-seam"></i> Products</a>
    <i class="bi bi-chevron-right"></i>
    <span>Edit product</span>
  </div>
  <div class="pv-page-header d-none d-md-flex">
    <div>
      <div class="pv-page-title-row">
        <h1 class="pv-page-title">Edit product</h1>
        <span class="id-chip">#<span id="labelProductID">{{ .Product.ID }}</span></span>
      </div>
      <div class="pv-page-sub">Changes are saved after clicking Update product</div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge-status badge-{{ expiryStatusClass .Product.ExpireAt }}">
        <i class="bi bi-{{ expiryStatusIcon .Product.ExpireAt }}"></i>
        {{ expiryStatusLabel .Product.ExpireAt }}
      </span>
      <button type="button" class="btn btn-proviant-secondary btn-sm btn-add-to-shopping-list" data-product-id="{{ .Product.ID }}" title="Add to shopping list">
        <i class="bi bi-cart-plus"></i>
      </button>
    </div>
  </div>
  <form id="editProductForm">
    <div class="pv-edit-grid">

      <!-- ── LEFT: form cards ── -->
      <div class="pv-form-left">

        <!-- Identity card -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <div class="icon-chip"><i class="bi bi-tag"></i></div>
            <span class="fw-semibold">Identity</span>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Product name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="inputProductName" value="{{ .Product.ProductName }}" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Barcode</label>
              <div class="position-relative">
                <i class="bi bi-upc-scan position-absolute text-fg-3 input-icon-left"></i>
                <input type="text" class="form-control font-mono input-with-icon" value="{{ .Product.Barcode }}" readonly>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">
                <i class="bi bi-lock"></i> Private product
              </label>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="inputIsPrivate"
                  {{ if .Product.IsPrivate }}checked{{ end }}>
                <label class="form-check-label" for="inputIsPrivate">
                  Only visible to you
                </label>
              </div>
              <div class="form-text">Private products are hidden from other household members.</div>
            </div>
          </div>
        </div>

        <!-- Categories card -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <div class="icon-chip"><i class="bi bi-grid"></i></div>
            <span class="fw-semibold">Categories</span>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Product categories</label>
              <input type="hidden" id="categoriesHidden" value="{{ .Product.Categories }}">
              <div class="pv-tag-wrap" data-target="categoriesHidden" data-color="accent" data-readonly="true"></div>
            </div>
            <div class="mb-3">
              <label class="form-label">Countries sold in</label>
              <input type="hidden" id="countriesHidden" value="{{ .Product.Countries }}">
              <div class="pv-tag-wrap" data-target="countriesHidden" data-color="neutral" data-readonly="true"></div>
            </div>
          </div>
        </div>

        <!-- Expiry & inventory card -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <div class="icon-chip"><i class="bi bi-calendar-event"></i></div>
            <span class="fw-semibold">Expiry &amp; inventory</span>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Expiry date <span class="text-danger">*</span></label>
                <div class="d-flex align-items-center gap-2">
                  <input type="date" class="form-control font-mono flex-grow-1" id="inputExpireAt"
                    value="{{ .Product.ExpireAt | inputDate }}" required>
                  {{ if .Product.ExpireAt.IsZero }}
                  <button type="button" class="btn btn-sm btn-proviant-secondary" id="btnTodayExpiry" title="Set to today" aria-label="Set expiry date to today">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                  </button>
                  {{ end }}
                  <button type="button" class="btn btn-sm btn-proviant-secondary" id="btnScanExpiry" title="Scan expiry date" aria-label="Scan expiry date from photo">
                    <i class="bi bi-camera" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Amount</label>
                <div class="qty-stepper">
                  <button type="button" data-amount-step="-1">-</button>
                  <input type="number" id="inputAmount" value="{{ .Product.Amount }}" min="0">
                  <button type="button" data-amount-step="1">+</button>
                </div>
              </div>
            </div>
            <div class="mb-3 mt-3">
              <label class="form-label">Storage location</label>
              <select class="form-select" id="selectStorageLocation">
                <option value="">— None —</option>
                {{ range .Locations }}
                <option value="{{ .ID }}" {{ if and $.Product.StorageLocationID (eq (derefUint $.Product.StorageLocationID) .ID) }}selected{{ end }}>
                  {{ .Icon }} {{ .Name }}
                </option>
                {{ end }}
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Notification lead time</label>
              <input type="number" class="form-control" id="inputNotificationLeadDays"
                value="{{ if .Product.NotificationLeadDays }}{{ .Product.NotificationLeadDays }}{{ end }}"
                min="0" placeholder="Default: {{ .GlobalNotificationThresholdDays }}">
              <div class="form-text">Days before expiry to notify. Leave blank to use household default ({{ .GlobalNotificationThresholdDays }} days).</div>
            </div>
            <div class="mb-3">
              <label class="form-label">Min. stock amount</label>
              <input type="number" class="form-control" id="inputMinStockAmount"
                value="{{ .Product.MinStockAmount }}" min="0">
              <div class="form-text">Auto-add to shopping list when amount drops below this threshold.</div>
            </div>
            <div class="mb-3">
              <label class="form-label">Purchase price (EUR, optional)</label>
              <input type="number" class="form-control" id="inputPriceOverride"
                value="{{ if .Product.PriceOverride }}{{ .Product.PriceOverride }}{{ end }}"
                min="0" step="0.01" placeholder="e.g. 1.99">
              <div class="form-text">Used to compute waste savings. Leave blank to use category average.</div>
            </div>
            <div class="mb-3">
              <label class="form-label">Shelf life after opening</label>
              <div class="row g-3">
                <div class="col-md-6">
                  <input type="date" class="form-control font-mono" id="inputOpenedAt"
                    value="{{ if .Product.OpenedAt }}{{ .Product.OpenedAt | inputDate }}{{ end }}" max="{{ today }}">
                  <div class="form-text">When the product was opened. Used to compute a secondary expiry.</div>
                </div>
                <div class="col-md-6">
                  <input type="number" class="form-control" id="inputDaysAfterOpening"
                    value="{{ if .Product.DaysAfterOpening }}{{ .Product.DaysAfterOpening }}{{ end }}"
                    min="0" max="365" placeholder="e.g. 14">
                  <div class="form-text">Days the product is good after opening (e.g. 5 for cream cheese, 42 for jam).</div>
                </div>
              </div>
              {{ if .Product.OpenedAt }}
              <div class="mt-2">
                <button type="button" class="btn btn-sm btn-proviant-secondary" id="btnClearOpenedAt" aria-label="Clear opened date">
                  <i class="bi bi-x-circle"></i> Clear opened date
                </button>
              </div>
              {{ end }}
            </div>
          </div>
        </div>

        <!-- Desktop form actions (hidden on mobile) -->
        <div class="d-none d-md-flex gap-2 mb-3">
          <button class="btn btn-proviant-primary" type="submit">
            <i class="bi bi-check2"></i> Update product
          </button>
          <a href="/web/products" class="btn btn-proviant-secondary">Cancel</a>
          <div class="flex-grow-1"></div>
          {{ if $.IsArchived }}
          <button class="btn btn-proviant-secondary" type="button" id="btnRestoreProduct">
            <i class="bi bi-arrow-counterclockwise"></i> Restore
          </button>
          {{ end }}
          {{ if not $.IsArchived }}
          <button class="btn btn-proviant-secondary" type="button" id="btnConsumeProduct">
            <i class="bi bi-check-circle"></i> Consumed
          </button>
          {{ end }}
          <button class="btn btn-proviant-danger" type="button"
            data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash3"></i> Wasted
          </button>
        </div>

      </div><!-- /left -->

      <!-- ── RIGHT: product panel (hidden on mobile via CSS) ── -->
      <div class="pv-product-panel">

        <!-- Product image card -->
        <div class="pv-product-image-card">
          <div class="pv-product-image-area">
            {{ if .Product.ImageURL }}
            <img id="imgProduct" src="{{ .Product.ImageURL }}" alt="{{ .Product.ProductName }}" class="pv-img-product">
            {{ end }}
            <div id="imgProductFallback" class="pv-product-image-fallback">
              <i class="bi bi-image"></i>
              <span>No image</span>
            </div>
            <div class="pv-product-image-overlay">
              <button type="button" id="btnDesktopChangeImage">
                <i class="bi bi-image"></i> Change image
              </button>
            </div>
          </div>
          <div class="pv-product-info">
            <div class="pv-product-name-disp">{{ .Product.ProductName }}</div>
            <div class="pv-product-barcode-disp"><i class="bi bi-upc-scan"></i> {{ .Product.Barcode }}</div>
            <span class="badge-status badge-{{ expiryStatusClass .Product.ExpireAt }}">
              <i class="bi bi-{{ expiryStatusIcon .Product.ExpireAt }}"></i>
              {{ expiryStatusLabel .Product.ExpireAt }}
            </span>
          </div>
        </div>

        <!-- Image URL card -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <div class="icon-chip"><i class="bi bi-image"></i></div>
            <span class="fw-semibold">Image URL</span>
          </div>
          <div class="card-body py-3">
            <div class="mb-0">
              <input type="url" id="inputImageURL" class="form-control font-mono text-sm"
                value="{{ .Product.ImageURL }}" placeholder="https://…">
              <div class="form-text">Paste a URL or leave blank to remove the image</div>
            </div>
          </div>
        </div>

        <!-- Quick info card -->
        <div class="card mb-3">
          <div class="card-header d-flex align-items-center gap-2">
            <div class="icon-chip"><i class="bi bi-info-circle"></i></div>
            <span class="fw-semibold">Product info</span>
          </div>
          <div class="card-body product-info-body">
            <div class="product-info-row">
              <span class="text-fg-3">Status</span>
              <span class="badge-status badge-{{ expiryStatusClass .Product.ExpireAt }}">
                {{ expiryStatusLabel .Product.ExpireAt }}
              </span>
            </div>
            <div class="product-info-row product-info-row-sep">
              <span class="text-fg-3">Amount</span>
              <span class="font-mono fw-semibold">{{ .Product.Amount }}</span>
            </div>
            <div class="product-info-row product-info-row-sep">
              <span class="text-fg-3">Expiry Date</span>
              <span class="font-mono fw-semibold">{{ .Product.ExpireAt | humanDate }}</span>
            </div>
          </div>
        </div>

      </div><!-- /right panel -->

    </div><!-- /edit-grid -->
  </form>

  <!-- ── Mobile: sticky footer (hidden on desktop) ── -->
  <div class="d-flex gap-2 d-md-none mobile-sticky-footer">
    <button type="submit" form="editProductForm" class="btn btn-proviant-primary flex-grow-1">
      <i class="bi bi-check2"></i> Update product
    </button>
    <a href="/web/products" class="btn btn-proviant-secondary">Cancel</a>
    {{ if $.IsArchived }}
    <button type="button" class="btn btn-proviant-secondary" id="btnRestoreProductMobile">
      <i class="bi bi-arrow-counterclockwise"></i> Restore
    </button>
    {{ end }}
    {{ if not $.IsArchived }}
    <button type="button" class="btn btn-proviant-secondary" id="btnConsumeProductMobile">
      <i class="bi bi-check-circle"></i> Consumed
    </button>
    {{ end }}
    <button type="button" class="btn btn-proviant-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
      <i class="bi bi-trash3"></i>
    </button>
  </div>

</div><!-- /pv-edit-page-wrap -->

<!-- ── Delete confirmation modal ── -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-narrow">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-icon modal-icon-danger">
          <i class="bi bi-trash3-fill"></i>
        </div>
        <div class="modal-header-body">
          <h5 class="modal-title mb-0">Mark {{ .Product.ProductName }} as wasted?</h5>
        </div>
        <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
      <div class="modal-body">
        <p class="text-secondary-custom small mb-0">This product will be permanently marked as wasted. Consider marking as consumed instead if you want to keep the record.</p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
        <button id="btnConfirmDelete" class="btn btn-proviant-danger" type="button">
          <i class="bi bi-trash3"></i> Wasted
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── OCR Camera Modal ── -->
<div class="modal fade" id="ocrCameraModal" tabindex="-1" aria-labelledby="ocrCameraModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-icon modal-icon-accent">
          <i class="bi bi-camera"></i>
        </div>
        <div class="modal-header-body">
          <h5 class="modal-title mb-0" id="ocrCameraModalLabel">Scan Expiry Date</h5>
          <div class="modal-subtitle">Position expiry date in frame</div>
        </div>
        <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
      <div class="modal-body text-center">
        <div class="camera-preview-wrapper">
          <video id="ocrVideoPreview" autoplay playsinline class="camera-preview"></video>
        </div>
        <p class="text-secondary-custom small mt-2">Hold steady and tap Capture</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-proviant-primary" id="btnCaptureExpiry">
          <i class="bi bi-camera"></i> Capture
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── OCR Result Modal ── -->
<div class="modal fade" id="ocrResultModal" tabindex="-1" aria-labelledby="ocrResultModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-icon modal-icon-accent">
          <i class="bi bi-camera"></i>
        </div>
        <div class="modal-header-body">
          <h5 class="modal-title mb-0" id="ocrResultModalLabel">Expiry Date Scan</h5>
          <div class="modal-subtitle">Check the detected date</div>
        </div>
        <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
      <div class="modal-body">
        <div id="ocrPreviewImage" class="mb-3 text-center"></div>
        <div class="mb-3" id="ocrDetectedDate"></div>
        <div class="progress progress-sm mb-2">
          <div id="ocrConfidenceBar" class="progress-bar" role="progressbar" style="width:0%"></div>
        </div>
        <small class="text-secondary-custom" id="ocrConfidenceLabel">Confidence: 0%</small>
        <div id="ocrRawTextWrapper" class="mt-3 d-none">
          <label class="form-label">Raw OCR text</label>
          <textarea id="ocrRawText" class="form-control" rows="3" readonly></textarea>
          <div class="form-text">Date not detected confidently. Please check the text above and adjust the date manually.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-proviant-secondary" id="btnRecaptureExpiry">
          <i class="bi bi-camera"></i> Retake
        </button>
        <button type="button" class="btn btn-proviant-primary" id="btnConfirmExpiry">
          <i class="bi bi-check"></i> Confirm
        </button>
      </div>
    </div>
  </div>
</div>

{{ template "restockSuggestionModal" . }}

<script src="/assets/js/html5-qrcode.min.js"></script>
<script src="/assets/js/tag-input.js"></script>
<script src="/assets/js/productsEdit.js"></script>
<script src="/assets/js/productsExpiryOCR.js"></script>
{{ end }}
