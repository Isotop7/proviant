{{ define "content" }}
<div class="row justify-content-between p-3">
    <div class="col">
        <h2>Edit product
            <span class="badge bg-primary ms-3">#<span id="labelProductID">{{- .Product.ID -}}</span>
            </span>
        </h2>
    </div>
    
    <div class="row my-3 w-100">
        <div class="col col-9 g-3">
            <form id="editProductForm" class="needs-validation" novalidate>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputBarcode" class="form-label col-form-label">Barcode</label>
                    </div>
                    <div class="col col-9 font-monospace">
                        <input type="number" class="form-control" id="inputBarcode" value="{{- .Product.Barcode -}}"
                            disabled readonly>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputProductName" class="form-label col-form-label">Product Name</label>
                    </div>
                    <div class="col col-9">
                        <input type="text" class="form-control" id="inputProductName" value="{{- .Product.ProductName -}}">
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputImageURL" class="form-label col-form-label">Image URL</label>
                    </div>
                    <div class="col col-9">
                        <input type="url" class="form-control" id="inputImageURL" value="{{- .Product.ImageURL -}}">
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputCategories" class="form-label col-form-label">Categories</label>
                    </div>
                    <div class="col col-9">
                        <textarea type="text" class="form-control" id="inputCategories">
                            {{- .Product.Categories -}}
                        </textarea>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputCountries" class="form-label col-form-label">Countries</label>
                    </div>
                    <div class="col col-9">
                        <textarea type="text" class="form-control" id="inputCountries">
                            {{- .Product.Countries -}}
                        </textarea>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputExpireAt" class="form-label col-form-label">Expire At</label>
                    </div>
                    <div class="col col-9">
                        <div class="d-flex align-items-center gap-2">
                            <input type="date" class="form-control flex-grow-1" id="inputExpireAt"
                                value="{{- .Product.ExpireAt | inputDate }}">
                            <button type="button" class="btn btn-sm btn-proviant-secondary" id="btnScanExpiry" title="Scan expiry date from photo">
                                <i class="bi bi-camera"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputScannedAt" class="form-label col-form-label">Scanned At</label>
                    </div>
                    <div class="col col-9">
                        <input type="datetime" class="form-control" id="inputScannedAt"
                            value="{{- .Product.ScannedAt | humanDateTime -}}" disabled readonly>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputNotifiedAt" class="form-label col-form-label">Notified At</label>
                    </div>
                    <div class="col col-9">
                        <input type="datetime" class="form-control" id="inputNotifiedAt"
                            value="{{- .Product.NotifiedAt | humanDateTime -}}" disabled readonly>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputUpdatedAt" class="form-label col-form-label">Updated At</label>
                    </div>
                    <div class="col col-9">
                        <input type="datetime" class="form-control" id="inputUpdatedAt"
                            value="{{- .Product.UpdatedAt | humanDateTime -}}" disabled readonly>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="inputAmount" class="form-label col-form-label">Amount</label>
                    </div>
                    <div class="col col-9">
                        <input type="number" class="form-control" id="inputAmount" value="{{- .Product.Amount -}}" min="0">
                    </div>
                </div>
                {{ if .Locations }}
                <div class="row my-3">
                    <div class="col col-3 fw-bold">
                        <label for="selectStorageLocation" class="form-label col-form-label">Storage Location</label>
                    </div>
                    <div class="col col-9">
                        <select class="form-select" id="selectStorageLocation">
                            <option value="">— None —</option>
                            {{ range .Locations }}
                            <option value="{{ .ID }}"
                                {{ if and $.Product.StorageLocationID (eq (derefUint $.Product.StorageLocationID) .ID) }}selected{{ end }}>
                                {{ .Icon }} {{ .Name }}
                            </option>
                            {{ end }}
                        </select>
                    </div>
                </div>
                {{ end }}
                <div class="row my-3">
                    <div class="col col-3">
                        <button id="btnUpdateProduct" class="btn btn-proviant-secondary w-100 my-3" type="submit">
                            <i class="bi bi-floppy me-2"></i>
                            Update Product
                        </button>
                    </div>
                    <div class="col col-9"></div>
                </div>
            </form>
        </div>
        <div class="col col-3 m-auto p-5">
            <img id="imgProduct" src="{{- .Product.ImageURL -}}" class="img-fluid" alt="Image URL">
        </div>
    </div>
</div>

<!-- OCR Camera Modal -->
<div class="modal fade" id="ocrCameraModal" tabindex="-1" aria-labelledby="ocrCameraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icon" style="background:var(--accent-subtle);color:var(--accent);">
                    <i class="bi bi-camera"></i>
                </div>
                <div class="modal-header-body">
                    <h5 class="modal-title mb-0" id="ocrCameraModalLabel">Scan Expiry Date</h5>
                    <div class="modal-subtitle">Position expiry date in frame</div>
                </div>
                <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body text-center">
                <div class="camera-preview-wrapper">
                    <video id="ocrVideoPreview" autoplay playsinline class="camera-preview"></video>
                </div>
                <p class="text-body-secondary small mt-2">Hold steady and tap Capture</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-proviant-primary" id="btnCaptureExpiry">
                    <i class="bi bi-camera"></i> Capture
                </button>
            </div>
        </div>
    </div>
</div>

<!-- OCR Result Modal -->
<div class="modal fade" id="ocrResultModal" tabindex="-1" aria-labelledby="ocrResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icon" style="background:var(--accent-subtle);color:var(--accent);">
                    <i class="bi bi-camera"></i>
                </div>
                <div class="modal-header-body">
                    <h5 class="modal-title mb-0" id="ocrResultModalLabel">Expiry Date Scan</h5>
                    <div class="modal-subtitle">Check the detected date</div>
                </div>
                <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="ocrPreviewImage" class="mb-3 text-center"></div>
                <div class="mb-3" id="ocrDetectedDate"></div>
                <div class="progress mb-2" style="height: 8px;">
                    <div id="ocrConfidenceBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                </div>
                <small class="text-body-secondary" id="ocrConfidenceLabel">Confidence: 0%</small>
                <div id="ocrRawTextWrapper" class="mt-3 d-none">
                    <label class="form-label">Raw OCR text</label>
                    <textarea id="ocrRawText" class="form-control" rows="3" readonly></textarea>
                    <div class="form-text">Date not detected confidently. Please check the text above and adjust the date manually.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-proviant-secondary" id="btnRecaptureExpiry">
                    <i class="bi bi-camera"></i> Retake
                </button>
                <button type="button" class="btn btn-proviant-primary" id="btnConfirmExpiry">
                    <i class="bi bi-check"></i> Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/assets/js/html5-qrcode.min.js"></script>
<script src="/assets/js/productsEdit.js"></script>
<script src="/assets/js/productsExpiryOCR.js"></script>
{{ end }}


