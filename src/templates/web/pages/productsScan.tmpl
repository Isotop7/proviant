{{ define "content" }}

<div class="scan-page-header">
    <h1 class="scan-page-title">{{ t "scan.page.title" }}</h1>
    <div class="scan-page-sub">{{ t "scan.page.subtitle" }}</div>
</div>

<!-- Viewfinder -->
<div class="viewfinder-wrap">
    <div class="viewfinder" id="viewfinder" aria-label="{{ t "scan.viewfinder" }}">
        <div class="viewfinder-corner tl" aria-hidden="true"></div>
        <div class="viewfinder-corner tr" aria-hidden="true"></div>
        <div class="viewfinder-corner bl" aria-hidden="true"></div>
        <div class="viewfinder-corner br" aria-hidden="true"></div>
        <div class="scan-line" id="scanLine" aria-hidden="true"></div>
        <div id="barcode-reader-wrapper" class="barcode-reader-inset d-none">
            <div id="barcode-reader"></div>
        </div>
    </div>
</div>

<!-- Scan actions -->
<div class="scan-actions">
    <button class="btn btn-solid theme-primary w-100 d-flex align-items-center justify-content-center gap-3 py-5" type="button" id="btnScan" data-action="scan">
        <i class="bi bi-upc-scan barcode-scan-icon" aria-hidden="true"></i>
        <span>{{ t "scan.actions.scanBarcode" }}</span>
    </button>

    <div class="scan-divider">{{ t "scan.actions.or" }}</div>

    <button class="btn btn-outline theme-secondary w-100 d-flex align-items-center justify-content-center gap-3 py-3" type="button"
            data-bs-toggle="dialog" data-bs-target="#manualBarcodeModal">
        <i class="bi bi-keyboard" aria-hidden="true"></i>
        {{ t "scan.actions.manualEntry" }}
    </button>

    <div class="scan-divider">{{ t "scan.actions.or" }}</div>

    <button class="btn btn-outline theme-secondary w-100 d-flex align-items-center justify-content-center gap-3 py-3" type="button" id="btnBatchToggle">
        <i class="bi bi-stack" aria-hidden="true"></i>
        {{ t "scan.batchScan" }}
    </button>
</div>

<!-- Batch start panel — storage location chosen once, then scanning begins -->
<div id="batchStartPanel" class="product-data-panel d-none px-5 py-5" aria-label="{{ t "scan.batch.setupLabel" }}">
    <div class="card">
        <div class="card-body">
            <div class="fw-semibold mb-1">{{ t "scan.batchScan" }}</div>
            <div class="fg-secondary small mb-5">
                {{ t "scan.batch.description" }}
            </div>

            <label for="batchStorageLocation" class="form-label fw-medium small">{{ t "scan.storageLocation" }}</label>
            <select class="form-control mb-5" id="batchStorageLocation" aria-label="{{ t "scan.batch.storageLocationLabel" }}">
                <option value="">{{ t "scan.batch.noLocation" }}</option>
            </select>

            <div class="d-grid gap-3">
                <button type="button" class="btn btn-solid theme-primary" id="btnBatchStart">
                    <i class="bi bi-upc-scan me-2" aria-hidden="true"></i>{{ t "scan.batch.start" }}
                </button>
                <button type="button" class="btn btn-outline theme-secondary" id="btnBatchCancelStart">
                    {{ t "common.cancel" }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Batch confirm panel — one entry per scan while the camera stays live -->
<div id="batchConfirmPanel" class="product-data-panel d-none px-5 py-5" aria-label="{{ t "scan.batch.confirmLabel" }}">
    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center gap-5 mb-5">
                <div class="flex-shrink-0 batch-thumb-wrap">
                    <i id="batchProductPlaceholder" class="bi bi-upc batch-thumb-icon" aria-hidden="true"></i>
                </div>
                <div class="flex-grow-1">
                    <div id="batchProductName" class="fw-semibold">{{ t "scan.batch.scanning" }}</div>
                    <div id="batchProductBarcode" class="fg-secondary small font-monospace"></div>
                </div>
            </div>

            <label class="form-label fw-medium small">{{ t "scan.quantity" }}</label>
            <div class="d-flex align-items-center gap-3 mb-5">
                <button type="button" class="btn btn-outline theme-secondary" id="btnBatchQuantityDec" aria-label="{{ t "scan.quantityDecrease" }}">-</button>
                <span id="batchQuantityDisplay" class="fs-lg px-3" aria-live="polite">1</span>
                <button type="button" class="btn btn-outline theme-secondary" id="btnBatchQuantityInc" aria-label="{{ t "scan.quantityIncrease" }}">+</button>
            </div>
            <input type="hidden" id="batchQuantity" value="1">

            <label for="batchExpireAt" class="form-label fw-medium small">
                {{ t "scan.expiryDate" }} <span class="fg-danger" aria-hidden="true">*</span>
            </label>
            <input type="date" class="form-control mb-3" id="batchExpireAt" required aria-required="true">
            <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "scan.expiryDateRequired" }}</div>

            <div class="btn-group w-100 mb-5" role="group" aria-label="{{ t "scan.expiryShortcuts" }}">
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="btnBatchExpireAdd3">{{ t "scan.expiryAdd3Days" }}</button>
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="btnBatchExpireAdd7">{{ t "scan.expiryAdd7Days" }}</button>
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="btnBatchExpireAdd1m">{{ t "scan.expiryAdd1Month" }}</button>
            </div>

            <div class="d-grid gap-3">
                <button type="button" class="btn btn-solid theme-primary" id="btnBatchAdd">
                    <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>{{ t "scan.batch.addToBatch" }}
                </button>
                <button type="button" class="btn btn-outline theme-secondary" id="btnBatchSkip">
                    {{ t "scan.batch.skip" }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Batch tally bar — fixed at the bottom while items are queued -->
<div id="batchTally" class="batch-tally d-none" aria-live="polite">
    <div class="batch-tally-info">
        <div id="batchTallyCount" class="fw-semibold">{{ tn "scan.batch.queuedItems" 0 }}</div>
        <div id="batchTallyLast" class="fg-secondary small text-truncate"></div>
    </div>
    <div class="d-flex gap-3">
        <button type="button" class="btn btn-outline theme-secondary" id="btnBatchUndo" aria-label="{{ t "scan.batch.undoLabel" }}">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            {{ t "scan.batch.undo" }}
        </button>
        <button type="button" class="btn btn-solid theme-primary" id="btnBatchDone">
            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ t "scan.batch.done" }}
        </button>
    </div>
</div>

<!-- Product data — revealed by JS after barcode lookup -->
<div id="productData" class="product-data-panel d-none px-5 py-5">
    <div class="card mb-5">
        <div class="card-body">
            <div class="d-flex align-items-center gap-5 mb-5">
                <div class="flex-shrink-0">
                    <img id="productInfoImage" src="" alt=""
                         class="rounded product-thumb">
                </div>
                <div class="flex-grow-1">
                    <div id="productInfoName" class="fw-semibold"></div>
                    <div id="productInfoGenericName" class="fg-secondary small"></div>
                </div>
            </div>

            <select class="form-control mb-5 d-none" id="instanceDropdown" aria-label="{{ t "scan.instanceSelect" }}"></select>

            <form id="formExpireAt" data-bs-validate novalidate>
                <label class="form-label fw-medium small">{{ t "scan.quantity" }}</label>
                <div class="d-flex align-items-center gap-3 mb-5">
                    <button type="button" class="btn btn-outline theme-secondary" id="btnQuantityDec" aria-label="{{ t "scan.quantityDecrease" }}">-</button>
                    <span id="quantityDisplay" class="fs-lg px-3" aria-live="polite">1</span>
                    <button type="button" class="btn btn-outline theme-secondary" id="btnQuantityInc" aria-label="{{ t "scan.quantityIncrease" }}">+</button>
                </div>
                <input type="hidden" id="quantity" value="1">

                <label for="expireAt" class="form-label fw-medium small">
                    {{ t "scan.expiryDate" }} <span class="fg-danger" aria-hidden="true">*</span>
                </label>
                <input type="date" class="form-control mb-3" id="expireAt"
                       value="{{ today }}" required aria-required="true">
                <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "scan.expiryDateRequired" }}</div>
            </form>

            <div class="btn-group w-100 mb-5" role="group" aria-label="{{ t "scan.expiryShortcuts" }}">
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="btnExpireAdd3">{{ t "scan.expiryAdd3Days" }}</button>
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="btnExpireAdd7">{{ t "scan.expiryAdd7Days" }}</button>
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="btnExpireAdd1m">{{ t "scan.expiryAdd1Month" }}</button>
            </div>
        </div>
    </div>

    <div class="d-grid mb-3">
        <button id="btnAddProduct" type="submit" class="btn btn-solid theme-primary">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>{{ t "scan.product.save" }}
        </button>
    </div>

    <div class="d-flex gap-3 mb-3" id="foundBarcode">
        <button id="btnShowProduct" type="button" class="btn btn-sm btn-outline theme-secondary flex-fill" disabled>
            <i class="bi bi-eye me-1" aria-hidden="true"></i>{{ t "scan.product.view" }}
        </button>
        <button id="btnShowProducts" type="button" class="btn btn-sm btn-outline theme-secondary flex-fill" disabled>
            <i class="bi bi-collection me-1" aria-hidden="true"></i>{{ t "scan.product.viewAll" }}
        </button>
    </div>

    <div class="d-flex gap-3">
        <button id="btnArchiveProductModal" type="button" class="btn btn-sm btn-outline theme-secondary flex-fill" disabled>
            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ t "scan.product.consumed" }}
        </button>
        <button id="btnDeleteProductModal" type="button" class="btn btn-sm btn-solid theme-danger flex-fill" disabled>
            <i class="bi bi-trash me-1" aria-hidden="true"></i>{{ t "common.delete" }}
        </button>
    </div>
</div>

<!-- Manual barcode entry dialog -->
<dialog class="dialog dialog-sm" id="manualBarcodeModal" aria-labelledby="manualBarcodeModalLabel">
            <div class="dialog-header">
                <div class="dialog-icon dialog-icon-subtle" aria-hidden="true">
                    <i class="bi bi-upc"></i>
                </div><h5 class="dialog-title mb-0" id="manualBarcodeModalLabel">{{ t "scan.manual.title" }}</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}"></button>
            </div>
            <div class="dialog-body">
                <form id="formBarcodeInput" data-bs-validate novalidate>
                    <label for="barcode" class="form-label fw-medium small">{{ t "scan.manual.eanLabel" }}</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-upc" aria-hidden="true"></i></span>
<input type="text" inputmode="numeric" pattern="[0-9]{13}"
		       class="form-control font-monospace" id="barcode"
		       placeholder="{{ t "scan.manual.barcodePlaceholder" }}" aria-label="{{ t "scan.manual.barcodeLabel" }}" data-barcode="">
                        <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "scan.manual.barcodeInvalid" }}</div>
                    </div>
                </form>
            </div>
            <div class="dialog-footer justify-content-end gap-3">
                <button type="button" class="btn btn-outline theme-secondary" data-bs-dismiss="dialog">{{ t "common.cancel" }}</button>
                <button type="button" class="btn btn-solid theme-primary" id="btnManualLookup" data-bs-dismiss="dialog">
                    {{ t "scan.manual.lookup" }}
                </button>
            </div>
        </dialog>

<script src="/assets/js/html5-qrcode.min.js"></script>
<script nonce="{{ .CSPNonce }}">
// On successful camera scan, activate the scan line animation
document.addEventListener('DOMContentLoaded', function () {
    const scanLine = document.getElementById('scanLine');
    const btnScan  = document.getElementById('btnScan');
    if (btnScan && scanLine) {
        btnScan.addEventListener('click', function () {
            if (this.dataset.action === 'scan') {
                scanLine.classList.add('active');
            } else {
                scanLine.classList.remove('active');
            }
        });
    }
    // Manual lookup: trigger barcode lookup when user confirms in dialog
    const btnManual = document.getElementById('btnManualLookup');
    if (btnManual) {
        btnManual.addEventListener('click', function () {
            const barcodeInput = document.getElementById('barcode');
            if (barcodeInput && barcodeInput.value) {
                barcodeInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    }
});
</script>
<script src="/assets/js/productsCreate.js"></script>
{{ end }}
