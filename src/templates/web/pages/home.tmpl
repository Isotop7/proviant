{{ define "content" }}

{{ if .DemoMode }}
<div class="alert alert-info text-center mb-0 py-2" role="alert">
    <i class="bi bi-info-circle-fill me-1"></i>
    <strong>{{ t "home.demoMode.title" }}</strong> — {{ t "home.demoMode.desc" }}
</div>
{{ end }}

{{ if .HasHousehold }}

<div aria-live="polite" aria-atomic="true" class="visually-hidden" id="dashboard-status"></div>

<h1 class="visually-hidden">{{ t "nav.dashboard" }}</h1>

<!-- Hero scan card — mobile only -->
<div class="px-3 pt-3 d-md-none">
    <a href="/web/products/scan" class="hero-scan-card mb-3" aria-label="{{ t "home.scanProduct" }}">
        <div>
            <div class="hero-label">{{ t "home.quickAction" }}</div>
            <div class="hero-title">{{ t "home.scanProduct" }}</div>
            <div class="hero-sub">{{ t "home.heroSub" }}</div>
            <div class="hero-pill"><i class="bi bi-upc-scan" aria-hidden="true"></i> {{ t "home.startScanning" }}</div>
        </div>
    </a>
</div>

<!-- The bento grid: the tiles, the lists and the charts share six columns -->
<div class="bento px-3 pt-3 pb-3">
    <div class="bento__items" id="dashboard"></div>

    <div class="bento__cell bento__cell--6" id="dashboard-list"></div>

    <div class="bento__cell bento__cell--3">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
                {{ t "home.wasteRate" }}
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="chartWaste" role="img" aria-label="{{ t "home.wasteChartAria" }}"></canvas>
            </div>
        </div>
    </div>

    <div class="bento__cell bento__cell--3">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-tags-fill"></i>
                </div>
                {{ t "home.categoryBreakdown" }}
            </div>
            <div class="card-body"><canvas id="chartCategories" role="img" aria-label="{{ t "home.categoriesChartAria" }}"></canvas></div>
        </div>
    </div>

    <div class="bento__cell bento__cell--6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                {{ t "home.expiryTrend" }}
            </div>
            <div class="card-body"><canvas id="chartExpiryTrend" role="img" aria-label="{{ t "home.expiryTrendChartAria" }}"></canvas></div>
        </div>
    </div>

    <div class="bento__cell bento__cell--3">
        <a href="/web/waste-analytics" class="card card-accent h-100 text-decoration-none text-reset">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-chip icon-chip-inverse" aria-hidden="true">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold">{{ t "home.viewWasteAnalytics" }}</div>
                    <div class="text-body-secondary small">{{ t "home.wasteAnalyticsDesc" }}</div>
                </div>
                <i class="bi bi-chevron-right text-body-secondary"></i>
            </div>
        </a>
    </div>

    <div class="bento__cell bento__cell--3">
        <a href="/web/recipes" class="card card-accent h-100 text-decoration-none text-reset">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-chip icon-chip-inverse" aria-hidden="true">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold">{{ t "home.whatCanIMake" }}</div>
                    <div class="text-body-secondary small">{{ t "home.recipesDesc" }}</div>
                </div>
                <i class="bi bi-chevron-right text-body-secondary"></i>
            </div>
        </a>
    </div>
</div>

<script src="/assets/js/chart.umd.min.js" defer></script>
<script src="/assets/js/homeStats.js" defer></script>

{{ else }}

<div class="empty">
    <div class="empty-icon">
        <i class="bi bi-emoji-dizzy-fill"></i>
    </div>
    <div class="empty-title">{{ t "home.noHouseholdTitle" }}</div>
    <div class="empty-desc">{{ t "home.noHouseholdDesc" }}</div>
    <a class="btn btn-primary" href="/web/user/settings#household">
        <i class="bi bi-people me-2"></i>
        {{ t "home.setUpHousehold" }}
    </a>
</div>

{{ end }}

{{ end }}
