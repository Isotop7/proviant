{{ define "content" }}
{{ if .Tiles }}
<div class="container row row-cols-1 row-cols-md-3 g-5">
    {{ range .Tiles }}
    <div class="col">
        <div class="card h-100 text-body-secondary mb-3">
            <div class="card-header">
                {{ .Title }}
            </div>
            <div class="card-body">
                <p class="card-title display-4 my-2 text-primary fw-bold">
                    {{ .Hero }}
                </p>
                <p class="card-text fw-light">
                    {{ .Body }}
                </p>
            </div>
            <div class="card-footer">
                <small class="font-monospace">
                    {{ .Footer }}
                </small>
            </div>
        </div>
    </div>
    {{ end }}
</div>
{{ else }}
<div class="container row text-center">
    <p class="fs-1">
        <i class="bi bi-emoji-dizzy-fill my-5 text-primary"></i>
    </p>
    <p class="fs-2 my-2">
        Oh no!
    </p>
    <p class="my-3">
        You need to add products first to see content on the portal page.
    </p>
    <div class="my-4">
        <a class="btn btn-outline-primary" href="/web/products/create">
            <i class="bi bi-cart-plus-fill me-2"></i>
            Create your first product
        </a>
    </div>
</div>
{{ end }}
{{ end }}