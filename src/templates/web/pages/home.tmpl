{{ define "content" }}

{{ if .DemoMode }}
<div class="alert alert theme-info text-center mb-0 py-3" role="alert">
    <i class="bi bi-info-circle-fill me-1"></i>
    <strong>{{ t "home.demoMode.title" }}</strong> — {{ t "home.demoMode.desc" }}
</div>
{{ end }}

{{ if .HasHousehold }}

<div aria-live="polite" aria-atomic="true" class="visually-hidden" id="dashboard-status"></div>

<h1 class="visually-hidden">{{ t "nav.dashboard" }}</h1>

<!-- Hero scan card — mobile only -->
<div class="px-5 pt-5 md:d-none">
    <a href="/web/products/scan" class="hero-scan-card mb-5" aria-label="{{ t "home.scanProduct" }}">
        <div>
            <div class="hero-label">{{ t "home.quickAction" }}</div>
            <div class="hero-title">{{ t "home.scanProduct" }}</div>
            <div class="hero-sub">{{ t "home.heroSub" }}</div>
            <div class="hero-pill"><i class="bi bi-upc-scan" aria-hidden="true"></i> {{ t "home.startScanning" }}</div>
        </div>
    </a>
</div>

<div class="dashboard-tools px-5 pt-5 d-flex justify-content-end">
    <button type="button" class="btn btn-link btn-sm" id="dashboard-reset-layout" disabled>
        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
        {{ t "home.resetLayout" }}
    </button>
</div>

<!-- The bento grid: the tiles, the lists and the charts share six columns.
     Every tile carries a data-tile name: the layout engine arranges them. -->
<div class="bento px-5 pb-5" id="dashboard">
    <div class="bento__cell bento__cell--6" data-tile="expiring-list" id="dashboard-list"></div>

    <div class="bento__cell bento__cell--3" data-tile="chart-waste">
        <div class="card h-100">
            <div class="card-header chart-card__header">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
                <div class="chart-card__headings">
                    <div class="chart-card__eyebrow">{{ t "home.wasteRate" }}</div>
                    <div class="chart-card__value" id="wasteRateValue">&mdash;</div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-frame">
                    <canvas id="chartWaste" role="img" aria-label="{{ t "home.wasteChartAria" }}"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="bento__cell bento__cell--3" data-tile="chart-categories">
        <div class="card h-100">
            <div class="card-header chart-card__header">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-tags-fill"></i>
                </div>
                <div class="chart-card__headings">
                    <div class="chart-card__eyebrow">{{ t "home.categoryBreakdown" }}</div>
                    <div class="chart-card__value" id="categoryCountValue">&mdash;</div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-frame">
                    <canvas id="chartCategories" role="img" aria-label="{{ t "home.categoriesChartAria" }}"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="bento__cell bento__cell--6" data-tile="chart-expiry">
        <div class="card h-100">
            <div class="card-header chart-card__header">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="chart-card__headings">
                    <div class="chart-card__eyebrow">{{ t "home.expiryTrend" }}</div>
                    <div class="chart-card__value" id="expiryTrendValue">&mdash;</div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-frame chart-frame--lg">
                    <canvas id="chartExpiryTrend" role="img" aria-label="{{ t "home.expiryTrendChartAria" }}"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="bento__cell bento__cell--3" data-tile="cta-waste" data-tile-label="{{ t "home.viewWasteAnalytics" }}">
        <a href="/web/waste-analytics" class="card card-accent h-100 text-decoration-none fg-body">
            <div class="card-body d-flex flex-row align-items-center gap-5">
                <div class="icon-chip icon-chip-inverse" aria-hidden="true">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold">{{ t "home.viewWasteAnalytics" }}</div>
                    <div class="fg-secondary small">{{ t "home.wasteAnalyticsDesc" }}</div>
                </div>
                <i class="bi bi-chevron-right fg-secondary"></i>
            </div>
        </a>
    </div>

    <div class="bento__cell bento__cell--3" data-tile="cta-recipes" data-tile-label="{{ t "home.whatCanIMake" }}">
        <a href="/web/recipes" class="card card-accent h-100 text-decoration-none fg-body">
            <div class="card-body d-flex flex-row align-items-center gap-5">
                <div class="icon-chip icon-chip-inverse" aria-hidden="true">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold">{{ t "home.whatCanIMake" }}</div>
                    <div class="fg-secondary small">{{ t "home.recipesDesc" }}</div>
                </div>
                <i class="bi bi-chevron-right fg-secondary"></i>
            </div>
        </a>
    </div>
</div>

<script src="/assets/js/chart.umd.min.js" defer></script>
<script src="/assets/js/chartTheme.js" defer></script>
<script src="/assets/js/homeStats.js" defer></script>
<script src="/assets/js/dashboardLayout.js" defer></script>

{{ else }}

<div class="empty">
    <div class="empty-icon">
        <i class="bi bi-emoji-dizzy-fill"></i>
    </div>
    <div class="empty-title">{{ t "home.noHouseholdTitle" }}</div>
    <div class="empty-desc">{{ t "home.noHouseholdDesc" }}</div>
    <a class="btn btn-solid theme-primary" href="/web/user/settings#household">
        <i class="bi bi-people me-2"></i>
        {{ t "home.setUpHousehold" }}
    </a>
</div>

{{ end }}

{{ end }}
