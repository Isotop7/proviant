{{ define "content" }}

{{ if .DemoMode }}
<div class="alert alert-info text-center mb-0 py-2" role="alert">
    <i class="bi bi-info-circle-fill me-1"></i>
    <strong>Demo Mode</strong> — This is a public demo instance. Data resets frequently.
</div>
{{ end }}

{{ if .HasHousehold }}

<div aria-live="polite" aria-atomic="true" class="visually-hidden" id="dashboard-status"></div>

<!-- Hero scan card — mobile only -->
<div class="px-3 pt-3 d-md-none">
    <a href="/web/products/scan" class="hero-scan-card mb-3" aria-label="Scan a product">
        <div>
            <div class="hero-label">Quick action</div>
            <div class="hero-title">Scan a product</div>
            <div class="hero-sub">Add to your pantry in seconds</div>
            <div class="hero-pill"><i class="bi bi-upc-scan" aria-hidden="true"></i> Start scanning</div>
        </div>
    </a>
</div>

<!-- Row 1: stat tiles -->
<div class="row row-cols-2 row-cols-md-4 g-3 px-3 pt-3 pb-2" id="dashboard"></div>

<!-- Row 2: expiring soon list + waste donut -->
<div class="row g-3 px-3 pb-3">
    <div class="col-md-7" id="dashboard-list"></div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
                Waste Rate
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="chartWaste" role="img" aria-label="Donut chart: ratio of expired to fresh active products"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: category breakdown + expiry trend -->
<div class="row g-3 px-3 pb-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-tags-fill"></i>
                </div>
                Category Breakdown
            </div>
            <div class="card-body"><canvas id="chartCategories" role="img" aria-label="Pie chart: product category breakdown"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                Expiry Trend (next 12 months)
            </div>
            <div class="card-body"><canvas id="chartExpiryTrend" role="img" aria-label="Line chart: products expiring over the next 12 months"></canvas></div>
        </div>
    </div>
</div>

<!-- Row 4: waste analytics CTA -->
<div class="row g-3 px-3 pb-3">
    <div class="col-12">
        <a href="/web/waste-analytics" class="card h-100 text-decoration-none text-reset" style="background:var(--accent-subtle);border:1px solid var(--border-subtle);">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-chip" aria-hidden="true" style="background:white;">
                    <i class="bi bi-bar-chart-line-fill" style="color:var(--accent);"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold">View waste analytics</div>
                    <div class="text-secondary-custom small">See what you consume versus waste, with monetary and CO₂ impact.</div>
                </div>
                <i class="bi bi-chevron-right text-secondary-custom"></i>
            </div>
        </a>
    </div>
</div>

<script src="/assets/js/chart.umd.min.js" defer></script>
<script src="/assets/js/homeStats.js" defer></script>

{{ else }}

<div class="container">
<div class="row text-center">
    <p class="fs-1">
        <i class="bi bi-emoji-dizzy-fill my-5 text-primary"></i>
    </p>
    <p class="fs-2 my-2">
        Oh no!
    </p>
    <p class="my-3">
        You are not connected to any household. Switch to the user settings to connect to a household or create a new one.
    </p>
    <div class="my-4">
        <a class="btn btn-proviant-primary" href="/web/user/settings#household">
            <i class="bi bi-people me-2"></i>
            Set up Household
        </a>
    </div>
</div>
</div>

{{ end }}

{{ end }}
