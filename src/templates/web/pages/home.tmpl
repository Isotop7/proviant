{{ define "content" }}

{{ if .HasHousehold }}

<div class="row row-cols-1 row-cols-md-3 g-4 px-3 pt-3 pb-2" id="dashboard">
    <!-- stat tiles injected here by homeStats.js -->
</div>
<div class="px-3 py-2">
    <hr class="mt-0 mb-1">
    <p class="text-body-secondary small mb-0 px-1 fw-medium">Trends</p>
</div>
<div class="row row-cols-1 row-cols-md-3 g-4 px-3 pb-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-header fw-bold">Waste Rate</div>
            <div class="card-body"><canvas id="chartWaste" role="img" aria-label="Donut chart: ratio of expired to fresh active products"></canvas></div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-header fw-bold">Category Breakdown</div>
            <div class="card-body"><canvas id="chartCategories" role="img" aria-label="Pie chart: product category breakdown"></canvas></div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-header fw-bold">Expiry Trend (next 12 months)</div>
            <div class="card-body"><canvas id="chartExpiryTrend" role="img" aria-label="Line chart: products expiring over the next 12 months"></canvas></div>
        </div>
    </div>
</div>
<script src="/assets/js/chart.umd.min.js"></script>
<script src="/assets/js/homeStats.js"></script>

{{ else }}

<div class="container row text-center">
    <p class="fs-1">
        <i class="bi bi-emoji-dizzy-fill my-5 text-primary"></i>
    </p>
    <p class="fs-2 my-2">
        Oh no!
    </p>
    <p class="my-3">
        You are not connected to any household. Switch to the user settings to connect to a household or create a new one.
    </p>
    <div class="my-4">
        <a class="btn btn-outline-primary" href="/web/user/settings">
            <i class="bi bi-house-add me-2"></i>
            Connect to household
        </a>
    </div>
</div>

{{ end }}

{{ end }}
