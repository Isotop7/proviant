{{ define "content" }}
<div class="py-2">
	<h2>Create new Product</h2>
</div>

<div class="row g-5 p-2">
	<div class="col-md-4 col-lg-5">
		<form id="createProductForm" class="needs-validation" novalidate>
			<div class="col-12">
				<label for="barcode" class="form-label">Barcode</label>
				<input type="number" class="form-control" id="barcode" placeholder="Barcode" required
					min="1000000000000" max="9999999999999">
				<small id="barcodeHelp" class="form-text text-muted">EAN-13 barcode on the product only</small>
				<div class="invalid-feedback">
					Barcode has to be a digit-only 13 character string
				</div>
				<div class="valid-feedback">
					Barcode seems to be valid. Use the 'Get Info' button to query data of product
				</div>
			</div>
			<div class="col-12">
				<label for="expireAt" class="form-label">Expires at</label>
				<input type="date" class="form-control" id="expireAt" placeholder="Expires at" value="{{ today }}"
					required>
				<div class="invalid-feedback">
					Please select the expiry date
				</div>
			</div>
			<hr class="my-4">
			<div class="btn-group w-100" role="group" aria-label="Basic example">
				<button id="btnCreateProduct" type="submit" class="btn btn-outline-primary btn-lg">
					<i class="bi bi-plus-circle-dotted me-2"></i>
					Create
				</button>
				<button id="btnQueryProductInfo" type="button" class="btn btn-outline-primary btn-lg">
					Get info
					<i class="bi bi-arrow-repeat ms-2"></i>
				</button>
			</div>
		</form>
		<div class="my-3">
			<div id="alertCreateProductInfo" class="alert" role="alert" style="display: none;">
			</div>
		</div>
	</div>
	<div class="col-md-8 col-lg-7 order-md-last align-middle h-100">
		<div id="alertQueryProductInfo" class="alert alert-warning" role="alert" style="display: none;">
		</div>

		<div class="position-relative">
			<div id="loadingSpinner" class="spinner-border text-primary position-absolute top-0 start-50" role="status" style="display: none;">
				<span class="visually-hidden">Loading...</span>
			</div>
		</div>

		<div id="productData" class="card mb-3" style="display: none;">
			<div class="row g-1">
				<div class="col-md-8 p-4">
					<div class="card-body">
						<h4 id="productInfoName" class="card-title"></h4>
						<p id="productInfoGenericName" class="card-text text-secondary"></p>
					</div>
				</div>
				<div class="col-md-4 p-4">
					<img id="productInfoImage" class="img-fluid rounded-end">
				</div>
			</div>
		</div>
	</div>
</div>

<script src="/assets/js/productsCreate.js"></script>
{{ end }}