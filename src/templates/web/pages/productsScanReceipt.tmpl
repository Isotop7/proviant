{{ define "content" }}

<div class="scan-page-header">
    <h1 class="scan-page-title">{{ t "receipt.title" }}</h1>
    <div class="scan-page-sub">{{ t "receipt.subtitle" }}</div>
</div>

<!-- Persistent screen reader status region (visually hidden) -->
<div id="receiptLiveStatus" class="visually-hidden" aria-live="polite"></div>

<!-- Step 1: capture / upload -->
<div id="receiptUploadStep">
    <div class="card mb-3">
        <div class="card-body">
            <form id="receiptUploadForm">
                <label for="receiptImage" class="form-label fw-medium small">{{ t "receipt.photo.label" }}</label>
                <input type="file" accept="image/*" capture="environment" class="form-control" id="receiptImage"
                       aria-describedby="receiptImageHelp" required aria-required="true">
                <div id="receiptImageHelp" class="form-text">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>{{ t "receipt.photo.help" }}
                </div>
            </form>
            <div class="d-grid mt-3">
                <button type="button" class="btn btn-primary" id="btnScanReceipt">
                    <i class="bi bi-receipt me-2" aria-hidden="true"></i>{{ t "receipt.scan.button" }}
                </button>
            </div>
            <div id="receiptScanProgress" class="d-none mt-3" aria-live="polite">
                <div class="progress" role="progressbar" aria-label="{{ t "receipt.scan.progressLabel" }}">
                    <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
                </div>
                <p class="text-body-secondary small mt-2 mb-0">{{ t "receipt.scan.progress" }}</p>
            </div>
        </div>
    </div>
</div>

<!-- Step 2: nothing recognized -->
<div id="receiptEmptyStep" class="d-none">
    <div class="card mb-3">
        <div class="card-body text-center py-4">
            <i class="bi bi-receipt fs-1 d-block mb-2 text-body-secondary" aria-hidden="true"></i>
            <p class="mb-3">{{ t "receipt.empty.text" }}</p>
            <div class="d-grid gap-2">
                <button type="button" class="btn btn-outline-secondary" id="btnRetryEmpty">
                    <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>{{ t "receipt.empty.tryAgain" }}
                </button>
                <a href="/web/products" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>{{ t "receipt.empty.addManually" }}
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Step 3: review & confirm -->
<div id="receiptReviewStep" class="d-none">
    <!-- Batch defaults -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="fw-semibold mb-2"><i class="bi bi-sliders me-2" aria-hidden="true"></i>{{ t "receipt.defaults.title" }}</div>
            <div class="row g-2">
                <div class="col-6">
                    <label for="batchExpireAt" class="form-label small mb-1">{{ t "scan.expiryDate" }}</label>
                    <input type="date" class="form-control" id="batchExpireAt">
                </div>
                <div class="col-6">
                    <label for="batchStorageLocation" class="form-label small mb-1">{{ t "scan.storageLocation" }}</label>
                    <select class="form-select" id="batchStorageLocation" aria-label="{{ t "scan.storageLocation" }}">
                        <option value="">{{ t "receipt.noneOption" }}</option>
                        {{ range .StorageLocations }}
                        <option value="{{ .ID }}">{{ .Name }}</option>
                        {{ end }}
                    </select>
                </div>
                <div class="col-6">
                    <label for="batchCategories" class="form-label small mb-1">{{ t "receipt.category.label" }}</label>
                    <input type="text" class="form-control" id="batchCategories" placeholder="{{ t "receipt.category.placeholder" }}" autocomplete="off">
                </div>
            </div>
        </div>
    </div>

    <!-- Items -->
    <div id="receiptItems" class="vstack gap-2 mb-3"></div>

    <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-outline-secondary flex-fill" id="btnRescanReceipt">
            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>{{ t "receipt.rescan" }}
        </button>
        <button type="button" class="btn btn-primary flex-fill" id="btnImportReceipt">
            <i class="bi bi-check-lg me-1" aria-hidden="true"></i>{{ t "receipt.import.addPrefix" }} <span id="receiptImportCount" aria-live="polite">0</span> {{ tn "receipt.import.items" 0 }}
        </button>
    </div>
    <div id="receiptImportProgress" class="d-none" aria-live="polite">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span class="ms-1">{{ t "receipt.import.progress" }}</span>
    </div>
</div>

<script nonce="{{ .CSPNonce }}">
window.RECEIPT_SCAN_MAX_ITEMS = {{ .MaxItems }};
window.RECEIPT_SCAN_TIMEOUT_SECONDS = {{ .ScanTimeoutSeconds }};
</script>
<script src="/assets/js/productsReceiptScan.js"></script>
{{ end }}
