<!doctype html>
<html lang="en" data-bs-theme="light" class="h-100">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if .Title }}{{ .Title}}{{ else }}proviant{{ end }}</title>
  <link rel="stylesheet" href="/assets/css/main.css">
</head>

<body class="align-items-center py-5 bg-secondary-subtle">
  <main>
    <div class="container text-center">
      <div class="text-danger error-icon">
        <i class="bi bi-bug-fill"></i>
      </div>
      <div>
        <div class="display-5 fw-bold my-4">
          Oops! Something went wrong.
        </div>
        <h4>We apologize for the inconvenience.</h4>
      </div>
      <div class="mt-4">
        <p>
          Please try again or contact support if the problem persists.
        </p>
      </div>
      <div class="mt-3">
        <a href="/" class="btn btn-proviant-primary">Return to Home</a>
      </div>
    </div>
  </main>
  <script src="/assets/js/bootstrap.bundle.min.js"></script>
</body>

</html>
