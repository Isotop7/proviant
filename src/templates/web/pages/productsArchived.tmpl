{{ define "content" }}

{{ if .Products }}

<div class="row justify-content-between p-3">
    <div class="text-center mb-4">
        <h2>My archived products</h2>
        <p class="text-muted">Use the cards to restore archived products or delete them permanently</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-lg-2 g-5">
    {{ range .Products }}

    {{ template "productArchivedCard" . }}

    {{ end }}
</div>

<script src="/assets/js/productsArchived.js"></script>

{{ else }}

{{ template "noproducts" . }}

{{ end }}

{{ end }}
