{{ define "content" }}

{{ if .Products }}

<div class="d-flex align-items-center justify-content-between px-3 pt-3 mb-3">
    <div>
        <h1 style="font-size:18px;font-weight:700;letter-spacing:-0.02em;margin:0;">Archive</h1>
        <p style="font-size:12px;color:var(--fg-3);margin:2px 0 0;">{{ len .Products }} archived items</p>
    </div>
    {{ template "productArchiveOptionBar" . }}
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-3">
    {{ range .Products }}

    {{ template "productArchivedCard" . }}

    {{ end }}
</div>

<script src="/assets/js/productsArchived.js"></script>

{{ else }}

{{ template "emptyArchive" . }}

{{ end }}

{{ end }}
