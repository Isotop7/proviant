{{ define "content" }}
<div class="my-3 text-bg-tertiary w-100">
    <div class="row g-0">
        <div class="col-md-3 m-auto">
            <img src="{{- .Product.ImageURL -}}" class="img-fluid" alt="Image URL">
        </div>
        <div class="ms-auto col-md-6">
            <div class="display-1 mb-4 fw-semibold">
                {{- .Product.ProductName -}}
            </div>
            <div class="row">
                <div class="col-4 fw-bold">
                    ID
                </div>
                <div class="col col-auto">
                    <span class="badge bg-primary">#{{- .Product.ID -}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-4 fw-bold">
                    Barcode
                </div>
                <div class="col col-auto font-monospace">
                    {{- .Product.Barcode -}}
                </div>
            </div>
            <div class="row">
                <div class="col-4 fw-bold">
                    Categories
                </div>
                <div class="col col-auto">
                    {{- .Product.Categories | badgifyCategories -}}
                </div>
            </div>
            <div class="row">
                <div class="col-4 fw-bold">
                    Countries
                </div>
                <div class="col col-auto">
                    {{- .Product.Countries | splitString -}}
                </div>
            </div>
            <div class="row mt-4" style="color: var(--bs-pink)">
                <div class="col-4 fw-bold">
                    <i class="bi bi-trash3 me-3"></i>{{- .Product.ExpireAt | humanDate -}}
                </div>
                <div class="col-4 fw-bold">
                    <i class="bi bi-upc-scan me-3"></i>{{- .Product.ScannedAt | humanDate -}}
                </div>
                <div class="col-4 fw-bold">
                    <i class="bi bi-bell me-3"></i>{{- .Product.NotifiedAt | humanDate -}}
                </div>
            </div>
        </div>
    </div>
</div>
{{ end }}