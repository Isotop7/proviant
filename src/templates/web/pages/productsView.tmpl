{{ define "content" }}
<div class="page-header">
    <div>
        <h1 class="page-header-title">{{ .Product.ProductName }}</h1>
        <p class="page-header-subtitle"><span class="id-chip">#{{ .Product.ID }}</span> <span class="font-mono ms-2">{{ .Product.Barcode }}</span></p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-proviant-secondary btn-add-to-shopping-list" data-product-id="{{ .Product.ID }}">
            <i class="bi bi-cart-plus"></i> Add to list
        </button>
        <a class="btn btn-proviant-secondary" href="/web/products/{{ .Product.ID }}/edit">
            <i class="bi bi-wrench"></i> Edit
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            {{ if .Product.ImageURL }}
            <img src="{{ .Product.ImageURL }}" class="card-img-top card-img-cover" alt="{{ .Product.ProductName }}">
            {{ else }}
            <div class="card-img-top d-flex align-items-center justify-content-center bg-subtle card-img-cover">
                <i class="bi bi-box-seam fs-1 text-fg-3"></i>
            </div>
            {{ end }}
            <div class="card-body">
                {{ if .Product.OpenedAt }}
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge-status badge-opened">
                        <i class="bi bi-box-open"></i> Opened {{ .Product.OpenedAt | humanDate }}
                    </span>
                    {{ if .Product.DaysAfterOpening }}
                    <span class="text-secondary-custom small">shelf life: {{ .Product.DaysAfterOpening }} day(s)</span>
                    {{ end }}
                </div>
                <div class="text-secondary-custom small">
                    Effective expiry: <strong>{{ effectiveExpireAt .Product | humanDate }}</strong> (use-by)
                </div>
                {{ end }}
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-info-circle"></i>
                </div>
                Product Details
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-secondary-custom small mb-1">Categories</div>
                        <div>{{ badgifyCategories .Product.Categories 5 }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-secondary-custom small mb-1">Countries</div>
                        <div>{{ flagReplace .Product.Countries }}</div>
                    </div>
                </div>
            </div>
        </div>

        {{ if and .Consumption .Consumption.TemplateMessage }}
        <div class="alert alert-info d-flex align-items-center mt-3" role="status" data-consumption-source="{{ .Consumption.Source }}">
            <i class="bi bi-graph-up-arrow me-2"></i>
            <span>{{ .Consumption.TemplateMessage }}</span>
        </div>
        {{ end }}

        <div class="card mt-3">
            <div class="card-header d-flex align-items-center gap-2 fw-bold">
                <div class="icon-chip" aria-hidden="true">
                    <i class="bi bi-clock-history"></i>
                </div>
                Metadata
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12 col-md-4 text-secondary-custom small">
                        <i class="bi bi-upc-scan me-1"></i>Scanned: {{ .Product.ScannedAt | humanDateTime }}
                    </div>
                    <div class="col-12 col-md-4 text-secondary-custom small">
                        <i class="bi bi-pencil me-1"></i>Updated: {{ .Product.UpdatedAt | humanDateTime }}
                    </div>
                    <div class="col-12 col-md-4 text-secondary-custom small">
                        <i class="bi bi-bell me-1"></i>Notified: {{ .Product.NotifiedAt | humanDateTime }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ template "restockSuggestionModal" . }}

<script src="/assets/js/productsEdit.js"></script>
{{ end }}
