{{ define "content" }}
<main class="form-signin w-100 m-auto">
    <form id="authData">
        <img class="mx-auto" src="/static/icons/logo_transparent.png" alt="" width="240">
        <h1 class="h3 mb-3 fw-normal">Sign in / Register</h1>
        <div class="form-floating">
            <input type="text" class="form-control" id="floatingInput" placeholder="Username" autocomplete="username">
            <label for="floatingInput">Username</label>
        </div>
        <div class="form-floating">
            <input type="password" class="form-control" id="floatingPassword" placeholder="Password" autocomplete="current-password">
            <label for="floatingPassword">Password</label>
        </div>
        <button id="auth" form="authData" class="btn btn-primary w-100 py-2" type="submit">Sign in</button>
    </form>
</main>
{{ end }}