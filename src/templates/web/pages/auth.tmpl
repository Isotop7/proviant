{{ define "content" }}

<div class="container vh-100 d-flex justify-content-center">
    <main class="form-signin">
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;">
            <div id="infoToast" class="toast pv-toast toast-success"
                 role="alert" aria-live="polite" aria-atomic="true" data-bs-delay="4000">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill toast-success-icon" aria-hidden="true"></i>
                    <span id="infoToastBody" class="toast-body-text"></span>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>

        {{ if .InviteToken }}
        <div class="alert alert-info mb-3" role="alert">
            <i class="bi bi-info-circle me-2"></i>You were invited to join a household. Please sign up using the <strong>exact email address</strong> you were invited with to automatically join.
        </div>
        {{ end }}

        <form id="authData" novalidate>
            {{ if .InviteToken }}
            <input type="hidden" id="inputInviteToken" name="inviteToken" value="{{ .InviteToken }}">
            {{ end }}
            <div class="mx-auto my-5 text-center">
                <img src="/assets/icons/hero.png" class="img-fluid" alt="proviant">
            </div>
            <div class="form-floating">
                <input type="text" class="form-control" id="inputUsername" placeholder="Username" autocomplete="username">
                <label for="inputUsername">Username</label>
            </div>
            <div class="form-floating">
                <input type="password" class="form-control" id="inputPassword" placeholder="Password"
                    autocomplete="current-password">
                <label for="inputPassword">Password</label>
            </div>
            <ul class="list-unstyled small mt-1">
                <li id="req-length"><i class="bi bi-circle me-1"></i>At least 8 characters</li>
                <li id="req-upper"><i class="bi bi-circle me-1"></i>At least one uppercase letter</li>
                <li id="req-digit"><i class="bi bi-circle me-1"></i>At least one number</li>
                <li id="req-special"><i class="bi bi-circle me-1"></i>At least one special character</li>
            </ul>
            <button id="btnAuth" form="authData" class="btn btn-proviant-primary w-100" type="submit">Sign in</button>
            <div id="loginAlert" class="alert alert-danger fade mt-3 d-none" role="alert">
                <span id="loginAlertMessage"></span>
            </div>
            <hr class="my-4 border-3 border-dark">
            <div class="form-floating">
                <input type="text" class="form-control" id="inputMailAddress" placeholder="Mail Address"
                    autocomplete="mailAddress">
                <label for="inputMailAddress">Mail Address</label>
            </div>
            <button id="btnSignup" form="authData" class="btn btn-proviant-primary w-100" type="submit">Sign up</button>
            <div id="signupAlert" class="alert alert-danger fade mt-3 d-none" role="alert">
                <span id="signupAlertMessage"></span>
            </div>
        </form>
    </main>
</div>

<!-- Email verification modal -->
<div class="modal fade" id="emailVerificationModal" tabindex="-1" aria-labelledby="emailVerificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="emailVerificationModalLabel"><i class="bi bi-envelope-check me-2"></i>Verify Your Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="bi bi-envelope-open text-info fs-1 mb-3 d-block"></i>
                <p class="mb-1">A verification email was sent to:</p>
                <p class="fw-semibold mb-3" id="emailVerificationAddress"></p>
                <p class="text-secondary-custom small mb-0">Click the link in the email to verify your address, then log in.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-proviant-primary" data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>

{{ end }}