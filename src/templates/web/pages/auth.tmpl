{{ define "content" }}

<div class="login-root">

  <!-- Brand panel (decorative, hidden on mobile) -->
  <aside class="login-brand" aria-hidden="true">
    <div class="brand-circle-sm"></div>

    <div class="brand-top">
      <div class="brand-logo">
        <div class="brand-logo-mark">P</div>
        <div class="brand-logo-name">proviant</div>
      </div>
      <div class="brand-headline">Less waste.<br>More meals.</div>
      <p class="brand-sub">Track what's in your pantry, get notified before things expire, and discover recipes with what you already have.</p>
    </div>

    <div class="brand-features">
      <div class="brand-feature">
        <div class="brand-feature-icon"><i class="bi bi-upc-scan" aria-hidden="true"></i></div>
        <div class="brand-feature-text">Scan barcodes to add products instantly</div>
      </div>
      <div class="brand-feature">
        <div class="brand-feature-icon"><i class="bi bi-bell" aria-hidden="true"></i></div>
        <div class="brand-feature-text">Get notified before items expire</div>
      </div>
      <div class="brand-feature">
        <div class="brand-feature-icon"><i class="bi bi-journal-richtext" aria-hidden="true"></i></div>
        <div class="brand-feature-text">Recipe suggestions from your pantry</div>
      </div>
      <div class="brand-feature">
        <div class="brand-feature-icon"><i class="bi bi-graph-down-arrow" aria-hidden="true"></i></div>
        <div class="brand-feature-text">Track savings and reduce food waste</div>
      </div>
    </div>

    <div class="brand-bottom">
        <a href="https://codeberg.org/Isotop7/proviant" class="brand-feature-text" target="_blank" rel="noopener"
			title="View source on Codeberg">
			<i class="bi bi-git" aria-hidden="true"></i> proviant@Codeberg
		</a>
    </div>
  </aside>

  <!-- Form panel -->
  <div class="login-form-panel">
    <div class="login-form-inner">

      <!-- Mobile logo (visible only on mobile) -->
      <div class="mobile-logo">
        <div class="mobile-logo-mark">P</div>
        <div class="mobile-logo-name">proviant</div>
      </div>

      <!-- Invite banner -->
      {{ if .InviteToken }}
      <div class="invite-banner" role="alert">
        <i class="bi bi-envelope-check" aria-hidden="true"></i>
        <span>You were invited to join a household. Sign up using the <strong>exact email address</strong> you were invited with to automatically join.</span>
      </div>
      {{ end }}

      <!-- Tab switcher -->
      <div class="auth-tabs" role="tablist">
        <button class="auth-tab active" id="tab-signin" data-mode="signin"
          role="tab" aria-selected="true" aria-controls="authForm">Sign in</button>
        <button class="auth-tab" id="tab-signup" data-mode="signup"
          role="tab" aria-selected="false" aria-controls="authForm">Create account</button>
      </div>

      <!-- Heading -->
      <div class="form-heading">
        <div class="form-heading-title" id="auth-heading-title">Welcome back</div>
        <div class="form-heading-sub" id="auth-heading-sub">Sign in to your Proviant account</div>
      </div>

      <!-- Auth form -->
      <form id="authForm" novalidate>
        <input type="hidden" id="auth-mode" value="signin">
        {{ if .InviteToken }}
        <input type="hidden" id="auth-invite-token" value="{{ .InviteToken }}">
        {{ end }}

        <!-- Display name — signup only -->
        <div class="field" id="field-name" style="display:none;">
          <label class="field-label" for="auth-name">Display name</label>
          <div class="field-input-wrap">
            <input class="field-input" type="text" id="auth-name"
              placeholder="Your name" autocomplete="name"
              aria-describedby="auth-name-error">
            <i class="bi bi-person field-icon" aria-hidden="true"></i>
          </div>
          <div class="field-error" id="auth-name-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-name-error-text"></span>
          </div>
        </div>

        <!-- Username — signin only -->
        <div class="field" id="field-username">
          <label class="field-label" for="auth-username">Username</label>
          <div class="field-input-wrap">
            <input class="field-input" type="text" id="auth-username"
              placeholder="Your username" autocomplete="username"
              aria-describedby="auth-username-error">
            <i class="bi bi-person field-icon" aria-hidden="true"></i>
          </div>
          <div class="field-error" id="auth-username-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-username-error-text"></span>
          </div>
        </div>

        <!-- Email — signup only -->
        <div class="field" id="field-email" style="display:none;">
          <label class="field-label" for="auth-email">Email</label>
          <div class="field-input-wrap">
            <input class="field-input" type="email" id="auth-email"
              placeholder="you@example.com" autocomplete="email"
              aria-describedby="auth-email-error">
            <i class="bi bi-envelope field-icon" aria-hidden="true"></i>
          </div>
          <div class="field-error" id="auth-email-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-email-error-text"></span>
          </div>
        </div>

        <!-- Password -->
        <div class="field" id="field-password">
          <label class="field-label" for="auth-password">Password</label>
          <div class="field-input-wrap">
            <input class="field-input" type="password" id="auth-password"
              placeholder="••••••••" autocomplete="current-password"
              aria-describedby="auth-password-error"
              data-min-length="{{ .PasswordMinLength }}"
              data-require-uppercase="{{ .PasswordRequireUppercase }}"
              data-require-digit="{{ .PasswordRequireDigit }}"
              data-require-special="{{ .PasswordRequireSpecial }}"
              style="padding-right:40px">
            <i class="bi bi-lock field-icon" aria-hidden="true"></i>
            <button type="button" class="pwd-toggle" id="pwd-toggle-btn"
              aria-label="Toggle password visibility" aria-pressed="false">
              <i class="bi bi-eye" id="pwd-eye-icon" aria-hidden="true"></i>
            </button>
          </div>

          <!-- Strength meter — signup only -->
          <div id="auth-strength-wrap" style="display:none;" aria-hidden="true">
            <div class="strength-meter" id="auth-strength-meter">
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
            </div>
            <div class="strength-label" id="auth-strength-label"></div>
          </div>

          <!-- Requirements — signup only -->
          <ul class="password-requirements" id="auth-password-requirements"
            style="display:none;" aria-live="polite">
            <li id="req-length">
              <i class="bi bi-circle" aria-hidden="true"></i>
              At least {{ .PasswordMinLength }} characters
            </li>
            {{ if .PasswordRequireUppercase }}
            <li id="req-upper">
              <i class="bi bi-circle" aria-hidden="true"></i>
              At least one uppercase letter
            </li>
            {{ end }}
            {{ if .PasswordRequireDigit }}
            <li id="req-digit">
              <i class="bi bi-circle" aria-hidden="true"></i>
              At least one number
            </li>
            {{ end }}
            {{ if .PasswordRequireSpecial }}
            <li id="req-special">
              <i class="bi bi-circle" aria-hidden="true"></i>
              At least one special character
            </li>
            {{ end }}
          </ul>

          <div class="field-error" id="auth-password-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-password-error-text"></span>
          </div>
        </div>

        <!-- Forgot password — signin only -->
        <div class="forgot-link" id="auth-forgot-link">
          <a href="/forgot-password">Forgot password?</a>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn-submit" id="btn-auth-submit">
          <i class="bi bi-box-arrow-in-right" id="btn-auth-icon" aria-hidden="true"></i>
          <span id="btn-auth-label">Sign in</span>
        </button>

        <!-- Terms note — signup only -->
        <p class="terms-note" id="auth-terms-note" style="display:none;">
          By creating an account you agree to our
          <a href="/terms">Terms of Service</a> and
          <a href="/privacy">Privacy Policy</a>.
        </p>
      </form>

    </div>
  </div>
</div>

<!-- Email verification modal -->
<div class="modal fade" id="emailVerificationModal" tabindex="-1"
  aria-labelledby="emailVerificationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="emailVerificationModalLabel">
          <i class="bi bi-envelope-check me-2" aria-hidden="true"></i>Verify Your Email
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <i class="bi bi-envelope-open text-info fs-1 mb-3 d-block" aria-hidden="true"></i>
        <p class="mb-1">A verification email was sent to:</p>
        <p class="fw-semibold mb-3" id="emailVerificationAddress"></p>
        <p class="text-secondary-custom small mb-0">Click the link in the email to verify your address, then log in.</p>
      </div>
      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-proviant-primary" data-bs-dismiss="modal">Got it</button>
      </div>
    </div>
  </div>
</div>

{{ end }}
