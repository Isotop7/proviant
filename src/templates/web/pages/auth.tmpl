{{ define "content" }}

<div class="auth">

  <!-- Form panel -->
  <div class="auth__form">
    <div class="auth__form-inner">

      <!-- Mobile logo (visible only on mobile) -->
      <div class="mobile-logo">
        <div class="mobile-logo-mark">P</div>
        <div class="mobile-logo-name">proviant</div>
      </div>

      <!-- Invite banner -->
      {{ if .InviteToken }}
      <div class="invite-banner" role="alert">
        <i class="bi bi-envelope-check" aria-hidden="true"></i>
        <span>{{ t "auth.inviteBannerPrefix" }}<strong>{{ t "auth.inviteBannerEmail" }}</strong>{{ t "auth.inviteBannerSuffix" }}</span>
      </div>
      {{ end }}

      <!-- Tab switcher -->
      <div class="auth-tabs" role="tablist">
        <button class="auth-tab active" id="tab-signin" data-mode="signin"
          role="tab" aria-selected="true" aria-controls="authForm">{{ t "auth.signIn" }}</button>
        <button class="auth-tab" id="tab-signup" data-mode="signup"
          role="tab" aria-selected="false" aria-controls="authForm">{{ t "auth.createAccount" }}</button>
      </div>

      <!-- Heading -->
      <div class="form-heading">
        <h1 class="form-heading-title" id="auth-heading-title">{{ t "auth.welcomeBack" }}</h1>
        <div class="form-heading-sub" id="auth-heading-sub">{{ t "auth.signInSubtitle" }}</div>
      </div>

      <!-- Auth form -->
      <form id="authForm" novalidate>
        <input type="hidden" id="auth-mode" value="signin">
        {{ if .InviteToken }}
        <input type="hidden" id="auth-invite-token" value="{{ .InviteToken }}">
        {{ end }}

        <!-- Display name — signup only -->
        <div class="field" id="field-name" style="display:none;">
          <label class="form-label" for="auth-name">{{ t "auth.nameLabel" }}</label>
          <div class="field-input-wrap">
            <input class="form-control" type="text" id="auth-name"
              placeholder="{{ t "auth.namePlaceholder" }}" autocomplete="name"
              aria-describedby="auth-name-error">
            <i class="bi bi-person field-icon" aria-hidden="true"></i>
          </div>
          <div class="invalid-feedback" id="auth-name-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-name-error-text"></span>
          </div>
        </div>

        <!-- Username — signin only -->
        <div class="field" id="field-username">
          <label class="form-label" for="auth-username">{{ t "auth.usernameLabel" }}</label>
          <div class="field-input-wrap">
            <input class="form-control" type="text" id="auth-username"
              placeholder="{{ t "auth.usernamePlaceholder" }}" autocomplete="username"
              aria-describedby="auth-username-error">
            <i class="bi bi-person field-icon" aria-hidden="true"></i>
          </div>
          <div class="invalid-feedback" id="auth-username-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-username-error-text"></span>
          </div>
        </div>

        <!-- Email — signup only -->
        <div class="field" id="field-email" style="display:none;">
          <label class="form-label" for="auth-email">{{ t "auth.emailLabel" }}</label>
          <div class="field-input-wrap">
            <input class="form-control" type="email" id="auth-email"
              placeholder="{{ t "auth.emailPlaceholder" }}" autocomplete="email"
              aria-describedby="auth-email-error">
            <i class="bi bi-envelope field-icon" aria-hidden="true"></i>
          </div>
          <div class="invalid-feedback" id="auth-email-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-email-error-text"></span>
          </div>
        </div>

        <!-- Password -->
        <div class="field" id="field-password">
          <label class="form-label" for="auth-password">{{ t "auth.passwordLabel" }}</label>
          <div class="field-input-wrap">
            <input class="form-control" type="password" id="auth-password"
              placeholder="••••••••" autocomplete="current-password"
              aria-describedby="auth-password-error"
              data-min-length="{{ .PasswordMinLength }}"
              data-require-uppercase="{{ .PasswordRequireUppercase }}"
              data-require-digit="{{ .PasswordRequireDigit }}"
              data-require-special="{{ .PasswordRequireSpecial }}"
              style="padding-right:40px">
            <i class="bi bi-lock field-icon" aria-hidden="true"></i>
            <button type="button" class="pwd-toggle" id="pwd-toggle-btn"
              aria-label="{{ t "auth.togglePasswordVisibility" }}" aria-pressed="false">
              <i class="bi bi-eye" id="pwd-eye-icon" aria-hidden="true"></i>
            </button>
          </div>

          <!-- Strength meter — signup only -->
          <div id="auth-strength-wrap" style="display:none;" aria-hidden="true">
            <div class="strength-meter" id="auth-strength-meter">
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
            </div>
            <div class="strength-label" id="auth-strength-label"></div>
          </div>

          <!-- Requirements — signup only -->
          <ul class="password-requirements" id="auth-password-requirements"
            style="display:none;" aria-live="polite">
            <li id="req-length">
              <i class="bi bi-circle" aria-hidden="true"></i>
              {{ t "auth.reqLength" .PasswordMinLength }}
            </li>
            {{ if .PasswordRequireUppercase }}
            <li id="req-upper">
              <i class="bi bi-circle" aria-hidden="true"></i>
              {{ t "auth.reqUppercase" }}
            </li>
            {{ end }}
            {{ if .PasswordRequireDigit }}
            <li id="req-digit">
              <i class="bi bi-circle" aria-hidden="true"></i>
              {{ t "auth.reqDigit" }}
            </li>
            {{ end }}
            {{ if .PasswordRequireSpecial }}
            <li id="req-special">
              <i class="bi bi-circle" aria-hidden="true"></i>
              {{ t "auth.reqSpecial" }}
            </li>
            {{ end }}
          </ul>

          <div class="invalid-feedback" id="auth-password-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="auth-password-error-text"></span>
          </div>
        </div>

        <!-- Forgot password — signin only -->
        <div class="forgot-link" id="auth-forgot-link">
          <a href="{{ .RouteForgotPassword }}">{{ t "auth.forgotPasswordLink" }}</a>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn btn-solid theme-primary w-100 mt-3" id="btn-auth-submit">
          <i class="bi bi-box-arrow-in-right" id="btn-auth-icon" aria-hidden="true"></i>
          <span id="btn-auth-label">{{ t "auth.signIn" }}</span>
        </button>

        <!-- Terms note — signup only -->
        <p class="terms-note" id="auth-terms-note" style="display:none;">
          {{ t "auth.termsPrefix" }}<a href="/terms">{{ t "auth.termsOfService" }}</a>{{ t "auth.termsAnd" }}<a href="/privacy">{{ t "auth.privacyPolicy" }}</a>.
        </p>
      </form>

    </div>
  </div>

  {{ template "loginBrand" . }}
</div>

<!-- Email verification dialog -->
<dialog class="dialog" id="emailVerificationModal" aria-labelledby="emailVerificationModalLabel">
      <div class="dialog-header">
        <h5 class="dialog-title" id="emailVerificationModalLabel">
          <i class="bi bi-envelope-check me-2" aria-hidden="true"></i>{{ t "auth.verifyEmailModalTitle" }}
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}"></button>
      </div>
      <div class="dialog-body text-center">
        <i class="bi bi-envelope-open fg-info fs-4xl mb-5 d-block" aria-hidden="true"></i>
        <p class="mb-1">{{ t "auth.verificationSentTo" }}</p>
        <p class="fw-semibold mb-5" id="emailVerificationAddress"></p>
        <p class="fg-secondary small mb-0">{{ t "auth.verifyEmailHelp" }}</p>
      </div>
      <div class="dialog-footer justify-content-center">
        <button type="button" class="btn btn-solid theme-primary" data-bs-dismiss="dialog">{{ t "auth.gotIt" }}</button>
      </div>
    </dialog>

{{ end }}
