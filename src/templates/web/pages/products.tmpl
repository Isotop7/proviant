{{ define "content" }}

<header class="page-header">
    <div class="page-header__lead">
        <h1 class="eyebrow">{{ t "nav.products" }}</h1>
        <div class="page-header__count">{{ .ProductCount }}</div>
        <p class="page-header__sub">{{ t "products.header.itemsInHousehold" }}</p>
    </div>
    <div class="page-header__aside">
        <div class="page-header__meta">
            {{ t "products.header.expiredCount" .ExpiredCount }} · {{ t "products.header.expiringSoonCount" .ExpiringSoonCount }}
        </div>
        <div class="d-flex gap-3">
            {{ if .ReceiptScanEnabled }}
            <a href="/web/products/scan-receipt" class="btn btn-outline theme-secondary d-none md:d-flex align-items-center gap-3">
                <i class="bi bi-receipt"></i> {{ t "products.scanReceipt" }}
            </a>
            {{ end }}
            <button class="btn btn-solid theme-primary d-none md:d-flex align-items-center gap-3" id="btnOpenAddProductModal">
                <i class="bi bi-plus-lg"></i> {{ t "products.addProduct" }}
            </button>
        </div>
    </div>
</header>

<div class="toolbar-sticky">
    <!-- Row 1: search (full width on mobile, with view toggle on desktop) -->
    <div class="d-flex gap-3 align-items-center mb-3">
        <div class="flex-grow-1 min-w-0">
            {{ template "searchBar" . }}
        </div>
        <!-- View toggle buttons on desktop -->
        <div class="d-none md:d-flex gap-1 align-items-center flex-shrink-0">
            <a href="?{{ queryWith .Params "view" "list" }}" class="btn-view {{ if eq .View "list" }}active{{ end }}" aria-label="{{ t "products.listView" }}">
                <i class="bi bi-list-ul" aria-hidden="true"></i>
            </a>
            <a href="?{{ queryWith .Params "view" "grid" }}" class="btn-view {{ if eq .View "grid" }}active{{ end }}" aria-label="{{ t "products.gridView" }}">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <!-- Row 2: view toggle (mobile left) | filters (desktop left) | bulk actions + options (right) -->
    <div id="toolbarRow2" class="d-flex gap-1 align-items-center flex-wrap">
        <!-- Left side: view toggle on mobile, filters on desktop -->
        <div class="d-flex gap-1 align-items-center flex-shrink-0">
            <!-- View toggle: visible on mobile, hidden on desktop (already in Row 1 on desktop) -->
            <div class="d-flex md:d-none gap-1">
                <a href="?{{ queryWith .Params "view" "list" }}" class="btn-view {{ if eq .View "list" }}active{{ end }}" title="{{ t "products.listView" }}" aria-label="{{ t "products.listView" }}">
                    <i class="bi bi-list-ul" aria-hidden="true"></i>
                </a>
                <a href="?{{ queryWith .Params "view" "grid" }}" class="btn-view {{ if eq .View "grid" }}active{{ end }}" title="{{ t "products.gridView" }}" aria-label="{{ t "products.gridView" }}">
                    <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                </a>
            </div>
            <!-- Desktop filters (hidden on mobile) -->
            <div id="toolbarFilters" class="d-none md:d-flex gap-1 align-items-center">
                {{ range $s := stringSlice "all" "expired" "critical" "soon" "fresh" "nodate" "archived" }}
                <a href="?{{ queryWith $.Params "status" $s }}"
                   class="filter-pill {{ if eq $.StatusFilter $s }}active status-{{ $s }}{{ end }}">
                    {{ if and (ne $s "all") (ne $s "archived") }}<span class="filter-dot dot-{{ $s }}"></span>{{ end }}
                    {{ if eq $s "all" }}{{ t "common.all" }}{{ else if eq $s "expired" }}{{ t "status.expired" }}{{ else if eq $s "critical" }}{{ t "status.critical" }}{{ else if eq $s "soon" }}{{ t "status.soon" }}{{ else if eq $s "fresh" }}{{ t "status.fresh" }}{{ else if eq $s "archived" }}{{ t "products.consumed" }}{{ else }}{{ t "status.noDate" }}{{ end }}
                </a>
                {{ end }}
            </div>
        </div>

        <!-- Right side: reset + advanced filters | bulk actions + mobile filter dropdown -->
        <div id="toolbarRight" class="ms-auto d-flex gap-1 align-items-center flex-wrap">
            <button id="show-all-btn" class="filter-pill" type="button" title="{{ t "partial.searchBar.showAll" }}">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                <span class="d-none sm:d-inline">{{ t "partial.searchBar.showAll" }}</span>
            </button>
            <button class="filter-pill" type="button"
                data-bs-toggle="collapse" data-bs-target="#advanced-filters"
                aria-expanded="false" aria-controls="advanced-filters"
                title="{{ t "partial.searchBar.advancedFilters" }}">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span class="d-none sm:d-inline">{{ t "partial.searchBar.filters" }}</span>
            </button>

            <div id="bulkActions" class="bulk-actions-bar">
                <span id="bulkCount" class="bulk-count"></span>
                {{ if eq $.StatusFilter "archived" }}
                <button data-bulk-action="restore" class="btn-bulk">
                    <i class="bi bi-arrow-counterclockwise"></i> {{ t "products.restore" }}
                </button>
                {{ else }}
                <button data-bulk-action="archive" class="btn-bulk">
                    <i class="bi bi-check-circle"></i> {{ t "products.consume" }}
                </button>
                <button data-bulk-action="cook" class="btn-bulk">
                    <span class="btn-label"><i class="bi bi-fire"></i> {{ t "products.cook" }}</span>
                    <span class="btn-busy"><span class="spinner-border spinner-sm me-1" role="status" aria-hidden="true"></span>{{ t "products.cooking" }}</span>
                </button>
                {{ end }}
                <button data-bulk-action="delete" class="btn-bulk danger">
                    <i class="bi bi-trash3"></i> {{ t "products.waste" }}
                </button>
            </div>

            <!-- Mobile filter/export button -->
            <div class="d-block md:d-none">
                <div class="btn-group" role="group">
                    <button type="button" class="btn-bulk" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" aria-label="{{ t "a11y.moreOptions" }}">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                    <div class="menu" id="mobileExportMenu">
                      <a class="menu-item" href="#" data-bs-toggle="drawer" data-bs-target="#mobileFiltersOffcanvas"><i class="bi bi-funnel me-2"></i>{{ t "products.filters" }}</a>
{{ if .ReceiptScanEnabled }}
                      <a class="menu-item" href="/web/products/scan-receipt"><i class="bi bi-receipt me-2"></i>{{ t "products.scanReceipt" }}</a>
{{ end }}
                      <hr class="menu-divider">
                      <a class="menu-item" href="#" id="mobile-import-csv"><i class="bi bi-upload me-2"></i>{{ t "products.importCsv" }}</a>
                      <a class="menu-item" href="#" id="mobile-import-template"><i class="bi bi-file-earmark-arrow-down me-2"></i>{{ t "products.downloadCsvTemplate" }}</a>
{{ if .IsAdmin }}
                      <hr class="menu-divider">
                      <a class="menu-item" href="#" id="mobile-restore-json"><i class="bi bi-arrow-counterclockwise me-2"></i>{{ t "products.restoreBackupJson" }}</a>
{{ end }}
                        {{ if .Products }}
                      <hr class="menu-divider">
                      <a class="menu-item" href="#" id="mobile-export-csv"><i class="bi bi-file-earmark-spreadsheet me-2"></i>{{ t "products.exportProductsCsv" }}</a>
                      <a class="menu-item" href="#" id="mobile-export-json"><i class="bi bi-filetype-json me-2"></i>{{ t "products.exportProductsJson" }}</a>
                      <a class="menu-item" href="#" id="mobile-archive-csv"><i class="bi bi-file-earmark-spreadsheet me-2"></i>{{ t "products.exportConsumptionHistoryCsv" }}</a>
                      <a class="menu-item" href="#" id="mobile-export-full"><i class="bi bi-files me-2"></i>{{ t "products.exportFullJson" }}</a>
{{ end }}
                    
                    </div>
                </div>
            </div>

            {{ if .Products }}
            <div class="toolbar-divider d-none md:d-flex"></div>
            <div class="d-none md:d-flex">
                {{ template "productOptionBar" . }}
            </div>
            {{ end }}
        </div>
    </div>

    <!-- The locations are the second axis: they get their own row below the states -->
    <div id="toolbarLocations" class="d-none md:d-flex gap-1 align-items-center flex-shrink-0 mt-3 mb-3">
        {{ if .StorageLocations }}
        <a href="?{{ queryWith .Params "locationId" "" }}"
           class="filter-pill {{ if eq .LocationFilter "" }}active{{ end }}">{{ t "partial.searchBar.allLocations" }}</a>
        {{ range $l := .StorageLocations }}
        <a href="?{{ queryWith $.Params "locationId" (printf "%d" $l.ID) }}"
           class="filter-pill {{ if eq $.LocationFilter (printf "%d" $l.ID) }}active{{ end }}">
            {{ $l.Name }}
        </a>
        {{ end }}
        {{ end }}
    </div>
</div>

