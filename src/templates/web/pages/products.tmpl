    <div id="productRows">
    {{ range .Products }}
    <div class="list-row" data-id="{{ .Model.ID }}">
        <div class="list-checkbox-col">
            <input type="checkbox" class="row-checkbox list-checkbox" value="{{ .Model.ID }}" aria-label="{{ t "products.table.selectProduct" .ProductName }}">
        </div>
        <div class="col-product">
            <a href="/web/products/{{ .Model.ID }}/edit" class="list-thumb">
                {{ if .ImageURL }}
                <img src="{{ .ImageURL }}" alt="{{ .ProductName }}" class="list-thumb-img" loading="lazy">
                {{ end }}
                <div class="list-thumb-fallback">
                    <i class="bi bi-box-seam list-thumb-icon"></i>
                </div>
                <div class="list-status-dot status-{{ expiryStatusClass .ExpireAt }}"></div>
            </a>
            <div class="list-product-text">
                <a href="/web/products/{{ .Model.ID }}/edit" class="list-product-name">
                    {{ .ProductName }}
                    {{ if and .IsPrivate (eq .UserID $.CurrentUserID) }}
                    <i class="bi bi-lock" title="{{ t "products.privateProduct" }}"></i>
                    {{ end }}
                </a>
                <div class="list-product-meta">
                    #{{ .Model.ID }} · {{ .Barcode }}
                </div>
            </div>
        </div>
        <div class="col-status">
            <span class="badge badge--{{ expiryStatusClass .ExpireAt }}">
                <i class="bi bi-{{ expiryStatusIcon .ExpireAt }}"></i>
                {{ expiryStatusLabel .ExpireAt }}
            </span>
            {{ if and (gt .MinStockAmount 0) (lt .Quantity .MinStockAmount) }}
            <span class="badge badge--lowstock">
                <i class="bi bi-exclamation-triangle-fill"></i>
                {{ t "products.lowStock" }}
            </span>
            {{ end }}
        </div>
        {{ $urgency := expiryUrgencyText .ExpireAt }}
        {{ if $urgency }}
        <div class="col-expiry expiry-text status-{{ expiryStatusClass .ExpireAt }}">
            <span class="urgency-full d-none d-sm-inline">{{ $urgency }}</span>
            <span class="urgency-days d-inline d-sm-none">{{ expiryDays .ExpireAt }}</span>
        </div>
        {{ else }}
        <div class="col-expiry expiry-text status-{{ expiryStatusClass .ExpireAt }}">—</div>
        {{ end }}
        <div class="col-location">
            {{ if .StorageLocation }}{{ .StorageLocation.Name }}{{ else }}—{{ end }}
        </div>
        <div class="col-qty">
            {{ if eq $.StatusFilter "archived" }}
            <span class="qty-static">{{ quantityLabel .Quantity }}</span>
            {{ else }}
            <div class="qty-stepper qty-stepper-flat">
                <button type="button" data-qty-action="dec" data-product-id="{{ .Model.ID }}" aria-label="{{ t "products.table.decreaseQuantity" .ProductName }}">−</button>
                <span id="qty-{{ .Model.ID }}" class="qty-amount" data-quantity="{{ .Quantity }}">{{ quantityLabel .Quantity }}</span>
                <button type="button" data-qty-action="inc" data-product-id="{{ .Model.ID }}" aria-label="{{ t "products.table.increaseQuantity" .ProductName }}">+</button>
            </div>
            {{ end }}
            {{ with .PackSize }}
            <span class="pack-size">{{ . }}</span>
            {{ end }}
        </div>
        <div class="col-actions">
            <button type="button" class="btn-add-to-shopping-list" data-product-id="{{ .Model.ID }}" title="{{ t "products.addToShoppingList" }}">
                <i class="bi bi-cart-plus"></i>
            </button>
        </div>
    </div>
    {{ end }}
</div>
{{ else }}
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-3">
    {{ range .Products }}
    {{ template "productCard" . }}
    {{ end }}
</div>
{{ end }}
{{ if gt .TotalPages 1 }}
<nav class="products-pagination" aria-label="{{ t "products.pagination.label" }}">
    {{ if .PrevPageURL }}
    <a href="{{ .PrevPageURL }}" class="pagination-link" rel="prev">
        <i class="bi bi-chevron-left" aria-hidden="true"></i><span>{{ t "common.previous" }}</span>
    </a>
    {{ else }}
    <span class="pagination-link is-disabled"><i class="bi bi-chevron-left" aria-hidden="true"></i><span>{{ t "common.previous" }}</span></span>
    {{ end }}
    <span class="pagination-status" aria-live="polite">{{ t "products.pagination.pageStatus" .Page .TotalPages }}</span>
    {{ if .NextPageURL }}
    <a href="{{ .NextPageURL }}" class="pagination-link" rel="next">
        <span>{{ t "common.next" }}</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
    {{ else }}
    <span class="pagination-link is-disabled"><span>{{ t "common.next" }}</span><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
    {{ end }}
</nav>
{{ end }}
{{ else }}
{{ template "noproducts" . }}
{{ end }}

<!-- Mobile filter offcanvas (hidden by default) -->
<div class="offcanvas offcanvas-bottom" id="mobileFiltersOffcanvas" tabindex="-1" aria-labelledby="mobileFiltersOffcanvasLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="mobileFiltersOffcanvasLabel">{{ t "products.filterProducts" }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ t "a11y.close" }}"></button>
  </div>
  <div class="offcanvas-body">
    <div class="mb-3">
      <label class="form-label fw-semibold small">{{ t "products.status" }}</label>
      <div class="d-flex flex-wrap gap-2">
        {{ range $s := stringSlice "all" "expired" "critical" "soon" "fresh" "nodate" "archived" }}
        <a href="?{{ queryWith $.Params "status" $s }}"
           class="filter-pill {{ if eq $.StatusFilter $s }}active status-{{ $s }}{{ end }}">
          {{ if and (ne $s "all") (ne $s "archived") }}<span class="filter-dot dot-{{ $s }}"></span>{{ end }}
          {{ if eq $s "all" }}{{ t "common.all" }}{{ else if eq $s "expired" }}{{ t "status.expired" }}{{ else if eq $s "critical" }}{{ t "status.critical" }}{{ else if eq $s "soon" }}{{ t "status.soon" }}{{ else if eq $s "fresh" }}{{ t "status.fresh" }}{{ else if eq $s "archived" }}{{ t "products.consumed" }}{{ else }}{{ t "status.noDate" }}{{ end }}
        </a>
        {{ end }}
      </div>
    </div>
    {{ if $.StorageLocations }}
    <div class="mb-3">
      <label class="form-label fw-semibold small">{{ t "products.storageLocation" }}</label>
      <div class="d-flex flex-wrap gap-2">
        {{ range $l := .StorageLocations }}
        <a href="?{{ queryWith $.Params "locationId" (printf "%d" $l.ID) }}"
           class="filter-pill {{ if eq $.LocationFilter (printf "%d" $l.ID) }}active{{ end }}">
          {{ $l.Name }}
        </a>
        {{ end }}
        <a href="?{{ queryWith .Params "locationId" "" }}" class="filter-pill {{ if eq $.LocationFilter "" }}active{{ end }}">{{ t "common.all" }}</a>
      </div>
    </div>
    {{ end }}
  </div>
</div>

<!-- Mobile bulk actions bar (fixed, shown only when items selected) -->
<div id="mobileBulkActions" class="mobile-bulk-actions">
  <div class="bulk-actions-inner">
    <span id="mobileBulkCount" class="bulk-count"></span>
    <div class="d-flex gap-2">
      {{ if eq $.StatusFilter "archived" }}
      <button data-bulk-action="restore" class="btn-bulk">
        <i class="bi bi-arrow-counterclockwise"></i> {{ t "products.restore" }}
      </button>
      {{ else }}
      <button data-bulk-action="archive" class="btn-bulk">
        <i class="bi bi-check-circle"></i> {{ t "products.consume" }}
      </button>
      <button data-bulk-action="cook" class="btn-bulk">
        <span class="btn-text"><i class="bi bi-fire"></i> {{ t "products.cook" }}</span>
        <span class="btn-loading"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>{{ t "products.cooking" }}</span>
      </button>
      {{ end }}
      <button data-bulk-action="delete" class="btn-bulk danger">
        <i class="bi bi-trash3"></i> {{ t "products.waste" }}
      </button>
    </div>
  </div>
</div>

<!-- Add product modal (desktop only — hidden on mobile via JS) -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div class="modal-icon modal-icon-accent" id="addProductModalIcon">
                    <i class="bi bi-upc-scan"></i>
                </div><h5 class="modal-title mb-0" id="addProductModalLabel">{{ t "products.addProduct" }}</h5>
                    <div id="addProductModalSubtitle" class="modal-subtitle">{{ t "products.modalSubtitle" }}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <!-- Step 1: Barcode input -->
            <div id="modalStepScan" class="modal-body">
                <!-- Mode tabs -->
                <div class="tab-switcher">
                    <button id="tabManualInput" type="button" class="tab-switcher-btn active">
                        <i class="bi bi-keyboard"></i> {{ t "products.manualInput" }}
                    </button>
                    <button id="tabCamera" type="button" class="tab-switcher-btn">
                        <i class="bi bi-camera"></i> {{ t "products.camera" }}
                    </button>
                </div>

                <!-- Manual input section -->
                <div id="manualInputSection">
                    <div class="form-label">{{ t "products.barcode" }}</div>
                    <div class="barcode-input-wrap" data-focus-target="barcode">
                        <i class="bi bi-upc-scan barcode-scan-icon"></i>
<input id="barcode" type="text" inputmode="numeric" pattern="[0-9]{13}"
			placeholder="{{ t "products.barcodePlaceholder" }}"
			autocomplete="off" spellcheck="false" aria-label="{{ t "products.barcode" }}">
                        <span class="kbd-hint">↵</span>
                    </div>
    <div class="form-text">
        <i class="bi bi-keyboard"></i> {{ t "products.barcodeHint" }}
    </div>
    <div id="barcodeLookupLoading" class="d-none mt-2">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span class="ms-1">{{ t "products.searching" }}</span>
    </div>
</div>

                 <!-- Camera section -->
                 <div id="cameraSection">
                     <div id="barcode-reader-wrapper" class="barcode-camera-wrap" style="display:none;">
                         <div id="barcode-reader"></div>
                     </div>
                     <div class="form-text">
                         <i class="bi bi-camera"></i> {{ t "products.aimCamera" }}
                     </div>
                 </div>

                  <!-- OCR Camera Modal (for expiry date) -->
                  <div class="modal fade" id="ocrCameraModal" tabindex="-1" aria-labelledby="ocrCameraModalLabel" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                              <div class="modal-header">
                                  <div class="modal-icon modal-icon-accent">
                                      <i class="bi bi-camera"></i>
                                  </div><h5 class="modal-title mb-0" id="ocrCameraModalLabel">{{ t "products.scanExpiryDate" }}</h5>
                                      <div class="modal-subtitle">{{ t "products.scanExpirySubtitle" }}
                                  </div>
                                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
                                      <i class="bi bi-x"></i>
                                  </button>
                              </div>
                              <div class="modal-body text-center">
                                  <div class="camera-preview-wrapper">
                                      <video id="ocrVideoPreview" autoplay playsinline class="camera-preview"></video>
                                  </div>
                                  <p class="text-body-secondary small mt-2">{{ t "products.captureHint" }}</p>
                              </div>
                              <div class="modal-footer">
                                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ t "common.cancel" }}</button>
                                  <button type="button" class="btn btn-primary" id="btnCaptureExpiry">
                                      <i class="bi bi-camera"></i> {{ t "products.capture" }}
                                  </button>
                              </div>
                          </div>
                      </div>
                  </div>

                <!-- Required by productsCreate.js click delegation — triggered programmatically -->
                <button type="button" id="btnScan" data-action="scan" class="d-none"></button>
            </div>

            <!-- Step 2: Product form (revealed when productsCreate.js finds barcode) -->
            <div id="modalStepForm" class="modal-body">
                <!-- Scan result banner -->
                <div id="scanResultBanner" class="scan-result-banner">
                    <i class="bi bi-check-circle-fill scan-result-icon"></i>
                    <div>
                        <div id="scanResultName" class="scan-result-name"></div>
                        <div id="scanResultCode" class="scan-result-code"></div>
                    </div>
                </div>
                <div id="productData" class="d-none">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <img id="productInfoImage" src="" alt=""
                                 class="rounded product-thumb-sm">
                        </div>
                        <div class="flex-grow-1">
                            <div id="productInfoName" class="fw-semibold"></div>
                            <div id="productInfoGenericName" class="text-body-secondary small"></div>
                        </div>
                    </div>

                    <select class="form-select mb-3 d-none" id="instanceDropdown" aria-label="{{ t "products.selectInstance" }}"></select>

                    <form id="formExpireAt" class="needs-validation" novalidate>
                        <label class="form-label">{{ t "products.quantity" }}</label>
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnQuantityDec" aria-label="{{ t "products.quantityDecrease" }}">−</button>
                            <span id="quantityDisplay" class="fs-5 px-2" aria-live="polite">1</span>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnQuantityInc" aria-label="{{ t "products.quantityIncrease" }}">+</button>
                        </div>
                        <input type="hidden" id="quantity" value="1">
                        <label for="expireAt" class="form-label">
                            {{ t "products.expiryDateField" }} <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="date" class="form-control flex-grow-1" id="expireAt"
                                   value="{{ today }}" required aria-required="true">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnScanExpiry" title="{{ t "products.scanExpiryFromPhoto" }}" aria-label="{{ t "products.scanExpiryFromPhoto" }}">
                                <i class="bi bi-camera" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">
                            <i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "products.expiryRequired" }}
                        </div>
                        {{ if .Locations }}
                        <label for="modalStorageLocation" class="form-label mt-2">{{ t "products.storageLocationTitle" }}</label>
                        <select class="form-select" id="modalStorageLocation" aria-label="{{ t "products.storageLocation" }}">
                            <option value="">{{ t "products.noneOption" }}</option>
                            {{ range .Locations }}
                            <option value="{{ .ID }}">{{ .Icon }} {{ .Name }}</option>
                            {{ end }}
                        </select>
                        <small id="storageHint" class="text-body-secondary d-none mb-2"></small>
                        {{ end }}
                    </form>

                    <div class="btn-group w-100 mb-3" role="group" aria-label="{{ t "products.quickExpiryShortcuts" }}">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnExpireAdd3">{{ t "products.plus3Days" }}</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnExpireAdd7">{{ t "products.plus7Days" }}</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnExpireAdd1m">{{ t "products.plus1Month" }}</button>
                    </div>

                    <div class="d-flex gap-2 mb-2" id="foundBarcode">
                        <button id="btnShowProduct" type="button" class="btn btn-sm btn-outline-secondary flex-fill" disabled>
                            <i class="bi bi-eye me-1" aria-hidden="true"></i>{{ t "products.view" }}
                        </button>
                        <button id="btnShowProducts" type="button" class="btn btn-sm btn-outline-secondary flex-fill" disabled>
                            <i class="bi bi-collection me-1" aria-hidden="true"></i>{{ t "products.allInstances" }}
                        </button>
                    </div>

                    <div class="d-flex gap-2">
                        <button id="btnArchiveProductModal" type="button" class="btn btn-sm btn-outline-secondary flex-fill" disabled>
                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>{{ t "products.consumed" }}
                        </button>
                        <button id="btnDeleteProductModal" type="button" class="btn btn-sm btn-danger flex-fill" disabled>
                            <i class="bi bi-trash me-1" aria-hidden="true"></i>{{ t "common.delete" }}
                        </button>
                    </div>
                </div>
            </div>

            <!-- Step 3: Success -->
            <div id="modalStepSuccess" class="modal-body">
                <div class="modal-success-banner">
                    <div class="modal-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div class="flex-fill">
                        <div id="modalSuccessName" class="modal-success-name"></div>
                        <div class="modal-success-sub">{{ t "products.addedToPantry" }}</div>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm" id="btnModalScanAnother">
                        <i class="bi bi-plus-lg me-1"></i>{{ t "products.addAnother" }}
                    </button>
                </div>
                <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">{{ t "common.close" }}</button>
            </div>

            <div class="modal-footer">
                <div id="modalFooterScan">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ t "common.cancel" }}</button>
                </div>
                <div id="modalFooterForm">
                    <button type="button" class="btn btn-outline-secondary" id="btnModalBack">
                        <i class="bi bi-arrow-left"></i> {{ t "common.back" }}
                    </button>
                    <button type="button" class="btn btn-primary" id="btnAddProduct">
                        <span class="btn-text"><i class="bi bi-plus-lg me-1"></i>{{ t "products.addToPantry" }}</span>
                        <span class="btn-loading"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>{{ t "products.adding" }}</span>
                    </button>
                </div>
                <div id="modalFooterSuccess"></div>
            </div>

        </div>
    </div>
</div>

<!-- OCR Result Modal -->
<div class="modal fade" id="ocrResultModal" tabindex="-1" aria-labelledby="ocrResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icon modal-icon-accent">
                    <i class="bi bi-camera"></i>
                </div><h5 class="modal-title mb-0" id="ocrResultModalLabel">{{ t "products.expiryDateScan" }}</h5>
                    <div class="modal-subtitle">{{ t "products.checkDetectedDate" }}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <!-- Image preview -->
                <div id="ocrPreviewImage" class="mb-3 text-center"></div>

                <!-- Detected date -->
                <div class="mb-3" id="ocrDetectedDate"></div>

                <!-- Confidence bar -->
                <div class="progress mb-2" style="height: 8px;">
                    <div id="ocrConfidenceBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                </div>
                <small class="text-body-secondary" id="ocrConfidenceLabel">{{ t "products.confidenceLabel" }}</small>

                <!-- Raw text fallback -->
                <div id="ocrRawTextWrapper" class="mt-3 d-none">
                    <label class="form-label">{{ t "products.rawOcrText" }}</label>
                    <textarea id="ocrRawText" class="form-control" rows="3" readonly></textarea>
                    <div class="form-text">{{ t "products.ocrFallbackHelp" }}</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="btnRecaptureExpiry">
                    <i class="bi bi-camera"></i> {{ t "products.retake" }}
                </button>
                <button type="button" class="btn btn-primary" id="btnConfirmExpiry">
                    <i class="bi bi-check"></i> {{ t "common.confirm" }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cook modal: per-product count inputs for the packs used -->
<div class="modal fade" id="cookModal" tabindex="-1" aria-labelledby="cookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icon modal-icon-accent">
                    <i class="bi bi-fire"></i>
                </div><h5 class="modal-title mb-0" id="cookModalLabel">{{ t "products.cookModalTitle" }}</h5>
                    <div class="modal-subtitle">{{ t "products.cookModalSubtitle" }}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="cookModalItems"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ t "common.cancel" }}</button>
                <button type="button" class="btn btn-primary" id="btnCookConfirm">
                    <span class="btn-text"><i class="bi bi-fire me-1"></i>{{ t "products.cook" }}</span>
                    <span class="btn-loading"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>{{ t "products.cooking" }}</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden file input backing the CSV import menu entries -->
<input type="file" id="csvImportFile" accept=".csv,text/csv" class="d-none" aria-hidden="true" tabindex="-1">
<!-- Hidden file input backing the JSON backup restore menu entries -->
<input type="file" id="jsonRestoreFile" accept=".json,application/json" class="d-none" aria-hidden="true" tabindex="-1">

<script src="/assets/js/html5-qrcode.min.js"></script>
<script src="/assets/js/productsCreate.js"></script>
<script src="/assets/js/products.js"></script>
<script src="/assets/js/productsExpiryOCR.js"></script>
<script src="/assets/js/productsImport.js"></script>

{{ end }}
