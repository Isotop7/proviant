<!-- Mobile filter offcanvas (hidden by default) -->
<div class="offcanvas offcanvas-bottom" id="mobileFiltersOffcanvas" tabindex="-1" aria-labelledby="mobileFiltersOffcanvasLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="mobileFiltersOffcanvasLabel">Filter products</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <div class="mb-3">
      <label class="form-label fw-semibold small">Status</label>
      <div class="d-flex flex-wrap gap-2">
        {{ range $s := stringSlice "all" "expired" "critical" "soon" "fresh" "nodate" "archived" }}
        <a href="?{{ queryWith $.Params "status" $s }}"
           class="filter-pill {{ if eq $.StatusFilter $s }}active status-{{ $s }}{{ end }}">
          {{ if and (ne $s "all") (ne $s "archived") }}<span class="filter-dot dot-{{ $s }}"></span>{{ end }}
          {{ if eq $s "all" }}All{{ else if eq $s "expired" }}Expired{{ else if eq $s "critical" }}Critical{{ else if eq $s "soon" }}Expiring soon{{ else if eq $s "fresh" }}Fresh{{ else if eq $s "archived" }}Consumed{{ else }}No date{{ end }}
        </a>
        {{ end }}
      </div>
    </div>
    {{ if $.StorageLocations }}
    <div class="mb-3">
      <label class="form-label fw-semibold small">Storage location</label>
      <div class="d-flex flex-wrap gap-2">
        {{ range $l := .StorageLocations }}
        <a href="?{{ queryWith $.Params "locationId" (printf "%d" $l.ID) }}"
           class="filter-pill {{ if eq $.LocationFilter (printf "%d" $l.ID) }}active{{ end }}">
          {{ $l.Name }}
        </a>
        {{ end }}
        <a href="?{{ queryWith .Params "locationId" "" }}" class="filter-pill {{ if eq $.LocationFilter "" }}active{{ end }}">All</a>
      </div>
    </div>
    {{ end }}
  </div>
</div>

<!-- Mobile bulk actions bar (fixed, shown only when items selected) -->
<div id="mobileBulkActions" class="mobile-bulk-actions">
  <div class="bulk-actions-inner">
    <span id="mobileBulkCount" class="bulk-count"></span>
    <div class="d-flex gap-2">
      {{ if eq $.StatusFilter "archived" }}
      <button onclick="bulkAction('restore')" class="btn-bulk">
        <i class="bi bi-arrow-counterclockwise"></i> Restore
      </button>
      {{ else }}
      <button onclick="bulkAction('archive')" class="btn-bulk">
        <i class="bi bi-check-circle"></i> Consumed
      </button>
      {{ end }}
      <button onclick="bulkAction('delete')" class="btn-bulk danger">
        <i class="bi bi-trash3"></i> Wasted
      </button>
    </div>
  </div>
</div>

<!-- Add product modal (desktop only — hidden on mobile via JS) -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div class="modal-icon" id="addProductModalIcon" style="background:var(--accent-subtle);color:var(--accent);">
                    <i class="bi bi-upc-scan"></i>
                </div>
                <div class="modal-header-body">
                    <h5 class="modal-title mb-0" id="addProductModalLabel">Add product</h5>
                    <div id="addProductModalSubtitle" class="modal-subtitle">Scan barcode or enter manually</div>
                </div>
                <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <!-- Step 1: Barcode input -->
            <div id="modalStepScan" class="modal-body">
                <!-- Mode tabs -->
                <div class="tab-switcher">
                    <button id="tabManualInput" type="button" class="tab-switcher-btn active">
                        <i class="bi bi-keyboard"></i> Manual Input
                    </button>
                    <button id="tabCamera" type="button" class="tab-switcher-btn">
                        <i class="bi bi-camera"></i> Camera
                    </button>
                </div>

                <!-- Manual input section -->
                <div id="manualInputSection">
                    <div class="field-label">Barcode</div>
                    <div class="barcode-input-wrap" onclick="document.getElementById('barcode').focus()">
                        <i class="bi bi-upc-scan barcode-scan-icon"></i>
<input id="barcode" type="text" inputmode="numeric" pattern="[0-9]{13}"
			placeholder="Scan or type EAN barcode…"
			autocomplete="off" spellcheck="false">
                        <span class="kbd-hint">↵</span>
                    </div>
    <div class="input-hint">
        <i class="bi bi-keyboard"></i> USB/BT scanner or type and press Enter
    </div>
    <div id="barcodeLookupLoading" class="d-none mt-2">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span class="ms-1">Searching...</span>
    </div>
</div>

                 <!-- Camera section -->
                 <div id="cameraSection">
                     <div id="barcode-reader-wrapper" class="barcode-camera-wrap" style="display:none;">
                         <div id="barcode-reader"></div>
                     </div>
                     <div class="input-hint">
                         <i class="bi bi-camera"></i> Aim camera at EAN barcode
                     </div>
                 </div>

                  <!-- OCR Camera Modal (for expiry date) -->
                  <div class="modal fade" id="ocrCameraModal" tabindex="-1" aria-labelledby="ocrCameraModalLabel" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                              <div class="modal-header">
                                  <div class="modal-icon" style="background:var(--accent-subtle);color:var(--accent);">
                                      <i class="bi bi-camera"></i>
                                  </div>
                                  <div class="modal-header-body">
                                      <h5 class="modal-title mb-0" id="ocrCameraModalLabel">Scan Expiry Date</h5>
                                      <div class="modal-subtitle">Position expiry date in frame</div>
                                  </div>
                                  <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
                                      <i class="bi bi-x"></i>
                                  </button>
                              </div>
                              <div class="modal-body text-center">
                                  <div class="camera-preview-wrapper">
                                      <video id="ocrVideoPreview" autoplay playsinline class="camera-preview"></video>
                                  </div>
                                  <p class="text-secondary-custom small mt-2">Hold steady and tap Capture</p>
                              </div>
                              <div class="modal-footer">
                                  <button type="button" class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
                                  <button type="button" class="btn btn-proviant-primary" id="btnCaptureExpiry">
                                      <i class="bi bi-camera"></i> Capture
                                  </button>
                              </div>
                          </div>
                      </div>
                  </div>

                <!-- Required by productsCreate.js click delegation — triggered programmatically -->
                <button type="button" id="btnScan" data-action="scan" class="d-none"></button>
            </div>

            <!-- Step 2: Product form (revealed when productsCreate.js finds barcode) -->
            <div id="modalStepForm" class="modal-body">
                <!-- Scan result banner -->
                <div id="scanResultBanner" class="scan-result-banner">
                    <i class="bi bi-check-circle-fill scan-result-icon"></i>
                    <div>
                        <div id="scanResultName" class="scan-result-name"></div>
                        <div id="scanResultCode" class="scan-result-code"></div>
                    </div>
                </div>
                <div id="productData" class="d-none">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <img id="productInfoImage" src="" alt=""
                                 class="rounded product-thumb-sm">
                        </div>
                        <div class="flex-grow-1">
                            <div id="productInfoName" class="fw-semibold"></div>
                            <div id="productInfoGenericName" class="text-secondary-custom small"></div>
                        </div>
                    </div>

                    <select class="form-select mb-3 d-none" id="instanceDropdown" aria-label="Select existing instance"></select>

                    <form id="formExpireAt" class="needs-validation" novalidate>
                        <label class="form-label">Amount</label>
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <button type="button" class="btn btn-proviant-secondary btn-sm" id="btnAmountDec" aria-label="Decrease amount">−</button>
                            <span id="amountDisplay" class="fs-5 px-2">1</span>
                            <button type="button" class="btn btn-proviant-secondary btn-sm" id="btnAmountInc" aria-label="Increase amount">+</button>
                        </div>
                        <input type="hidden" id="amount" value="1">
                        <label for="expireAt" class="form-label">
                            Expiry date <span class="text-danger" aria-hidden="true">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="date" class="form-control flex-grow-1" id="expireAt"
                                   value="{{ today }}" required aria-required="true">
                            <button type="button" class="btn btn-sm btn-proviant-secondary" id="btnScanExpiry" title="Scan expiry date from photo">
                                <i class="bi bi-camera"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">
                            <i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>Please select an expiry date
                        </div>
                        {{ if .Locations }}
                        <label for="modalStorageLocation" class="form-label mt-2">Storage Location</label>
                        <select class="form-select mb-2" id="modalStorageLocation">
                            <option value="">— None —</option>
                            {{ range .Locations }}
                            <option value="{{ .ID }}">{{ .Icon }} {{ .Name }}</option>
                            {{ end }}
                        </select>
                        {{ end }}
                    </form>

                    <div class="btn-group w-100 mb-3" role="group" aria-label="Quick expiry shortcuts">
                        <button type="button" class="btn btn-proviant-secondary btn-sm" id="btnExpireAdd3">+3 days</button>
                        <button type="button" class="btn btn-proviant-secondary btn-sm" id="btnExpireAdd7">+7 days</button>
                        <button type="button" class="btn btn-proviant-secondary btn-sm" id="btnExpireAdd1m">+1 month</button>
                    </div>

                    <div class="d-flex gap-2 mb-2" id="foundBarcode">
                        <button id="btnShowProduct" type="button" class="btn btn-sm btn-proviant-secondary flex-fill" disabled>
                            <i class="bi bi-eye me-1" aria-hidden="true"></i>View
                        </button>
                        <button id="btnShowProducts" type="button" class="btn btn-sm btn-proviant-secondary flex-fill" disabled>
                            <i class="bi bi-collection me-1" aria-hidden="true"></i>All instances
                        </button>
                    </div>

                    <div class="d-flex gap-2">
                        <button id="btnArchiveProductModal" type="button" class="btn btn-sm btn-proviant-secondary flex-fill" disabled>
                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Consumed
                        </button>
                        <button id="btnDeleteProductModal" type="button" class="btn btn-sm btn-proviant-danger flex-fill" disabled>
                            <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                        </button>
                    </div>
                </div>
            </div>

            <!-- Step 3: Success -->
            <div id="modalStepSuccess" class="modal-body">
                <div class="modal-success-banner">
                    <div class="modal-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div class="flex-fill">
                        <div id="modalSuccessName" class="modal-success-name"></div>
                        <div class="modal-success-sub">Successfully added to your pantry</div>
                    </div>
                    <button type="button" class="btn btn-proviant-primary btn-sm" id="btnModalScanAnother">
                        <i class="bi bi-plus-lg me-1"></i>Add another
                    </button>
                </div>
                <button type="button" class="btn btn-proviant-secondary w-100" data-bs-dismiss="modal">Close</button>
            </div>

            <div class="modal-footer">
                <div id="modalFooterScan">
                    <button type="button" class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
                <div id="modalFooterForm">
                    <button type="button" class="btn btn-proviant-secondary" id="btnModalBack">
                        <i class="bi bi-arrow-left"></i> Back
                    </button>
                    <button type="button" class="btn btn-proviant-primary" id="btnAddProduct">
                        <span class="btn-text"><i class="bi bi-plus-lg me-1"></i>Add to pantry</span>
                        <span class="btn-loading"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Adding...</span>
                    </button>
                </div>
                <div id="modalFooterSuccess"></div>
            </div>

        </div>
    </div>
</div>

<!-- OCR Result Modal -->
<div class="modal fade" id="ocrResultModal" tabindex="-1" aria-labelledby="ocrResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icon" style="background:var(--accent-subtle);color:var(--accent);">
                    <i class="bi bi-camera"></i>
                </div>
                <div class="modal-header-body">
                    <h5 class="modal-title mb-0" id="ocrResultModalLabel">Expiry Date Scan</h5>
                    <div class="modal-subtitle">Check the detected date</div>
                </div>
                <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <!-- Image preview -->
                <div id="ocrPreviewImage" class="mb-3 text-center"></div>

                <!-- Detected date -->
                <div class="mb-3" id="ocrDetectedDate"></div>

                <!-- Confidence bar -->
                <div class="progress mb-2" style="height: 8px;">
                    <div id="ocrConfidenceBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                </div>
                <small class="text-secondary-custom" id="ocrConfidenceLabel">Confidence: 0%</small>

                <!-- Raw text fallback -->
                <div id="ocrRawTextWrapper" class="mt-3 d-none">
                    <label class="form-label">Raw OCR text</label>
                    <textarea id="ocrRawText" class="form-control" rows="3" readonly></textarea>
                    <div class="form-text">Date not detected confidently. Please check the text above and adjust the date manually.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-proviant-secondary" id="btnRecaptureExpiry">
                    <i class="bi bi-camera"></i> Retake
                </button>
                <button type="button" class="btn btn-proviant-primary" id="btnConfirmExpiry">
                    <i class="bi bi-check"></i> Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/assets/js/html5-qrcode.min.js"></script>
<script src="/assets/js/productsCreate.js"></script>
<script src="/assets/js/products.js"></script>
<script src="/assets/js/productsExpiryOCR.js"></script>

{{ end }}
