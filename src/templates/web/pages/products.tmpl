{{ define "content" }}

{{ if .Products }}

<div class="row justify-content-between p-3">
    <div class="text-center mb-2">
        <h2>My products</h2>
        <p class="text-muted">
            Select one or more products to edit or delete.</br>You can also archive products to keep them in your history.
        </p>
    </div>
</div>

<div class="py-3 my-2 d-flex justify-content-end">
        {{ template "productOptionBar" . }}
</div>

<div class="row row-cols-1 row-cols-lg-2 g-5">
    {{ range .Products }}

    {{ template "productCard" . }}

    {{ end }}
</div>

<script src="/assets/js/products.js"></script>

{{ else }}

{{ template "noproducts" . }}

{{ end }}

{{ end }}
