{{ define "content" }}

<div class="page-header">
    <div>
        <h1 class="page-header-title">{{ t "nav.products" }}</h1>
        <p class="page-header-subtitle">{{ tn "products.header.itemCount" .ProductCount }}</p>
    </div>
    <div class="d-flex gap-2">
        {{ if .ReceiptScanEnabled }}
        <a href="/web/products/scan-receipt" class="btn btn-outline-secondary d-none d-md-flex align-items-center gap-2">
            <i class="bi bi-receipt"></i> {{ t "products.scanReceipt" }}
        </a>
        {{ end }}
        <button class="btn btn-primary d-none d-md-flex align-items-center gap-2" id="btnOpenAddProductModal">
            <i class="bi bi-plus-lg"></i> {{ t "products.addProduct" }}
        </button>
    </div>
</div>

<div class="toolbar-sticky">
    <!-- Row 1: search (full width on mobile, with view toggle on desktop) -->
    <div class="d-flex gap-2 align-items-center mb-2">
        <div class="flex-grow-1 min-w-0">
            {{ template "searchBar" . }}
        </div>
        <!-- View toggle buttons on desktop -->
        <div class="d-none d-md-flex gap-1 align-items-center flex-shrink-0">
            <a href="?{{ queryWith .Params "view" "list" }}" class="btn-view {{ if eq .View "list" }}active{{ end }}" aria-label="{{ t "products.listView" }}">
                <i class="bi bi-list-ul" aria-hidden="true"></i>
            </a>
            <a href="?{{ queryWith .Params "view" "grid" }}" class="btn-view {{ if eq .View "grid" }}active{{ end }}" aria-label="{{ t "products.gridView" }}">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <!-- Row 2: view toggle (mobile left) | filters (desktop left) | bulk actions + options (right) -->
    <div id="toolbarRow2" class="d-flex gap-1 align-items-center flex-wrap">
        <!-- Left side: view toggle on mobile, filters on desktop -->
        <div class="d-flex gap-1 align-items-center flex-shrink-0">
            <!-- View toggle: visible on mobile, hidden on desktop (already in Row 1 on desktop) -->
            <div class="d-flex d-md-none gap-1">
                <a href="?{{ queryWith .Params "view" "list" }}" class="btn-view {{ if eq .View "list" }}active{{ end }}" title="{{ t "products.listView" }}" aria-label="{{ t "products.listView" }}">
                    <i class="bi bi-list-ul" aria-hidden="true"></i>
                </a>
                <a href="?{{ queryWith .Params "view" "grid" }}" class="btn-view {{ if eq .View "grid" }}active{{ end }}" title="{{ t "products.gridView" }}" aria-label="{{ t "products.gridView" }}">
                    <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                </a>
            </div>
            <!-- Desktop filters (hidden on mobile) -->
            <div id="toolbarFilters" class="d-none d-md-flex gap-1 align-items-center">
                {{ range $s := stringSlice "all" "expired" "critical" "soon" "fresh" "nodate" "archived" }}
                <a href="?{{ queryWith $.Params "status" $s }}"
                   class="filter-pill {{ if eq $.StatusFilter $s }}active status-{{ $s }}{{ end }}">
                    {{ if and (ne $s "all") (ne $s "archived") }}<span class="filter-dot dot-{{ $s }}"></span>{{ end }}
                    {{ if eq $s "all" }}{{ t "common.all" }}{{ else if eq $s "expired" }}{{ t "status.expired" }}{{ else if eq $s "critical" }}{{ t "status.critical" }}{{ else if eq $s "soon" }}{{ t "status.soon" }}{{ else if eq $s "fresh" }}{{ t "status.fresh" }}{{ else if eq $s "archived" }}{{ t "products.consumed" }}{{ else }}{{ t "status.noDate" }}{{ end }}
                </a>
                {{ end }}

                <div class="filter-separator"></div>

                {{ range $l := .StorageLocations }}
                <a href="?{{ queryWith $.Params "locationId" (printf "%d" $l.ID) }}"
                   class="filter-pill {{ if eq $.LocationFilter (printf "%d" $l.ID) }}active{{ end }}">
                    {{ $l.Name }}
                </a>
                {{ end }}
                {{ if .StorageLocations }}
                <a href="?{{ queryWith .Params "locationId" "" }}"
                   class="filter-pill {{ if eq $.LocationFilter "" }}active{{ end }}">{{ t "common.all" }}</a>
                {{ end }}
            </div>
        </div>

        <!-- Right side: bulk actions + mobile filter dropdown -->
        <div id="toolbarRight" class="ms-auto d-flex gap-1 align-items-center flex-wrap">
            <div id="bulkActions" class="bulk-actions-bar">
                <span id="bulkCount" class="bulk-count"></span>
                {{ if eq $.StatusFilter "archived" }}
                <button data-bulk-action="restore" class="btn-bulk">
                    <i class="bi bi-arrow-counterclockwise"></i> {{ t "products.restore" }}
                </button>
                {{ else }}
                <button data-bulk-action="archive" class="btn-bulk">
                    <i class="bi bi-check-circle"></i> {{ t "products.consume" }}
                </button>
                <button data-bulk-action="cook" class="btn-bulk">
                    <span class="btn-text"><i class="bi bi-fire"></i> {{ t "products.cook" }}</span>
                    <span class="btn-loading"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>{{ t "products.cooking" }}</span>
                </button>
                {{ end }}
                <button data-bulk-action="delete" class="btn-bulk danger">
                    <i class="bi bi-trash3"></i> {{ t "products.waste" }}
                </button>
            </div>

            <!-- Mobile filter/export button -->
            <div class="d-block d-md-none">
                <div class="btn-group" role="group">
                    <button type="button" class="btn-bulk dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ t "a11y.moreOptions" }}">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="mobileExportMenu">
                        <li><a class="dropdown-item" href="#" data-bs-toggle="offcanvas" data-bs-target="#mobileFiltersOffcanvas"><i class="bi bi-funnel me-2"></i>{{ t "products.filters" }}</a></li>
                        {{ if .ReceiptScanEnabled }}
                        <li><a class="dropdown-item" href="/web/products/scan-receipt"><i class="bi bi-receipt me-2"></i>{{ t "products.scanReceipt" }}</a></li>
                        {{ end }}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="mobile-import-csv"><i class="bi bi-upload me-2"></i>{{ t "products.importCsv" }}</a></li>
                        <li><a class="dropdown-item" href="#" id="mobile-import-template"><i class="bi bi-file-earmark-arrow-down me-2"></i>{{ t "products.downloadCsvTemplate" }}</a></li>
                        {{ if .IsAdmin }}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="mobile-restore-json"><i class="bi bi-arrow-counterclockwise me-2"></i>{{ t "products.restoreBackupJson" }}</a></li>
                        {{ end }}
                        {{ if .Products }}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="mobile-export-csv"><i class="bi bi-file-earmark-spreadsheet me-2"></i>{{ t "products.exportProductsCsv" }}</a></li>
                        <li><a class="dropdown-item" href="#" id="mobile-export-json"><i class="bi bi-filetype-json me-2"></i>{{ t "products.exportProductsJson" }}</a></li>
                        <li><a class="dropdown-item" href="#" id="mobile-archive-csv"><i class="bi bi-file-earmark-spreadsheet me-2"></i>{{ t "products.exportConsumptionHistoryCsv" }}</a></li>
                        <li><a class="dropdown-item" href="#" id="mobile-export-full"><i class="bi bi-files me-2"></i>{{ t "products.exportFullJson" }}</a></li>
                        {{ end }}
                    </ul>
                </div>
            </div>

            {{ if .Products }}
            <div class="toolbar-divider d-none d-md-flex"></div>
            <div class="d-none d-md-flex">
                {{ template "productOptionBar" . }}
            </div>
            {{ end }}
        </div>
    </div>
</div>

