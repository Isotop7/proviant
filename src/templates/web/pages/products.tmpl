                onchange="updateBulkSelection()">
        </div>
        <div class="col-product">
            <a href="/web/products/{{ .Model.ID }}/edit" class="list-thumb">
                {{ if .ImageURL }}
                <img src="{{ .ImageURL }}" alt="{{ .ProductName }}" class="list-thumb-img" loading="lazy"
                     onload="this.style.opacity='1'; this.closest('.list-thumb').querySelector('.list-thumb-fallback').style.display='none';"
                     onerror="this.closest('.list-thumb').querySelector('.list-thumb-fallback').style.display='flex';">
