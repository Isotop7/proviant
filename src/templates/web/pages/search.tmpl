{{ define "content" }}
<div class="row justify-content-between p-3">
    <div class="text-center mb-4">
        <h2>Search results</h2>
        <p class="text-muted">
            {{ if .SearchQuery }}
            <span class="fs-6 badge bg-primary">
                {{ .SearchParameter }} ~ "{{ .SearchQuery }}"
            </span>
            {{ else }}
            <span class="fs-6 badge bg-primary">
                No query specified
            </span>
            {{ end }}
        </p>
    </div>
</div>

{{ if .Products }}

<div class="row row-cols-1 row-cols-lg-2 g-5">
    {{ range .Products }}

        {{ template "productCard" . }}

    {{ end }}
</div>

{{ else }}
<div class="row my-2">
    <div class="w-100 mt-5 text-center">
        <div class="fs-1 text-warning my-4">
            <i class="bi bi-emoji-dizzy-fill me-2"></i>
        </div>
        <p class="font-monospace fs-4">
            No products found!
        </p>
    </div>
</div>
{{ end }}

{{ end }}