{{ define "content" }}

<style>
    .card {
        min-height: 150px;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="row justify-content-between p-3">

    <div class="text-center mb-4">
		<h2>Search product</h2>
		<p class="text-muted">Select and build search query to show products</p>
	</div>

    <div class="search-bar">
        <select id="search-param" class="form-select">
            <option value="product_name">Product Name</option>
            <option value="barcode">Barcode</option>
        </select>
        <input type="text" id="search-query" class="form-control" placeholder="Search..." />
        <select id="sort-param" class="form-select">
            <option value="created_at">Created At</option>
            <option value="expire_at">Expire At</option>
            <option value="scanned_at">Scanned At</option>
            <option value="notified_at">Notified At</option>
        </select>
        <select id="sort-order" class="form-select">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
        </select>
        <button id="search-btn" class="btn btn-primary">Search</button>
    </div>
</div>

<div id="product-list" class="row row-cols-1 row-cols-lg-2 g-5">
    <!-- Products will be rendered here -->
</div>

<script src="/assets/js/productsSearch.js"></script>
{{ end }}