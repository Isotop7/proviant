{{ define "content" }}

{{ if .HasHousehold }}

<div aria-live="polite" aria-atomic="true" class="visually-hidden" id="waste-status"></div>

<header class="page-header">
    <div class="page-header__lead">
        <h1 class="eyebrow">{{ t "nav.wasteAnalytics" }}</h1>
        <div class="page-header__count" id="wasteHeaderCount">&mdash;</div>
        <p class="page-header__sub">{{ t "waste.header.wastedInPeriod" }}</p>
    </div>
    <div class="page-header__aside">
        <div class="btn-group gap-1" role="group" aria-label="{{ t "waste.periodSelector" }}" id="periodSelector">
            <button type="button" class="btn-bulk" data-period="month">{{ t "waste.period.thisMonth" }}</button>
            <button type="button" class="btn-bulk" data-period="3months">{{ t "waste.period.threeMonths" }}</button>
            <button type="button" class="btn-bulk active" data-period="6months" aria-pressed="true">{{ t "waste.period.sixMonths" }}</button>
            <button type="button" class="btn-bulk" data-period="12months">{{ t "waste.period.twelveMonths" }}</button>
        </div>
    </div>
</header>

<div>

    <div class="row row-cols-2 row-cols-md-5 g-3 mb-2" id="wasteTiles"></div>

    <div class="row g-3">
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2 fw-bold">
                    <div class="icon-chip" aria-hidden="true"><i class="bi bi-bar-chart-line-fill"></i></div>
                    {{ t "waste.monthlyBreakdown" }}
                </div>
                <div class="card-body">
                    <div class="chart-frame chart-frame--lg">
                        <canvas id="chartMonthly" role="img" aria-label="{{ t "waste.chartMonthlyLabel" }}"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2 fw-bold">
                    <div class="icon-chip" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></div>
                    {{ t "waste.trendTitle" }}
                </div>
                <div class="card-body">
                    <div class="chart-frame">
                        <canvas id="chartTrend" role="img" aria-label="{{ t "waste.chartTrendLabel" }}"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2 fw-bold">
                    <div class="icon-chip" aria-hidden="true"><i class="bi bi-table"></i></div>
                    {{ t "waste.monthlyDetails" }}
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle" id="monthlyTable">
                            <thead>
                                <tr>
                                    <th scope="col">{{ t "waste.month" }}</th>
                                    <th scope="col" class="text-end">{{ t "waste.consumed" }}</th>
                                    <th scope="col" class="text-end">{{ t "waste.wasted" }}</th>
                                    <th scope="col" class="text-end">{{ t "waste.wastePercent" }}</th>
                                    <th scope="col" class="text-end">{{ t "waste.wastedEur" }}</th>
                                    <th scope="col" class="text-end">{{ t "waste.co2kg" }}</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2 fw-bold">
                    <div class="icon-chip" aria-hidden="true"><i class="bi bi-tags-fill"></i></div>
                    <span class="flex-grow-1">{{ t "waste.mostWastedCategories" }}</span>
                    <div class="btn-group gap-1" role="group" aria-label="{{ t "waste.sortBy" }}" id="sortToggle">
                        <button type="button" class="btn-bulk active" data-sort="count" aria-pressed="true">{{ t "waste.sortCount" }}</button>
                        <button type="button" class="btn-bulk" data-sort="cost" aria-pressed="false">{{ t "waste.sortCost" }}</button>
                    </div>
                </div>
                <div class="accordion accordion-flush" id="categoryList"></div>
            </div>
        </div>
    </div>

    <p class="text-body-secondary small mt-3 mb-0">
        <i class="bi bi-info-circle"></i>
        {{ t "waste.methodologyNote" }}
    </p>
</div>

<script src="/assets/js/chart.umd.min.js" defer></script>
<script src="/assets/js/chartTheme.js" defer></script>
<script src="/assets/js/wasteAnalytics.js" defer></script>

{{ else }}

<div class="empty">
    <div class="empty-icon">
        <i class="bi bi-emoji-dizzy-fill"></i>
    </div>
    <div class="empty-title">{{ t "waste.emptyTitle" }}</div>
    <div class="empty-desc">{{ t "waste.emptyDesc" }}</div>
    <a class="btn btn-primary" href="/web/user/settings#household">
        <i class="bi bi-people me-2"></i> {{ t "waste.setupHousehold" }}
    </a>
</div>

{{ end }}

{{ end }}