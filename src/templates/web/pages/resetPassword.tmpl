{{ define "content" }}

<div class="login-root">

  {{ template "loginBrand" . }}

  <!-- Form panel -->
  <div class="login-form-panel">
    <div class="login-form-inner">

      <!-- Mobile logo (visible only on mobile) -->
      <div class="mobile-logo">
        <div class="mobile-logo-mark">P</div>
        <div class="mobile-logo-name">proviant</div>
      </div>

      <!-- Heading -->
      <div class="form-heading">
        <div class="form-heading-title">Set a new password</div>
        <div class="form-heading-sub">Choose a new password for your account.</div>
      </div>

      {{ if .Error }}
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>{{ .Error }}
      </div>
      <div class="text-center mt-3">
        <a href="{{ .RouteForgotPassword }}" class="btn btn-proviant-primary">Request a New Link</a>
      </div>

      {{ else if .Success }}
      <div class="alert alert-success" role="alert">
        <i class="bi bi-check-circle me-2"></i>{{ .Success }}
      </div>
      <div class="text-center mt-3">
        <a href="{{ .RouteAuth }}" class="btn btn-proviant-primary">Log In</a>
      </div>

      {{ else }}
      <form id="reset-password-form" novalidate data-route-auth="{{ .RouteAuth }}">
        <input type="hidden" id="reset-token" name="token" value="{{ .Token }}">

        <div class="field">
          <label class="field-label" for="reset-password">New password</label>
          <div class="field-input-wrap">
            <input class="field-input" type="password" id="reset-password"
              name="password" placeholder="At least 12 characters"
              autocomplete="new-password" required minlength="12"
              aria-describedby="reset-password-error"
              style="padding-right:40px">
            <i class="bi bi-lock field-icon" aria-hidden="true"></i>
            <button type="button" class="pwd-toggle" id="pwd-toggle-btn"
              aria-label="Toggle password visibility" aria-pressed="false">
              <i class="bi bi-eye" id="pwd-eye-icon" aria-hidden="true"></i>
            </button>
          </div>
          <div class="field-error" id="reset-password-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="reset-password-error-text"></span>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="reset-password-confirm">Confirm new password</label>
          <div class="field-input-wrap">
            <input class="field-input" type="password" id="reset-password-confirm"
              name="passwordConfirm" placeholder="Repeat the new password"
              autocomplete="new-password" required minlength="12"
              aria-describedby="reset-password-confirm-error"
              style="padding-right:40px">
            <i class="bi bi-lock field-icon" aria-hidden="true"></i>
          </div>
          <div class="field-error" id="reset-password-confirm-error" role="alert" style="display:none;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            <span id="reset-password-confirm-error-text"></span>
          </div>
        </div>

        <button type="submit" class="btn-submit" id="btn-reset-submit">
          <i class="bi bi-check2" id="btn-reset-icon" aria-hidden="true"></i>
          <span id="btn-reset-label">Reset Password</span>
        </button>
      </form>
      {{ end }}

    </div>
  </div>
</div>

{{ if not .Error }}
{{ if not .Success }}
<script src="/assets/js/resetPassword.js"></script>
{{ end }}
{{ end }}
{{ end }}
