{{ define "content" }}
<header class="page-header">
    <div class="page-header__lead">
        <h1 class="page-header__title">{{ t "nav.recipes" }}</h1>
        <p class="page-header__sub">{{ t "recipes.subtitle" }}</p>
    </div>
    <div class="page-header__aside">
        <button class="btn btn-solid theme-primary d-none md:d-flex align-items-center gap-3" id="btnNewRecipe" type="button">
            <i class="bi bi-plus-lg"></i> {{ t "recipes.newRecipe" }}
        </button>
    </div>
</header>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h5 mb-0">{{ t "recipes.myRecipes" }}</h2>
    <button class="btn btn-solid theme-primary md:d-none" id="btnNewRecipeMobile" type="button" aria-label="{{ t "recipes.newRecipe" }}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
    </button>
</div>

<div id="recipeEditor" class="card mb-5 d-none">
    <div class="card-body">
        <h3 class="h6" id="recipeEditorTitle">{{ t "recipes.newRecipe" }}</h3>
        <div class="row g-2 mb-3">
            <div class="col-12 md:col-5">
                <label class="form-label" for="recipeName">{{ t "recipes.nameLabel" }}</label>
                <input type="text" class="form-control" id="recipeName" maxlength="255" required>
            </div>
            <div class="col-6 md:col-2">
                <label class="form-label" for="recipeServings">{{ t "recipes.servingsLabel" }}</label>
                <input type="number" class="form-control" id="recipeServings" value="2" min="1">
            </div>
            <div class="col-6 md:col-5">
                <label class="form-label" for="recipeSourceUrl">{{ t "recipes.sourceUrlLabel" }}</label>
                <input type="url" class="form-control" id="recipeSourceUrl">
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="recipeDescription">{{ t "recipes.descriptionLabel" }}</label>
            <textarea class="form-control" id="recipeDescription" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label" for="recipeInstructions">{{ t "recipes.instructionsLabel" }}</label>
            <textarea class="form-control" id="recipeInstructions" rows="4"></textarea>
        </div>
        <h4 class="h6">{{ t "recipes.ingredients" }}</h4>
        <div id="ingredientRows" class="mb-3"></div>
        <button type="button" class="btn btn-outline theme-secondary btn-sm mb-5" id="btnAddIngredient">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> {{ t "recipes.addIngredient" }}
        </button>
        <div class="d-flex gap-3">
            <button type="button" class="btn btn-solid theme-primary" id="btnSaveRecipe">{{ t "recipes.saveRecipe" }}</button>
            <button type="button" class="btn btn-outline theme-secondary" id="btnCancelRecipe">{{ t "common.cancel" }}</button>
        </div>
    </div>
</div>

<div id="savedRecipesContainer" aria-live="polite">
    <div class="loading-state">
        <div class="spinner-border fg-secondary" role="status">
            <span class="visually-hidden">{{ t "recipes.loading" }}</span>
        </div>
        <p class="mt-3 fg-secondary">{{ t "recipes.loadingSaved" }}</p>
    </div>
</div>

<h2 class="h5 mb-3 mt-7">{{ t "recipes.suggestions.title" }}</h2>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-outline theme-secondary d-flex align-items-center gap-3" id="refreshRecipesBtn" type="button">
        <i class="bi bi-arrow-clockwise"></i> {{ t "recipes.refresh" }}
    </button>
</div>

<div id="recipe-suggestions-container">
    <div class="loading-state">
        <div class="spinner-border fg-secondary" role="status">
            <span class="visually-hidden">{{ t "recipes.loading" }}</span>
        </div>
        <p class="mt-3 fg-secondary">{{ t "recipes.suggestions.loading" }}</p>
    </div>
</div>

<div id="recipe-error-container" class="d-none">
    <div class="empty">
        <div class="empty-icon empty-icon-danger">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div class="empty-title">{{ t "recipes.error.title" }}</div>
        <div class="empty-desc">{{ t "recipes.error.desc" }}<br>{{ t "common.error" }}: <span id="error-message"></span></div>
        <button class="btn btn-outline theme-secondary" id="recipesRetryBtn" type="button">
            <i class="bi bi-arrow-clockwise me-1"></i> {{ t "recipes.tryAgain" }}
        </button>
    </div>
</div>

<script src="/assets/js/recipes.js" defer></script>
<script src="/assets/js/savedRecipes.js" defer></script>
{{ end }}
