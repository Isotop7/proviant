{{ define "content" }}
<div class="page-header">
    <div>
        <h1 class="page-header-title">Recipe Suggestions</h1>
        <p class="page-header-subtitle">Based on products expiring soon</p>
    </div>
    <button class="btn btn-proviant-secondary d-none d-md-flex align-items-center gap-2" id="refreshRecipesBtn" type="button">
        <i class="bi bi-arrow-clockwise"></i> Refresh
    </button>
</div>

<div id="recipe-suggestions-container">
    <div class="loading-state">
        <div class="spinner-border text-secondary-custom" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-secondary-custom">Loading recipe suggestions...</p>
    </div>
</div>

<div id="recipe-error-container" class="d-none">
    <div class="empty">
        <div class="empty-icon empty-icon-danger">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div class="empty-title">Unable to load recipes</div>
        <div class="empty-desc">We couldn't fetch recipe suggestions at this time. Please try again later.<br>Error: <span id="error-message"></span></div>
        <button class="btn btn-proviant-secondary" id="recipesRetryBtn" type="button">
            <i class="bi bi-arrow-clockwise me-1"></i> Try again
        </button>
    </div>
</div>

<script src="/assets/js/recipes.js" defer></script>
{{ end }}
