{{ define "content" }}
<div class="row justify-content-between p-3">
    <div class="text-center mb-4">
        <h2>
            User settings
        </h2>
        <p class="text-muted">
            <span class="badge bg-primary">ID: #{{ .User.ID }}</span>
        </p>
    </div>
</div>
<div class="container my-3">
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h4>
                Personal details
            </h4>
        </div>
        <div class="col col-auto">
            <button type="button" class="btn btn-outline-primary" id="btnUpdatePersonalDetails">
                Update
            </button>
        </div>
    </div>
    <div class="row gx-5 p-3 my-3">
        <div class="col">
            <form id="userSettings" novalidate>
                <div class="input-group">
                    <span class="input-group-text" id="basic-addon1">Username</span>
                    <input type="text" class="form-control" placeholder="Username" aria-label="Username"
                        aria-describedby="basic-addon1" value="{{ .User.Username }}" id="inputUsername">
                    <span class="input-group-text" id="basic-addon2">Mail Address</span>
                    <input type="text" class="form-control" placeholder="Mail Address" aria-label="Mail Address"
                        aria-describedby="basic-addon2" value="{{ .User.MailAddress }}" id="inputMailAddress">
                </div>
            </form>
            <div id="updateAlert" class="alert alert-danger mt-3" role="alert" style="display: none;">
            </div>
        </div>
    </div>
    <hr>
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h4>Household</h4>
        </div>
    </div>

    {{/* Current household info */}}
    <div class="row gx-5 px-3 mb-3">
        <div class="col">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge bg-secondary">ID: {{ .Household.ID }}</span>
                <strong>{{ .Household.Name }}</strong>
                {{ if .IsAdmin }}<span class="badge bg-primary"><i class="bi bi-shield-check me-1"></i>Admin</span>{{ end }}
            </div>
        </div>
    </div>

    {{/* Rename household — admin only */}}
    {{ if .IsAdmin }}
    <div class="row gx-5 px-3 mb-3">
        <div class="col">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                <input type="text" class="form-control" id="inputHouseholdName"
                       placeholder="New household name" aria-label="Household name"
                       value="{{ .Household.Name }}">
                <button type="button" class="btn btn-outline-primary" id="btnUpdateHouseholdName">Rename</button>
            </div>
            <div id="updateNameAlert" class="alert mt-3 d-none" role="alert"></div>
        </div>
    </div>
    {{ end }}

    {{/* Members list */}}
    {{ if .Members }}
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col"><h5 class="mb-0"><i class="bi bi-people me-2"></i>Members</h5></div>
    </div>
    <div class="row gx-5 px-3 mb-3">
        <div class="col">
            <ul class="list-group" id="memberList">
                {{ range .Members }}
                <li class="list-group-item d-flex justify-content-between align-items-center" id="member-{{ .ID }}">
                    <span>
                        <i class="bi bi-person me-2"></i>{{ .Username }}
                        {{ if eq .ID $.User.ID }}<span class="badge bg-secondary ms-1">You</span>{{ end }}
                        {{ if eq .ID $.Household.AdminID }}<span class="badge bg-primary ms-1"><i class="bi bi-shield-check me-1"></i>Admin</span>{{ end }}
                    </span>
                    {{ if and $.IsAdmin (ne .ID $.Household.AdminID) }}
                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-member"
                            data-id="{{ .ID }}" aria-label="Remove member">
                        <i class="bi bi-person-dash"></i>
                    </button>
                    {{ end }}
                </li>
                {{ end }}
            </ul>
            <div id="membersAlert" class="alert mt-3 d-none" role="alert"></div>
        </div>
    </div>
    {{ end }}

    {{/* Leave household */}}
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h5 class="mb-0"><i class="bi bi-box-arrow-left me-2"></i>Leave Household</h5>
            <p class="text-body-secondary small mb-0 mt-1">You will be assigned a new personal household. If you are the sole member, your products will be moved with you.</p>
        </div>
        <div class="col col-auto">
            <button type="button" class="btn btn-outline-danger" id="btnLeaveHousehold">Leave</button>
        </div>
    </div>
    <div class="row gx-5 px-3 mb-1">
        <div class="col">
            <div id="leaveHouseholdAlert" class="alert alert-danger d-none" role="alert"></div>
        </div>
    </div>

    {{/* Create new household */}}
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h5 class="mb-0"><i class="bi bi-house-add me-2"></i>Create New Household</h5>
            <p class="text-body-secondary small mb-0 mt-1">Create a new household and switch to it. If you are currently the sole member, your products will be moved.</p>
        </div>
    </div>
    <div class="row gx-5 px-3 mb-1">
        <div class="col">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-house"></i></span>
                <input type="text" class="form-control" id="inputNewHouseholdName" placeholder="Household name" aria-label="New household name">
                <button type="button" class="btn btn-outline-primary" id="btnCreateHousehold">Create &amp; Switch</button>
            </div>
            <div id="createHouseholdAlert" class="alert alert-danger mt-3 d-none" role="alert"></div>
        </div>
    </div>

    {{/* Apply to join a household */}}
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Apply to Join a Household</h5>
            <p class="text-body-secondary small mb-0 mt-1">Enter the ID of the household you want to join. The admin will need to approve your request.</p>
        </div>
    </div>
    <div class="row gx-5 px-3 mb-1">
        <div class="col">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                <input type="number" class="form-control" id="inputApplyHouseholdID" placeholder="Household ID" aria-label="Household ID to join" min="1">
                <button type="button" class="btn btn-outline-primary" id="btnApplyHousehold">Apply</button>
            </div>
            <div id="applyHouseholdAlert" class="alert mt-3 d-none" role="alert"></div>
        </div>
    </div>

    {{/* Pending applications — admin only */}}
    {{ if .IsAdmin }}
    {{ if .PendingApplications }}
    <div class="row gx-5 px-3 mb-3">
        <div class="col">
            <h5><i class="bi bi-people me-2"></i>Pending Join Requests</h5>
            <ul class="list-group" id="applicationList">
                {{ range .PendingApplications }}
                <li class="list-group-item d-flex justify-content-between align-items-center" id="application-{{ .ID }}">
                    <span><i class="bi bi-person me-2"></i>User #{{ .ApplicantID }}</span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-success btn-approve-application" data-id="{{ .ID }}" aria-label="Approve">
                            <i class="bi bi-check-lg"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-reject-application" data-id="{{ .ID }}" aria-label="Reject">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </li>
                {{ end }}
            </ul>
            <div id="applicationsAlert" class="alert alert-danger mt-3 d-none" role="alert"></div>
        </div>
    </div>
    {{ end }}
    {{ end }}

    {{/* Outgoing pending applications */}}
    {{ if .MyApplications }}
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h5 class="mb-0"><i class="bi bi-send me-2"></i>Your Pending Applications</h5>
            <p class="text-body-secondary small mb-0 mt-1">Awaiting admin approval.</p>
        </div>
    </div>
    <div class="row gx-5 px-3 mb-3">
        <div class="col">
            <ul class="list-group" id="myApplicationList">
                {{ range .MyApplications }}
                <li class="list-group-item d-flex justify-content-between align-items-center" id="my-application-{{ .ID }}">
                    <span><i class="bi bi-house me-2"></i>Household #{{ .HouseholdID }}</span>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-cancel-application"
                            data-id="{{ .ID }}" aria-label="Cancel application">
                        <i class="bi bi-x-lg"></i> Cancel
                    </button>
                </li>
                {{ end }}
            </ul>
            <div id="myApplicationsAlert" class="alert mt-3 d-none" role="alert"></div>
        </div>
    </div>
    {{ end }}

    <hr>
    <div class="row g-5 p-3 align-items-center justify-content-between">
        <div class="col">
            <h4>Notification Settings</h4>
        </div>
        <div class="col col-auto">
            <button type="button" class="btn btn-outline-primary" id="btnUpdateNotificationSettings">
                Update
            </button>
        </div>
    </div>
    <div class="row gx-5 p-3 my-3">
        <div class="col">
            <form id="notificationSettings" novalidate>
                <div class="mb-3">
                    <h5>Notification Methods</h5>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleEmailNotifications" {{if .User.NotificationPreferences.EmailEnabled}}checked{{end}}>
                        <label class="form-check-label" for="toggleEmailNotifications">Email Notifications</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleNtfyNotifications" {{if .User.NotificationPreferences.NtfyEnabled}}checked{{end}}>
                        <label class="form-check-label" for="toggleNtfyNotifications">ntfy.sh Notifications</label>
                    </div>
                </div>

                <div id="ntfySettings" {{if not .User.NotificationPreferences.NtfyEnabled}}style="display: none;"{{end}}>
                    <h5 class="mt-3">ntfy.sh Configuration</h5>
                    <div class="input-group mb-3">
                        <span class="input-group-text">ntfy.sh URL</span>
                        <input type="text" class="form-control" placeholder="https://ntfy.sh" id="inputNtfyUrl" value="{{.User.NotificationPreferences.NtfyURL}}">
                        <span class="input-group-text">Topic</span>
                        <input type="text" class="form-control" placeholder="your_topic" id="inputNtfyTopic" value="{{.User.NotificationPreferences.NtfyTopic}}">
                    </div>
                    <div class="input-group mb-3">
                        <span class="input-group-text">Access Token (optional)</span>
                        <input type="password" class="form-control" placeholder="Optional access token" id="inputNtfyToken">
                    </div>
                </div>
            </form>
            <div id="notificationAlert" class="alert alert-danger mt-3" role="alert" style="display: none;">
            </div>
        </div>
    </div>

    <hr>
    <div class="row g-5 p-3">
        <div class="col">
            <h4>
                Password settings
            </h4>
        </div>
    </div>
    <div class="row gx-5 p-3 my-3">
        <div class="col">
            <form id="passwordUpdate" novalidate>
                <div class="input-group">
                    <span class="input-group-text">Password</span>
                    <input id="inputPassword" type="password" aria-label="Password" class="form-control" autocomplete="new-password">
                    <input id="inputPasswordVerification" type="password" aria-label="Password Verification" class="form-control" autocomplete="new-password">
                    <button class="btn btn-outline-primary" type="button" id="btnUpdatePassword">Update Password</button>
                </div>
            </form>
            <div id="passwordAlert" class="alert alert-danger mt-3" role="alert" style="display: none;">
            </div>
        </div>
    </div>
</div>

<div id="modal" class="modal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">proviant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="modalBody">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" id="btnModal">Reload</button>
        </div>
      </div>
    </div>
  </div>

<script src="/assets/js/userSettings.js"></script>
{{ end }}
