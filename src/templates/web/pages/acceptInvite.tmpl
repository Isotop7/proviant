{{ define "content" }}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 invite-icon-wrapper">
                            <i class="bi bi-envelope-paper fs-3 text-white"></i>
                        </div>
                        <h3 class="mt-3 mb-1">Household Invitation</h3>
                    </div>

                    {{ if .Error }}
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>{{ .Error }}
                    </div>
                    <div class="text-center mt-3">
                        <a href="/web" class="btn btn-proviant-secondary">Go to Dashboard</a>
                    </div>

                    {{ else if .Success }}
                    <div class="alert alert-success" role="alert">
                        <i class="bi bi-check-circle me-2"></i>{{ .Success }}
                    </div>
                    <div class="text-center mt-3">
                        <a href="/web" class="btn btn-proviant-primary">Go to Dashboard</a>
                    </div>

                    {{ else if .NeedsAuth }}
                    <p class="text-center text-body-secondary">You've been invited to join <strong>{{ .HouseholdName }}</strong>.</p>
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="bi bi-info-circle me-2"></i>You must use the email address <strong>{{ .InvitationEmail }}</strong> to accept this invitation. If you already have an account, log in with that email. If you are new, sign up with this exact email address.
                    </div>
                    <div class="d-grid gap-2 mt-4">
                        <a href="/web/auth?invite_token={{ .Token }}" class="btn btn-proviant-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log In / Sign Up
                        </a>
                    </div>

                    {{ else if .ConfirmAccept }}
                    <p class="text-center fs-5">You are invited to join the household <strong>{{ .HouseholdName }}</strong>.</p>
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="bi bi-info-circle me-2"></i>You are logged in as <strong>{{ .InvitationEmail }}</strong>. Click below to join the household.
                    </div>
                    <p class="text-center text-body-secondary small mt-2">Your current household membership will be replaced.</p>
                    <form id="acceptInviteForm" class="mt-4">
                        <input type="hidden" id="inviteToken" value="{{ .Token }}">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-proviant-primary btn-lg" id="btnAcceptInvite">
                                <i class="bi bi-check-lg me-2"></i>Accept &amp; Join
                            </button>
                            <a href="/web" class="btn btn-proviant-secondary">Cancel</a>
                        </div>
                    </form>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>
</div>

{{ if .ConfirmAccept }}
<script src="/assets/js/acceptInvite.js"></script>
{{ end }}
{{ end }}
