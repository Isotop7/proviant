{{ define "content" }}
<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-envelope-paper display-1 text-primary"></i>
                    <h3 class="mt-3">Household Invitation</h3>
                </div>

                {{ if .Error }}
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>{{ .Error }}
                </div>
                <div class="text-center mt-3">
                    <a href="/web" class="btn btn-outline-primary">Go to Dashboard</a>
                </div>
                {{ else if .Success }}
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle me-2"></i>{{ .Success }}
                </div>
                <div class="text-center mt-3">
                    <a href="/web" class="btn btn-primary">Go to Dashboard</a>
                </div>
                {{ else if .NeedsAuth }}
                <p class="text-center text-muted">You've been invited to join <strong>{{ .HouseholdName }}</strong>.</p>
                <p class="text-center text-muted">Please log in or sign up to accept this invitation.</p>
                <div class="d-grid gap-2 mt-3">
                    <a href="/web/auth?invite_token={{ .Token }}" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Log In / Sign Up
                    </a>
                </div>
                {{ else if .ConfirmAccept }}
                <p class="text-center">You are invited to join the household <strong>{{ .HouseholdName }}</strong>.</p>
                <p class="text-center text-muted small">Your current household membership will be replaced.</p>
                <form id="acceptInviteForm" class="mt-3">
                    <input type="hidden" id="inviteToken" value="{{ .Token }}">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success" id="btnAcceptInvite">
                            <i class="bi bi-check-lg me-2"></i>Accept &amp; Join
                        </button>
                        <a href="/web" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
                <div id="acceptAlert" class="alert mt-3 d-none" role="alert"></div>
                {{ end }}
            </div>
        </div>
    </div>
</div>

{{ if .ConfirmAccept }}
<script src="/assets/js/acceptInvite.js"></script>
{{ end }}
{{ end }}
