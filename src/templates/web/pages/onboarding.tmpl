{{ define "content" }}

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <main class="onboarding-wizard">
        <!-- Header -->
        <div class="text-center mb-4">
            <img src="/assets/icons/hero.png" class="img-fluid mb-3 onboarding-hero" alt="proviant">
            <h2 class="fw-bold">Welcome to Proviant, {{.Username}}!</h2>
            <p class="text-secondary-custom">Let's get you set up in just a few steps.</p>
        </div>

        <!-- Progress Steps -->
        <div class="d-flex justify-content-center align-items-start mb-4">
            <div class="step-indicator" id="stepIndicator1">
                <div class="step-circle">1</div>
                <small>Profile</small>
            </div>
            <div class="step-connector"></div>
            <div class="step-indicator" id="stepIndicator2">
                <div class="step-circle">2</div>
                <small>Household</small>
            </div>
            <div class="step-connector"></div>
            <div class="step-indicator" id="stepIndicator3">
                <div class="step-circle">3</div>
                <small>Notifications</small>
            </div>
        </div>

        <!-- Step 1: Profile -->
        <div class="onboarding-step" id="step1">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-secondary-custom small mb-2">Step 1 of 3</p>
                    <h5 class="card-title"><i class="bi bi-person me-2"></i>Your Profile</h5>
                    <p class="card-text text-secondary-custom">Choose a display name. You can change this later in settings.</p>
                    <div class="mb-3">
                        <input type="text" id="inputDisplayName" class="form-control" placeholder="Display name" maxlength="64" value="{{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button id="btnSaveProfile" class="btn btn-proviant-primary">
                            <i class="bi bi-arrow-right me-1"></i>Continue
                        </button>
                        <button id="btnSkipProfile" class="btn btn-link btn-sm">Skip for now</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Household -->
        <div class="onboarding-step d-none" id="step2">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-secondary-custom small mb-2">Step 2 of 3</p>
                    <h5 class="card-title"><i class="bi bi-people me-2"></i>Your Household</h5>
                    <p class="card-text text-secondary-custom">Households let you share your pantry with family and roommates. Choose one of the options below.</p>

                    <!-- Mode switcher -->
                    <div class="btn-group w-100 mb-3" role="group" aria-label="Household options">
                        <button type="button" id="btnHouseholdModeBrowse" class="btn btn-proviant-secondary btn-sm">
                            <i class="bi bi-search me-1"></i>Browse
                        </button>
                        <button type="button" id="btnHouseholdModeCreate" class="btn btn-proviant-secondary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Create new
                        </button>
                        <button type="button" id="btnHouseholdModeInvite" class="btn btn-proviant-secondary btn-sm">
                            <i class="bi bi-envelope me-1"></i>Use invite code
                        </button>
                    </div>

                    <!-- Browse sub-mode -->
                    <div id="householdModeBrowse" class="d-none">
                        <div id="householdListLoading" class="text-center text-secondary-custom d-none">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span class="ms-2">Loading households...</span>
                        </div>
                        <div id="householdList" class="list-group mb-2 d-none"></div>
                    </div>

                    <!-- Create sub-mode -->
                    <div id="householdModeCreate" class="d-none">
                        <div class="mb-2">
                            <input type="text" id="inputNewHouseholdName" class="form-control" placeholder="Household name" maxlength="64">
                        </div>
                        <button id="btnCreateHousehold" class="btn btn-proviant-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Create Household
                        </button>
                    </div>

                    <!-- Invite sub-mode -->
                    <div id="householdModeInvite" class="d-none">
                        <div class="mb-2">
                            <input type="text" id="inputInviteToken" class="form-control" placeholder="Invite token">
                        </div>
                        <button id="btnJoinByInvite" class="btn btn-proviant-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Join Household
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3: Notifications -->
        <div class="onboarding-step d-none" id="step3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-secondary-custom small mb-2">Step 3 of 3</p>
                    <h5 class="card-title"><i class="bi bi-bell me-2"></i>Stay Notified</h5>
                    <p class="card-text text-secondary-custom">Get notified when products in your household are about to expire. You can configure this later in settings.</p>
                    <button id="btnConfigureNotifications" class="btn btn-proviant-primary">
                        <i class="bi bi-gear me-1"></i>Configure Notifications
                    </button>
                    <button id="btnSkipNotifications" class="btn btn-link btn-sm ms-2">Skip for now</button>
                </div>
            </div>
        </div>

        <!-- Completion Step -->
        <div class="onboarding-step d-none" id="stepComplete">
            <div class="card shadow-sm card-section-accent">
                <div class="card-body text-center">
                    <div class="icon-chip-lg">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    </div>
                    <h5 class="card-title mt-3">You're All Set!</h5>
                    <p class="card-text text-secondary-custom">Start adding products to your pantry and tracking expiration dates.</p>
                    <button id="btnFinishOnboarding" class="btn btn-proviant-primary">
                        <i class="bi bi-arrow-right me-1"></i>Go to Proviant
                    </button>
                </div>
            </div>
        </div>

        <!-- Quick Start Guide -->
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-lightbulb me-2"></i>Quick Start Guide</h6>
                <ul class="mb-0 small text-secondary-custom">
                    <li><strong>Add products</strong> — Scan barcodes or search the Open Food Facts database</li>
                    <li><strong>Track expiration</strong> — Set expiry dates to avoid food waste</li>
                    <li><strong>Share with household</strong> — Invite family members to manage the pantry together</li>
                    <li><strong>Get notified</strong> — Receive alerts before products expire</li>
                </ul>
            </div>
        </div>

        <!-- Navigation -->
        <div class="d-flex justify-content-end mt-4">
            <button id="btnNextStep" class="btn btn-proviant-primary d-none">
                Next <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    </main>
</div>

<script src="/assets/js/onboarding.js"></script>

{{ end }}
