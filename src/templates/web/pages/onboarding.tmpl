{{ define "content" }}

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <main class="onboarding-wizard">
        <!-- Header -->
        <div class="text-center mb-7">
            <img src="/assets/icons/hero.png" class="img-fluid mb-5 onboarding-hero" alt="proviant">
            <h1 class="fw-bold">{{ t "onboarding.welcome" .Username }}</h1>
            <p class="fg-secondary">{{ t "onboarding.subtitle" }}</p>
        </div>

        <!-- Progress Steps -->
        <div class="d-flex justify-content-center align-items-start mb-7">
            <div class="step-indicator" id="stepIndicator1">
                <div class="step-circle">1</div>
                <small>{{ t "onboarding.step.profile" }}</small>
            </div>
            <div class="step-connector"></div>
            <div class="step-indicator" id="stepIndicator2">
                <div class="step-circle">2</div>
                <small>{{ t "onboarding.step.household" }}</small>
            </div>
            <div class="step-connector"></div>
            <div class="step-indicator" id="stepIndicator3">
                <div class="step-circle">3</div>
                <small>{{ t "nav.notifications" }}</small>
            </div>
        </div>

        <!-- Step 1: Profile -->
        <div class="onboarding-step" id="step1">
            <div class="card">
                <div class="card-body">
                    <p class="fg-secondary small mb-3">{{ t "onboarding.step.progress" 1 3 }}</p>
                    <h5 class="card-title"><i class="bi bi-person me-2"></i>{{ t "onboarding.profileTitle" }}</h5>
                    <p class="card-text fg-secondary">{{ t "onboarding.profileDesc" }}</p>
                    <div class="mb-5">
                        <input type="text" id="inputDisplayName" class="form-control" placeholder="{{ t "onboarding.displayNamePlaceholder" }}" maxlength="64" value="{{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}">
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <button id="btnSaveProfile" class="btn btn-solid theme-primary">
                            <i class="bi bi-arrow-right me-1"></i>{{ t "onboarding.continue" }}
                        </button>
                        <button id="btnSkipProfile" class="btn btn-link btn-sm">{{ t "onboarding.skipForNow" }}</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Household -->
        <div class="onboarding-step d-none" id="step2">
            <div class="card">
                <div class="card-body">
                    <p class="fg-secondary small mb-3">{{ t "onboarding.step.progress" 2 3 }}</p>
                    <h5 class="card-title"><i class="bi bi-people me-2"></i>{{ t "onboarding.householdTitle" }}</h5>
                    <p class="card-text fg-secondary">{{ t "onboarding.householdDesc" }}</p>

                    <!-- Mode switcher -->
                    <div class="btn-group w-100 mb-5" role="group" aria-label="{{ t "onboarding.householdOptions" }}">
                        <button type="button" id="btnHouseholdModeBrowse" class="btn btn-outline theme-secondary btn-sm">
                            <i class="bi bi-search me-1"></i>{{ t "onboarding.browse" }}
                        </button>
                        <button type="button" id="btnHouseholdModeCreate" class="btn btn-outline theme-secondary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>{{ t "onboarding.createNew" }}
                        </button>
                        <button type="button" id="btnHouseholdModeInvite" class="btn btn-outline theme-secondary btn-sm">
                            <i class="bi bi-envelope me-1"></i>{{ t "onboarding.useInviteCode" }}
                        </button>
                    </div>

                    <!-- Browse sub-mode -->
                    <div id="householdModeBrowse" class="d-none">
                        <div id="householdListLoading" class="text-center fg-secondary d-none">
                            <div class="spinner-border spinner-sm" role="status"></div>
                            <span class="ms-2">{{ t "onboarding.loadingHouseholds" }}</span>
                        </div>
                        <div id="householdList" class="list-group mb-3 d-none"></div>
                    </div>

                    <!-- Create sub-mode -->
                    <div id="householdModeCreate" class="d-none">
                        <div class="mb-3">
                            <input type="text" id="inputNewHouseholdName" class="form-control" placeholder="{{ t "onboarding.householdNamePlaceholder" }}" maxlength="64">
                        </div>
                        <button id="btnCreateHousehold" class="btn btn-solid theme-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>{{ t "onboarding.createHousehold" }}
                        </button>
                    </div>

                    <!-- Invite sub-mode -->
                    <div id="householdModeInvite" class="d-none">
                        <div class="mb-3">
                            <input type="text" id="inputInviteToken" class="form-control" placeholder="{{ t "onboarding.inviteTokenPlaceholder" }}">
                        </div>
                        <button id="btnJoinByInvite" class="btn btn-solid theme-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>{{ t "onboarding.joinHousehold" }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3: Notifications -->
        <div class="onboarding-step d-none" id="step3">
            <div class="card">
                <div class="card-body">
                    <p class="fg-secondary small mb-3">{{ t "onboarding.step.progress" 3 3 }}</p>
                    <h5 class="card-title"><i class="bi bi-bell me-2"></i>{{ t "onboarding.notificationsTitle" }}</h5>
                    <p class="card-text fg-secondary">{{ t "onboarding.notificationsDesc" }}</p>
                    <button id="btnConfigureNotifications" class="btn btn-solid theme-primary">
                        <i class="bi bi-gear me-1"></i>{{ t "onboarding.configureNotifications" }}
                    </button>
                    <button id="btnSkipNotifications" class="btn btn-link btn-sm ms-2">{{ t "onboarding.skipForNow" }}</button>
                </div>
            </div>
        </div>

        <!-- Completion Step -->
        <div class="onboarding-step d-none" id="stepComplete">
            <div class="card card-section">
                <div class="card-body text-center">
                    <div class="icon-chip-lg">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    </div>
                    <h5 class="card-title mt-5">{{ t "onboarding.completeTitle" }}</h5>
                    <p class="card-text fg-secondary">{{ t "onboarding.completeDesc" }}</p>
                    <button id="btnFinishOnboarding" class="btn btn-solid theme-primary">
                        <i class="bi bi-arrow-right me-1"></i>{{ t "onboarding.goToProviant" }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Quick Start Guide -->
        <div class="card mt-7">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-lightbulb me-2"></i>{{ t "onboarding.quickStartTitle" }}</h6>
                <ul class="mb-0 small fg-secondary">
                    <li><strong>{{ t "onboarding.quickStart.addProducts" }}</strong> — {{ t "onboarding.quickStart.addProductsDesc" }}</li>
                    <li><strong>{{ t "onboarding.quickStart.trackExpiration" }}</strong> — {{ t "onboarding.quickStart.trackExpirationDesc" }}</li>
                    <li><strong>{{ t "onboarding.quickStart.shareHousehold" }}</strong> — {{ t "onboarding.quickStart.shareHouseholdDesc" }}</li>
                    <li><strong>{{ t "onboarding.quickStart.getNotified" }}</strong> — {{ t "onboarding.quickStart.getNotifiedDesc" }}</li>
                </ul>
            </div>
        </div>

        <!-- Navigation -->
        <div class="d-flex justify-content-end mt-7">
            <button id="btnNextStep" class="btn btn-solid theme-primary d-none">
                {{ t "common.next" }} <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    </main>
</div>

<script src="/assets/js/onboarding.js"></script>

{{ end }}