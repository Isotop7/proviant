{{ define "content" }}
<h2>Login</h2>
<form>
	<label>
		Username:
		<input type="text" bind:value={username} required />
	</label>
	<label>
		Password:
		<input type="password" bind:value={password} required />
	</label>
	<button type="submit" on:click={handleSignup} {disabled}>Signup</button>
</form>
{{ end }}