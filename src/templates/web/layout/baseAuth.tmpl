{{define "baseAuth"}}
<!doctype html>
<html lang="{{ .Lang }}" class="h-100">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ if .TitleText }}proviant - {{ .TitleText}}{{ else }}proviant{{ end }}</title>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3D7A5C">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Proviant">
    <link rel="apple-touch-icon" href="/assets/icons/proviant_logo_192.png">

    <script src="/assets/js/theme.js"></script>
    <link rel="stylesheet" href="/assets/css/main.css">
    <script nonce="{{ .CSPNonce }}">window.proviantI18n = {{ .I18nJSON }};window.proviantLang = "{{ .Lang }}";</script>
    <script src="/assets/js/proviant.js"></script>
</head>

<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skipToContent" }}</a>
    <main id="main-content">
    {{template "content" .}}
    </main>
    <!-- Shared confirm dialog — destructive actions requiring user decision -->
    <dialog class="dialog dialog-md" id="proviantConfirmModal" aria-labelledby="proviantConfirmModalLabel">
                <div class="dialog-header">
                    <div class="dialog-icon dialog-icon-danger" id="proviantConfirmIconBox" aria-hidden="true">
                        <i id="proviantConfirmIcon" class="bi bi-exclamation-triangle-fill"></i>
                    </div><h5 id="proviantConfirmTitle" class="dialog-title mb-0"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <div class="dialog-body">
                    <p id="proviantConfirmMessage" class="fg-secondary small mb-0"></p>
                </div>
                <div class="dialog-footer justify-content-end gap-3 flex-nowrap">
                    <button type="button" class="btn btn-outline theme-secondary text-nowrap" data-bs-dismiss="dialog">{{ t "common.cancel" }}</button>
                    <button type="button" class="btn btn-solid theme-danger text-nowrap" id="proviantConfirmBtn">{{ t "common.confirm" }}</button>
                </div>
            </dialog>

    <!-- Toasts — page-level feedback for every async result -->
    <div class="toast-stack" id="proviantToastStack" aria-live="polite" aria-atomic="true"></div>

    <script type="module" src="/assets/js/bootstrap-globals.js"></script>
    <script src="/assets/js/auth.js"></script>
</body>

</html>
{{end}}
