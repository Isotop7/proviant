{{define "base"}}
<!doctype html>
<html lang="{{ .Lang }}" class="h-100">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if .TitleText }}proviant - {{ .TitleText}}{{ else }}proviant{{ end }}</title>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#418069">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Proviant">
  <link rel="apple-touch-icon" href="/assets/icons/proviant_logo_192.png">

  <script src="/assets/js/theme.js"></script>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script nonce="{{ .CSPNonce }}">window.proviantI18n = {{ .I18nJSON }};window.proviantLang = "{{ .Lang }}";window.proviantOffline = { maxBatchBytes: {{ .OfflineSyncMaxBodyBytes }} };window.proviantLimits = { maxQuantity: {{ .MaxProductQuantity }}, maxPackSizeLength: {{ .MaxPackSizeLength }} };</script>
  <script src="/assets/js/proviant.js"></script>
  <script src="/assets/js/offlineQueue.js"></script>
</head>

<body>
  <a href="#main-content" class="skip-link">{{ t "a11y.skipToContent" }}
  <div class="app">
    {{template "nav" .}}

    <div class="app__main">
      <header class="app__topbar">
        <h1 class="app__topbar-title">{{ .TitleText }}</h1>

        <div class="app__topbar-actions">
          <div class="position-relative">
            <button class="btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false"
              aria-label="{{ t "a11y.notifications" }}" title="{{ t "nav.notifications" }}">
              <i class="bi bi-bell" aria-hidden="true"></i>
              <span class="nav-badge position-absolute d-none" id="notification-badge">0</span>
            </button>
            <div class="dropdown-menu p-0 dropdown-menu-end" id="notification-dropdown">
              <div class="px-3 py-2 border-bottom">
                <span class="fw-bold small">{{ t "nav.notifications" }}</span>
              </div>
              <div id="notification-items">
                <p class="text-body-secondary small px-3 py-2 mb-0">{{ t "common.loading" }}</p>
              </div>
            </div>
          </div>

          <div class="d-none d-md-flex gap-1">
            <button class="btn-icon" type="button" id="btnThemeToggle"
              aria-label="{{ t "a11y.toggleColorTheme" }}" title="{{ t "a11y.toggleColorTheme" }}">
              <i class="bi bi-circle-half" id="themeToggleIcon" aria-hidden="true"></i>
            </button>

            <a class="btn-icon" href="/web" data-logout aria-label="{{ t "nav.logout" }}" title="{{ t "nav.logout" }}">
              <i class="bi bi-escape" aria-hidden="true"></i>
            </a>
          </div>

          <!-- Mobile only: the rest of the utility cluster -->
          <div class="mobile-top-more d-md-none">
            <button class="mobile-top-more-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ t "a11y.moreOptions" }}">
              <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end mobile-top-more-dropdown">
              <button type="button" class="dropdown-item" id="btnThemeToggleMobile">
                <i class="bi bi-circle-half me-2" id="themeToggleIconMobile" aria-hidden="true"></i>{{ t "common.toggleTheme" }}
              </button>
              <div class="dropdown-divider"></div>
              <a href="/web/user/settings" class="dropdown-item">
                <i class="bi bi-gear-wide-connected me-2" aria-hidden="true"></i>{{ t "common.settings" }}
              </a>
              <a href="/web" data-logout class="dropdown-item dropdown-item-danger">
                <i class="bi bi-escape me-2" aria-hidden="true"></i>{{ t "common.logout" }}
              </a>
            </div>
          </div>
        </div>
      </header>

      <main id="main-content" class="app__content">
        {{template "content" .}}
      </main>
    </div>
  </div>
  <!-- Shared confirm modal — destructive actions requiring user decision -->
  <div id="proviantConfirmModal" class="modal fade" tabindex="-1"
       aria-labelledby="proviantConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-icon modal-icon-danger" id="proviantConfirmIconBox" aria-hidden="true">
            <i id="proviantConfirmIcon" class="bi bi-exclamation-triangle-fill"></i>
          </div><h5 id="proviantConfirmTitle" class="modal-title mb-0"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
            <i class="bi bi-x"></i>
          </button>
        </div>
        <div class="modal-body">
          <p id="proviantConfirmMessage" class="text-body-secondary small mb-0"></p>
        </div>
        <div class="modal-footer justify-content-end gap-2 flex-nowrap">
          <button type="button" class="btn btn-outline-secondary text-nowrap" data-bs-dismiss="modal">{{ t "common.cancel" }}</button>
          <button type="button" class="btn btn-danger text-nowrap" id="proviantConfirmBtn">{{ t "common.confirm" }}</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toasts — page-level feedback for every async result -->
  <div class="toast-stack" id="proviantToastStack" aria-live="polite" aria-atomic="true"></div>

  <script src="/assets/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/notifications.js" defer></script>
</body>

</html>
{{end}}
