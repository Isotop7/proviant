{{define "base"}}
<!doctype html>
<html lang="{{ .Lang }}" class="h-100">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if .TitleText }}proviant - {{ .TitleText}}{{ else }}proviant{{ end }}</title>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#3D7A5C">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Proviant">
  <link rel="apple-touch-icon" href="/assets/icons/proviant_logo_192.png">

  <script src="/assets/js/theme.js"></script>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script nonce="{{ .CSPNonce }}">window.proviantI18n = {{ .I18nJSON }};window.proviantLang = "{{ .Lang }}";window.proviantOffline = { maxBatchBytes: {{ .OfflineSyncMaxBodyBytes }} };window.proviantUnitSystem = "{{ .UnitSystem }}";window.proviantUnits = {{ .UnitOptionsJSON }};window.proviantUnitTable = {{ .UnitConversionJSON }};window.proviantUnitAliases = {{ .UnitAliasJSON }};</script>
  <script src="/assets/js/proviant.js"></script>
  <script src="/assets/js/offlineQueue.js"></script>
</head>

<body>
  <a href="#main-content" class="skip-link">{{ t "a11y.skipToContent" }}</a>
  {{template "nav" .}}
  <!-- Mobile top-right more menu -->
  <div class="mobile-top-more">
    <button class="mobile-top-more-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ t "a11y.moreOptions" }}">
      <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
    </button>
    <div class="dropdown-menu dropdown-menu-end mobile-top-more-dropdown">
      <button type="button" class="dropdown-item" id="btnThemeToggleMobile">
        <i class="bi bi-circle-half me-2" id="themeToggleIconMobile" aria-hidden="true"></i>{{ t "common.toggleTheme" }}
      </button>
      <div class="dropdown-divider"></div>
      <a href="/web/user/settings" class="dropdown-item">
        <i class="bi bi-gear-wide-connected me-2" aria-hidden="true"></i>{{ t "common.settings" }}
      </a>
      <a href="/web" id="btnLogout" class="dropdown-item dropdown-item-danger">
        <i class="bi bi-escape me-2" aria-hidden="true"></i>{{ t "common.logout" }}
      </a>
    </div>
  </div>
  <!-- Mobile bottom navigation -->
  <nav class="bottom-nav" aria-label="{{ t "a11y.mobileNavigation" }}">
    <a href="/web" class="bottom-nav-item {{ if eq .Title "Home" }}active{{ end }}"
       {{ if eq .Title "Home" }}aria-current="page"{{ end }}>
      <i class="bi bi-speedometer2" aria-hidden="true"></i><span>{{ t "nav.dashboard" }}</span>
    </a>
    <a href="/web/products" class="bottom-nav-item {{ if eq .Title "Products" }}active{{ end }}"
       {{ if eq .Title "Products" }}aria-current="page"{{ end }}>
      <i class="bi bi-box-seam" aria-hidden="true"></i><span>{{ t "nav.products" }}</span>
    </a>
    <a href="/web/products/scan" class="bottom-nav-scan {{ if eq .Title "Scan Product" }}active{{ end }}"
       {{ if eq .Title "Scan Product" }}aria-current="page"{{ end }}>
      <i class="bi bi-upc-scan" aria-hidden="true"></i>
    </a>
    <a href="/web/shopping-list" class="bottom-nav-item {{ if eq .Title "Shopping List" }}active{{ end }}"
       {{ if eq .Title "Shopping List" }}aria-current="page"{{ end }}>
      <i class="bi bi-cart3" aria-hidden="true"></i><span>{{ t "nav.shopping" }}</span>
    </a>
    <a href="/web/recipes" class="bottom-nav-item {{ if eq .Title "Recipes" }}active{{ end }}"
       {{ if eq .Title "Recipes" }}aria-current="page"{{ end }}>
      <i class="bi bi-book" aria-hidden="true"></i><span>{{ t "nav.recipes" }}</span>
    </a>
  </nav>
  <!-- Offline banner — shown by JS while offline, and while changes are stuck unsynced -->
  <div id="offlineBanner" class="offline-banner d-none">
    <span role="status" aria-live="polite">
      <i id="offlineBannerIcon" class="bi bi-wifi-off me-2" aria-hidden="true"></i>
      <span id="offlineBannerText">{{ t "common.offlineBanner" }}</span>
      <span id="offlineQueueCount" class="ms-1 fw-semibold d-none"></span>
    </span>
    <button type="button" id="offlineQueueRetry" class="btn btn-link btn-sm p-0 fw-semibold ms-2 offline-banner-action d-none">{{ t "common.retry" }}</button>
    <button type="button" id="offlineQueueDiscard" class="btn btn-link btn-sm p-0 fw-semibold ms-2 offline-banner-action d-none">{{ t "common.discard" }}</button>
  </div>
  <!-- Update banner — shown by JS when new service worker activates -->
  <div id="swUpdateBanner" class="sw-update-banner d-none" role="status" aria-live="polite">
    <i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>
    {{ t "common.updateAvailable" }}
    <a href="/" class="btn btn-link btn-sm p-0 fw-semibold sw-update-reload">{{ t "common.reload" }}</a>
    {{ t "common.updateHint" }}
  </div>

  <main id="main-content">
    <div id="content-wrapper">
      {{template "content" .}}
    </div>
  </main>
  <!-- Shared confirm modal — destructive actions requiring user decision -->
  <div id="proviantConfirmModal" class="modal fade" tabindex="-1"
       aria-labelledby="proviantConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-icon modal-icon-danger" id="proviantConfirmIconBox" aria-hidden="true">
            <i id="proviantConfirmIcon" class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <div class="modal-header-body">
            <h5 id="proviantConfirmTitle" class="modal-title mb-0"></h5>
          </div>
          <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
            <i class="bi bi-x"></i>
          </button>
        </div>
        <div class="modal-body">
          <p id="proviantConfirmMessage" class="text-secondary-custom small mb-0"></p>
        </div>
        <div class="modal-footer justify-content-end gap-2 flex-nowrap">
          <button type="button" class="btn btn-proviant-secondary text-nowrap" data-bs-dismiss="modal">{{ t "common.cancel" }}</button>
          <button type="button" class="btn btn-proviant-danger text-nowrap" id="proviantConfirmBtn">{{ t "common.confirm" }}</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Shared feedback modal — all pages, all async results -->
  <div id="proviantFeedbackModal" class="modal fade" tabindex="-1"
       aria-labelledby="proviantFeedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-icon" id="proviantFeedbackIconBox" aria-hidden="true">
            <i id="proviantFeedbackIcon" class="bi"></i>
          </div>
          <div class="modal-header-body">
            <h5 id="proviantFeedbackTitle" class="modal-title mb-0"></h5>
          </div>
          <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="{{ t "a11y.close" }}">
            <i class="bi bi-x"></i>
          </button>
        </div>
        <div class="modal-body">
          <p id="proviantFeedbackMessage" class="text-secondary-custom small mb-0"></p>
        </div>
        <div class="modal-footer justify-content-end">
          <button type="button" class="btn btn-proviant-primary"
                  id="proviantFeedbackBtn" data-bs-dismiss="modal">{{ t "common.ok" }}</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/notifications.js" defer></script>
</body>

</html>
{{end}}
