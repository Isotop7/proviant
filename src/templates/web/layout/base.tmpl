{{define "base"}}
<!doctype html>
<html lang="en" data-bs-theme="light" class="h-100">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if .Title }}proviant - {{ .Title}}{{ else }}proviant{{ end }}</title>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#3D7A5C">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Proviant">
  <link rel="apple-touch-icon" href="/assets/icons/proviant_logo_192.png">

  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/proviant.js"></script>
</head>

<body>
  {{template "nav" .}}
  <!-- Mobile bottom navigation -->
  <nav class="bottom-nav" aria-label="Mobile navigation">
    <div class="bottom-nav-left">
      <a href="/web" class="bottom-nav-item {{ if eq .Title "Home" }}active{{ end }}"
         {{ if eq .Title "Home" }}aria-current="page"{{ end }}>
        <i class="bi bi-speedometer2" aria-hidden="true"></i><span>Dashboard</span>
      </a>
      <a href="/web/products" class="bottom-nav-item {{ if eq .Title "Products" }}active{{ end }}"
         {{ if eq .Title "Products" }}aria-current="page"{{ end }}>
        <i class="bi bi-box-seam" aria-hidden="true"></i><span>Products</span>
      </a>
    </div>
    <div class="bottom-nav-center">
      <a href="/web/products/scan" class="bottom-nav-scan {{ if eq .Title "Scan Product" }}active{{ end }}"
         {{ if eq .Title "Scan Product" }}aria-current="page"{{ end }}>
        <i class="bi bi-upc-scan" aria-hidden="true"></i>
      </a>
    </div>
    <div class="bottom-nav-right">
      <a href="/web/recipes" class="bottom-nav-item {{ if eq .Title "Recipes" }}active{{ end }}"
         {{ if eq .Title "Recipes" }}aria-current="page"{{ end }}>
        <i class="bi bi-book" aria-hidden="true"></i><span>Recipes</span>
      </a>
      <a href="/web/user/settings" class="bottom-nav-item {{ if eq .Title "User Settings" }}active{{ end }}"
         {{ if eq .Title "User Settings" }}aria-current="page"{{ end }}>
        <i class="bi bi-person-circle" aria-hidden="true"></i><span>Settings</span>
      </a>
    </div>
  </nav>
  <!-- Offline banner — shown by JS when navigator.onLine === false -->
  <div id="offlineBanner" class="offline-banner d-none" role="status" aria-live="polite">
    <i class="bi bi-wifi-off me-2" aria-hidden="true"></i>
    You're offline — showing cached data. Changes will sync when reconnected.
    <span id="offlineQueueCount" class="ms-1 fw-semibold d-none"></span>
  </div>
  <!-- Update banner — shown by JS when new service worker activates -->
  <div id="swUpdateBanner" class="sw-update-banner d-none" role="status" aria-live="polite">
    <i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>
    Update available —
    <a href="/" class="btn btn-link btn-sm p-0 fw-semibold sw-update-reload">Reload</a>
    to get the latest version.
  </div>

  <main>
    <div id="content-wrapper">
      {{template "content" .}}
    </div>
  </main>
  <!-- Shared confirm modal — destructive actions requiring user decision -->
  <div id="proviantConfirmModal" class="modal fade" tabindex="-1"
       aria-labelledby="proviantConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-icon modal-icon-danger" id="proviantConfirmIconBox" aria-hidden="true">
            <i id="proviantConfirmIcon" class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <div class="modal-header-body">
            <h5 id="proviantConfirmTitle" class="modal-title mb-0"></h5>
          </div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p id="proviantConfirmMessage" class="text-secondary-custom small mb-0"></p>
        </div>
        <div class="modal-footer justify-content-end gap-2">
          <button type="button" class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-proviant-danger" id="proviantConfirmBtn">Confirm</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Shared feedback modal — all pages, all async results -->
  <div id="proviantFeedbackModal" class="modal fade" tabindex="-1"
       aria-labelledby="proviantFeedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-icon" id="proviantFeedbackIconBox" aria-hidden="true">
            <i id="proviantFeedbackIcon" class="bi"></i>
          </div>
          <div class="modal-header-body">
            <h5 id="proviantFeedbackTitle" class="modal-title mb-0"></h5>
          </div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p id="proviantFeedbackMessage" class="text-secondary-custom small mb-0"></p>
        </div>
        <div class="modal-footer justify-content-end">
          <button type="button" class="btn btn-proviant-primary"
                  id="proviantFeedbackBtn" data-bs-dismiss="modal">OK</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/notifications.js" defer></script>
</body>

</html>
{{end}}
