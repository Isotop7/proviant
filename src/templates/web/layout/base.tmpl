{{define "base"}}
<!doctype html>
<html lang="{{ .Lang }}" class="h-100">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if .TitleText }}proviant - {{ .TitleText}}{{ else }}proviant{{ end }}</title>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#418069">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Proviant">
  <link rel="apple-touch-icon" href="/assets/icons/proviant_logo_192.png">

  <script src="/assets/js/theme.js"></script>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script nonce="{{ .CSPNonce }}">window.proviantI18n = {{ .I18nJSON }};window.proviantLang = "{{ .Lang }}";window.proviantOffline = { maxBatchBytes: {{ .OfflineSyncMaxBodyBytes }} };window.proviantLimits = { maxQuantity: {{ .MaxProductQuantity }}, maxPackSizeLength: {{ .MaxPackSizeLength }}, maxProductNameLength: {{ .MaxProductNameLength }}, mutationClaimTtlSeconds: {{ .MutationClaimTTLSeconds }} };</script>
  <script src="/assets/js/proviant.js"></script>
  <script src="/assets/js/offlineQueue.js"></script>
</head>

<body>
  <a href="#main-content" class="skip-link">{{ t "a11y.skipToContent" }}
  <div class="app">
    <header class="app__topbar">
      {{template "nav" .}}

      <div class="app__topbar-actions">
        <div class="position-relative">
          <button class="btn-icon" type="button" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false"
            aria-label="{{ t "a11y.notifications" }}" title="{{ t "nav.notifications" }}">
            <i class="bi bi-bell" aria-hidden="true"></i>
            <span class="nav-badge position-absolute d-none" id="notification-badge">0</span>
          </button>
          <div class="menu p-0 " id="notification-dropdown">
            <div class="px-5 py-3 border-bottom">
              <span class="fw-bold small">{{ t "nav.notifications" }}</span>
            </div>
            <div id="notification-items">
              <p class="fg-secondary small px-5 py-3 mb-0">{{ t "common.loading" }}</p>
            </div>
          </div>
        </div>

        <div class="d-none lg:d-flex gap-1">
          <button class="btn-icon" type="button" id="btnThemeToggle"
            aria-label="{{ t "a11y.toggleColorTheme" }}" title="{{ t "a11y.toggleColorTheme" }}">
            <i class="bi bi-circle-half" id="themeToggleIcon" aria-hidden="true"></i>
          </button>

          <a class="btn-icon" href="/web" data-logout aria-label="{{ t "nav.logout" }}" title="{{ t "nav.logout" }}">
            <i class="bi bi-escape" aria-hidden="true"></i>
          </a>
        </div>

        <!-- Mobile only: the rest of the utility cluster. Settings has its own
             entry in the topnav, so only the theme toggle and the logout live
             behind the overflow menu here. -->
        <div class="mobile-top-more lg:d-none">
          <button class="mobile-top-more-btn" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false" aria-label="{{ t "a11y.moreOptions" }}">
            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
          </button>
          <div class="menu  mobile-top-more-menu">
            <button type="button" class="menu-item" id="btnThemeToggleMobile">
              <i class="bi bi-circle-half me-2" id="themeToggleIconMobile" aria-hidden="true"></i>{{ t "common.toggleTheme" }}
            </button>
            <div class="menu-divider"></div>
            <a href="/web" data-logout class="menu-item menu-item-danger">
              <i class="bi bi-escape me-2" aria-hidden="true"></i>{{ t "common.logout" }}
            </a>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="app__content{{ with .ContentClass }} {{ . }}{{ end }}">
      {{template "content" .}}
    </main>

    <footer class="app__footer">
      <a href="/web/licenses">{{ t "nav.licenses" }}</a>
      <a href="https://github.com/Isotop7/proviant" target="_blank" rel="noopener">{{ t "nav.viewSource" }}</a>
      <span class="app__footer-version">{{ .Version }}</span>
    </footer>
  </div>
  <!-- Mobile bottom navigation — the link row of the topnav is gone below 1024 px -->
  <nav class="bottom-nav" aria-label="{{ t "a11y.mobileNavigation" }}">
    <a href="/web" class="bottom-nav-item {{ if eq .Title "Home" }}active{{ end }}"
       {{ if eq .Title "Home" }}aria-current="page"{{ end }}>
      <i class="bi bi-speedometer2" aria-hidden="true"></i><span>{{ t "nav.dashboard" }}</span>
    </a>
    <a href="/web/products" class="bottom-nav-item {{ if eq .Title "Products" }}active{{ end }}"
       {{ if eq .Title "Products" }}aria-current="page"{{ end }}>
      <i class="bi bi-box-seam" aria-hidden="true"></i><span>{{ t "nav.products" }}</span>
    </a>
    <a href="/web/products/scan" class="bottom-nav-scan {{ if eq .Title "Scan Product" }}active{{ end }}"
       {{ if eq .Title "Scan Product" }}aria-current="page"{{ end }}>
      <i class="bi bi-upc-scan" aria-hidden="true"></i>
    </a>
    <a href="/web/shopping-list" class="bottom-nav-item {{ if eq .Title "Shopping List" }}active{{ end }}"
       {{ if eq .Title "Shopping List" }}aria-current="page"{{ end }}>
      <i class="bi bi-cart3" aria-hidden="true"></i><span>{{ t "nav.shopping" }}</span>
    </a>
    <button type="button"
            class="bottom-nav-item {{ if or (eq .Title "Recipes") (eq .Title "Meal Plan") (eq .Title "Waste Analytics") }}active{{ end }}"
            data-bs-toggle="drawer" data-bs-target="#mobileNavOffcanvas"
            aria-controls="mobileNavOffcanvas">
      <i class="bi bi-grid" aria-hidden="true"></i><span>{{ t "nav.more" }}</span>
    </button>
  </nav>
  <!-- Mobile more sheet — destinations that do not fit the bottom bar -->
  <dialog class="drawer drawer-bottom mobile-nav-drawer" id="mobileNavOffcanvas"
       aria-labelledby="mobileNavOffcanvasLabel">
    <div class="drawer-header">
      <h5 class="drawer-title" id="mobileNavOffcanvasLabel">{{ t "nav.more" }}</h5>
      <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="{{ t "a11y.close" }}"></button>
    </div>
    <div class="drawer-body p-0">
      <div class="list-group list-group-flush">
        <a href="/web/recipes"
           class="list-group-item list-group-item-action mobile-nav-link d-flex align-items-center gap-5 {{ if eq .Title "Recipes" }}active{{ end }}"
           {{ if eq .Title "Recipes" }}aria-current="page"{{ end }}>
          <i class="bi bi-journal-richtext" aria-hidden="true"></i><span>{{ t "nav.recipes" }}</span>
        </a>
        <a href="/web/mealplan"
           class="list-group-item list-group-item-action mobile-nav-link d-flex align-items-center gap-5 {{ if eq .Title "Meal Plan" }}active{{ end }}"
           {{ if eq .Title "Meal Plan" }}aria-current="page"{{ end }}>
          <i class="bi bi-calendar-week" aria-hidden="true"></i><span>{{ t "nav.mealPlan" }}</span>
        </a>
        <a href="/web/waste-analytics"
           class="list-group-item list-group-item-action mobile-nav-link d-flex align-items-center gap-5 {{ if eq .Title "Waste Analytics" }}active{{ end }}"
           {{ if eq .Title "Waste Analytics" }}aria-current="page"{{ end }}>
          <i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>{{ t "nav.wasteAnalytics" }}</span>
        </a>
      </div>
    </div>
  </dialog>
  <!-- Shared confirm dialog — destructive actions requiring user decision -->
  <dialog class="dialog dialog-md" id="proviantConfirmModal" aria-labelledby="proviantConfirmModalLabel">
        <div class="dialog-header">
          <div class="dialog-icon dialog-icon-danger" id="proviantConfirmIconBox" aria-hidden="true">
            <i id="proviantConfirmIcon" class="bi bi-exclamation-triangle-fill"></i>
          </div><h5 id="proviantConfirmTitle" class="dialog-title mb-0"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}">
            <i class="bi bi-x"></i>
          </button>
        </div>
        <div class="dialog-body">
          <p id="proviantConfirmMessage" class="fg-secondary small mb-0"></p>
        </div>
        <div class="dialog-footer justify-content-end gap-3 flex-nowrap">
          <button type="button" class="btn btn-outline theme-secondary text-nowrap" data-bs-dismiss="dialog">{{ t "common.cancel" }}</button>
          <button type="button" class="btn btn-solid theme-danger text-nowrap" id="proviantConfirmBtn">{{ t "common.confirm" }}</button>
        </div>
      </dialog>

  <!-- Toasts — page-level feedback for every async result -->
  <div class="toast-stack" id="proviantToastStack" aria-live="polite" aria-atomic="true"></div>

  <script type="module" src="/assets/js/bootstrap-globals.js"></script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/notifications.js" defer></script>
</body>

</html>
{{end}}
