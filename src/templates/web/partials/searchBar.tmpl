{{ define "searchBar" }}
{{/* Search bar — design-token controlled, no input-group */}}
<div role="search" class="search-bar mb-2 mb-md-0">
    <div class="search-row">
        {{/* Search icon (hidden on mobile to save space) */}}
        <i class="bi bi-search search-icon d-none d-md-block" aria-hidden="true"></i>

        {{/* Field selector */}}
        <div class="select-wrapper">
            <select id="search-param" class="search-select" aria-label="Search by field">
                <option value="product_name" {{ if eq .QueryParam "product_name" }}selected{{ end }}>Product Name</option>
                <option value="barcode" {{ if eq .QueryParam "barcode" }}selected{{ end }}>Barcode</option>
            </select>
            <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
        </div>

        {{/* Search input */}}
        <input type="search" id="search-query" class="search-input" placeholder="Search products..."
            value="{{ .QueryValue }}" aria-label="Search products" />

        {{/* Search button */}}
        <button id="search-btn" class="btn btn-search" title="Search" type="button">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Search</span>
        </button>

        {{/* Show all button */}}
        <button id="show-all-btn" class="btn btn-show-all" type="button" title="Show all">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Show all</span>
        </button>

        {{/* Filters button */}}
        <button class="btn btn-filters" type="button"
            data-bs-toggle="collapse" data-bs-target="#advanced-filters"
            aria-expanded="false" aria-controls="advanced-filters"
            title="Advanced filters">
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Filters</span>
        </button>
    </div>

    {{/* Advanced filters */}}
    <div id="advanced-filters" class="collapse w-100 mt-2">
        <div class="filter-row">
            <div class="select-wrapper">
                <label for="sort-param" class="filter-label">Order by</label>
                <select id="sort-param" class="filter-select">
                    <option value="created_at" {{ if eq .Sort "created_at" }}selected{{ end }}>Created At</option>
                    <option value="expire_at" {{ if eq .Sort "expire_at" }}selected{{ end }}>Expiry Date</option>
                    <option value="scanned_at" {{ if eq .Sort "scanned_at" }}selected{{ end }}>Scanned At</option>
                    <option value="notified_at" {{ if eq .Sort "notified_at" }}selected{{ end }}>Notified At</option>
                </select>
                <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
            </div>
            <div class="select-wrapper">
                <label for="sort-order" class="filter-label">Direction</label>
                <select id="sort-order" class="filter-select" aria-label="Sort order">
                    <option value="asc" {{ if eq .Order "asc" }}selected{{ end }}>↑ Ascending</option>
                    <option value="desc" {{ if eq .Order "desc" }}selected{{ end }}>↓ Descending</option>
                </select>
                <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
            </div>
            {{ if .Locations }}
            <div class="select-wrapper">
                <label for="location-filter" class="filter-label">Location</label>
                <select id="location-filter" class="filter-select">
                    <option value="">All locations</option>
                    {{ range .Locations }}
                    <option value="{{ .ID }}"
                        {{ if eq $.LocationFilter (printf "%d" .ID) }}selected{{ end }}>
                        {{ .Icon }} {{ .Name }}
                    </option>
                    {{ end }}
                </select>
                <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
            </div>
            {{ end }}
        </div>
    </div>
</div>

<!-- Empty product-list div for JavaScript injection -->
<div id="product-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 my-auto d-none"></div>
{{ end }}
