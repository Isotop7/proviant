{{ define "searchBar" }}
{{/* Search bar — design-token controlled, no input-group */}}
<div role="search" class="search-bar mb-2 mb-md-0">
    <div class="search-row">
        {{/* Search icon */}}
        <i class="bi bi-search search-icon" aria-hidden="true"></i>

        {{/* Field selector — two toggles inside the field, the way the screen sheets draw it */}}
        <div class="search-scope" role="group" aria-label="{{ t "partial.searchBar.searchByField" }}">
            <button type="button" class="search-scope__toggle{{ if ne .QueryParam "barcode" }} active{{ end }}" data-scope="product_name" aria-pressed="{{ if ne .QueryParam "barcode" }}true{{ else }}false{{ end }}">{{ t "partial.searchBar.fieldProductName" }}</button>
            <button type="button" class="search-scope__toggle{{ if eq .QueryParam "barcode" }} active{{ end }}" data-scope="barcode" aria-pressed="{{ if eq .QueryParam "barcode" }}true{{ else }}false{{ end }}">{{ t "partial.searchBar.fieldBarcode" }}</button>
        </div>

        {{/* Search input */}}
        <input type="search" id="search-query" class="search-input" placeholder="{{ t "partial.searchBar.searchPlaceholder" }}"
            value="{{ .QueryValue }}" aria-label="{{ t "partial.searchBar.searchProducts" }}" />

        {{/* Clear the search */}}
        <button type="button" id="search-clear" class="search-clear" title="{{ t "partial.searchBar.clearSearch" }}" aria-label="{{ t "partial.searchBar.clearSearch" }}">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>

    {{/* Advanced filters */}}
    <div id="advanced-filters" class="collapse w-100 mt-2">
        <div class="filter-row">
            <div class="select-wrapper">
                <label for="sort-param" class="filter-label">{{ t "partial.searchBar.orderBy" }}</label>
                <select id="sort-param" class="filter-select">
                    <option value="created_at" {{ if eq .Sort "created_at" }}selected{{ end }}>{{ t "partial.searchBar.sortCreatedAt" }}</option>
                    <option value="expire_at" {{ if eq .Sort "expire_at" }}selected{{ end }}>{{ t "partial.searchBar.sortExpireAt" }}</option>
                    <option value="scanned_at" {{ if eq .Sort "scanned_at" }}selected{{ end }}>{{ t "partial.searchBar.sortScannedAt" }}</option>
                    <option value="notified_at" {{ if eq .Sort "notified_at" }}selected{{ end }}>{{ t "partial.searchBar.sortNotifiedAt" }}</option>
                </select>
                <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
            </div>
            <div class="select-wrapper">
                <label for="sort-order" class="filter-label">{{ t "partial.searchBar.direction" }}</label>
                <select id="sort-order" class="filter-select" aria-label="{{ t "partial.searchBar.sortOrder" }}">
                    <option value="asc" {{ if eq .Order "asc" }}selected{{ end }}>↑ {{ t "partial.searchBar.ascending" }}</option>
                    <option value="desc" {{ if eq .Order "desc" }}selected{{ end }}>↓ {{ t "partial.searchBar.descending" }}</option>
                </select>
                <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
            </div>
            {{ if .Locations }}
            <div class="select-wrapper">
                <label for="location-filter" class="filter-label">{{ t "partial.location" }}</label>
                <select id="location-filter" class="filter-select">
                    <option value="">{{ t "partial.searchBar.allLocations" }}</option>
                    {{ range .Locations }}
                    <option value="{{ .ID }}"
                        {{ if eq $.LocationFilter (printf "%d" .ID) }}selected{{ end }}>
                        {{ .Icon }} {{ .Name }}
                    </option>
                    {{ end }}
                </select>
                <i class="bi bi-chevron-down select-indicator" aria-hidden="true"></i>
            </div>
            {{ end }}
        </div>
    </div>
</div>

<!-- Empty product-list div for JavaScript injection -->
<div id="product-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 my-auto d-none"></div>
{{ end }}
