                        <li class="mb-2">{{ t "household.telegramLinkStepClick" }} <strong>{{ t "household.openInTelegram" }}</strong> {{ t "household.telegramLinkStepOpen" }}</li>
                        <li class="mb-2">{{ t "household.telegramLinkStepPress" }} <strong>{{ t "household.start" }}</strong> {{ t "household.telegramLinkStepStart" }}</li>
                    </ol>
