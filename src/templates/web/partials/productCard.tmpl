{{ define "productCard" }}

{{ with . }}
{{ $eff := effectiveExpireAt . }}
{{ $cls := expiryStatusClass $eff }}

<div class="col">
    <div class="card product-card h-100" id="card-{{ .Model.ID }}">
        <div class="status-bar status-bar-{{ $cls }}"></div>
        <div class="d-flex align-items-center gap-2 px-3 pt-2 pb-1">
            <input class="form-check-input flex-shrink-0 row-checkbox" type="checkbox" id="checkbox-{{ .Model.ID }}" value="{{ .Model.ID }}"
                aria-label="{{ t "partial.productCard.select" .ProductName }}">
            <span class="id-chip ms-auto">#{{- .Model.ID -}}</span>
        </div>
        <div class="product-img">
            {{ if .ImageURL }}
            <img src="{{ .ImageURL }}" alt="{{ .ProductName }}" loading="lazy">
            <div class="product-img-fallback">
                <i class="bi bi-box-seam"></i>
            </div>
            {{ else }}
            <div class="product-img-fallback">
                <i class="bi bi-box-seam"></i>
            </div>
            {{ end }}
        </div>
        <div class="card-body p-3">
            <div class="product-name">{{ .ProductName }}
                {{ if and .IsPrivate (eq .UserID $.CurrentUserID) }}
                <i class="bi bi-lock" title="{{ t "partial.productCard.privateProduct" }}"></i>
                {{ end }}
            </div>
            <div class="product-cat mb-1">{{ badgifyCategories .Categories 3 }}</div>
            <div class="product-cat font-monospace mb-2">{{- .Barcode -}}</div>
            <span class="badge-status badge-{{ $cls }}">
                <i class="bi bi-{{ expiryStatusIcon $eff }}" aria-hidden="true"></i>
                {{ expiryStatusLabel $eff }}
            </span>
            {{ if and (gt .MinStockAmount 0) (lt .Amount .MinStockAmount) }}
            <span class="badge-status badge-lowstock">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                {{ t "partial.productCard.lowStock" }}
            </span>
            {{ end }}
            {{ if .OpenedAt }}
            <span class="badge-status badge-opened" title="{{ t "partial.productCard.openedOn" (.OpenedAt | humanDate) }}{{ if .DaysAfterOpening }} — {{ tn "partial.productCard.shelfLifeDays" .DaysAfterOpening }}{{ end }}">
                <i class="bi bi-box-open" aria-hidden="true"></i>
                {{ t "partial.productCard.opened" (.OpenedAt | humanDate) }}
            </span>
            {{ end }}
            <div class="product-meta mt-2">
                <i class="bi bi-calendar-event" aria-hidden="true"></i> {{ .ExpireAt | humanDate }}
            </div>
            {{ $urgency := expiryUrgencyText $eff }}
            {{ if $urgency }}
            <div class="product-meta mt-1 fw-semibold text-status-{{ $cls }}">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span class="urgency-text d-none d-sm-inline">{{ $urgency }}</span>
                <span class="urgency-days d-inline d-sm-none">{{ expiryDays $eff }}</span>
            </div>
            {{ end }}
            {{ if not .OpenedAt }}
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-proviant-secondary btn-mark-opened"
                    data-product-id="{{ .Model.ID }}" aria-label="{{ t "partial.productCard.markAsOpened" }}">
                    <i class="bi bi-box-open" aria-hidden="true"></i> {{ t "partial.productCard.markAsOpened" }}
                </button>
            </div>
            {{ end }}
        </div>
        <ul class="list-group list-group-flush">
            {{ if .StorageLocation }}
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-geo-alt me-2" aria-hidden="true"></i>{{ t "partial.location" }}
                </span>
                <span class="badge-status badge-nodate">{{ .StorageLocation.Icon }} {{ .StorageLocation.Name }}</span>
            </li>
            {{ end }}
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-stack me-2" aria-hidden="true"></i>{{ t "partial.productCard.amount" }}
                </span>
                <span class="d-flex align-items-center gap-1">
                    {{ if isMeasuredUnit .Unit }}
                    <span class="qty-measured">
                        <span class="unit-count">{{ .DisplayQuantity }}</span>
                        <span class="unit-secondary">{{ .DisplayAmount }}</span>
                    </span>
                    {{ else }}
                    <button class="btn btn-sm btn-proviant-secondary btn-amount-dec" data-product-id="{{ .Model.ID }}" aria-label="{{ t "partial.productCard.decreaseAmount" }}">-</button>
                    <span id="amount-{{ .Model.ID }}" class="mx-1 unit-amount" data-amount="{{ .Amount }}" data-unit="{{ .Unit }}">{{ .DisplayQuantity }}</span>
                    <button class="btn btn-sm btn-proviant-secondary btn-amount-inc" data-product-id="{{ .Model.ID }}" aria-label="{{ t "partial.productCard.increaseAmount" }}">+</button>
                    {{ end }}
                </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-upc-scan me-2" aria-hidden="true"></i>{{ t "partial.productCard.scanned" }}
                </span>
                <span class="product-meta">{{ .ScannedAt | humanDateTime }}</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-bell me-2" aria-hidden="true"></i>{{ t "partial.productCard.notified" }}
                </span>
                <span class="product-meta">{{ .NotifiedAt | humanDateTime }}</span>
            </li>
        </ul>
    </div>
</div>

{{ end }}

{{ end }}
