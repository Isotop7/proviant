{{ define "productCard" }}

{{ with . }}

<div class="col">
    <div class="card h-100 d-flex flex-column" id="card-{{ .Model.ID }}">
        <div class="row h-100 px-2">
            <div class="col-md-1 d-flex align-items-start pt-3">
                <input class="form-check-input" type="checkbox" id="checkbox-{{ .Model.ID }}" value=""
                    aria-label="Select {{ .ProductName }}">
            </div>
            <div class="col-md-2">
                <div class="product-card-img-container">
                    <img src="{{ .ImageURL }}" class="img-fluid product-card-img"
                        alt="{{ .ProductName }}"
                        loading="lazy">
                </div>
            </div>
            <div class="col-md-9">
                <div class="card-body d-flex flex-column">
                    <div class="row align-items-center">
                        <div class="col-10">
                            <a href="/web/products/{{ .Model.ID }}/view" class="text-decoration-none">
                                <h4 class="card-title mb-1">
                                    {{ .ProductName }}
                                </h4>
                            </a>
                        </div>
                        <div class="col-2 text-end">
                            <a href="/web/products/{{ .Model.ID }}/view">
                                <span class="badge bg-secondary text-muted">#{{- .Model.ID -}}</span>
                            </a>
                        </div>
                    </div>
                    <div class="card-text font-monospace text-muted small mt-1">
                        {{- .Barcode -}}
                    </div>
                    <div class="card-text mt-2">
                        {{ badgifyCategories .Categories 5 }}
                    </div>
                </div>
            </div>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <i class="bi bi-calendar-x me-2" aria-hidden="true"></i>Expires
                </span>
                <span class="badge rounded-pill {{ expiryBadgeClass .ExpireAt }}">
                    {{ .ExpireAt | humanDate }}
                </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <i class="bi bi-upc-scan me-2" aria-hidden="true"></i>Scanned
                </span>
                <span class="badge bg-primary rounded-pill">
                    {{ .ScannedAt | humanDateTime }}
                </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <i class="bi bi-bell me-2" aria-hidden="true"></i>Notified
                </span>
                <span class="badge bg-secondary rounded-pill">
                    {{ .NotifiedAt | humanDateTime }}
                </span>
            </li>
        </ul>
    </div>
</div>

{{ end }}

{{ end }}
