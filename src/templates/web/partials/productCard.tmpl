{{ define "productCard" }}

{{ with . }}

<div class="col">
    <div class="card mb-3 h-100">
        <div class="row h-100 px-2">
            <div class="col col-3 d-flex align-items-center justify-content-center">
                <img src="{{ .ImageURL }}" class="card-img img-fluid mx-auto">
            </div>
            <div class="col col-9">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-9">
                            <h4 class="card-title">
                                {{ .ProductName }}
                            </h4>
                        </div>
                        <div class="col-3" style="text-align: right;">
                            <h4>
                                <a href="/web/products/{{ .Model.ID }}/view">
                                    <span class="badge bg-primary">#{{- .Model.ID -}}</span>
                                </a>
                            </h4>
                        </div>
                    </div>
                    <div class="card-text font-monospace">
                        {{- .Barcode -}}
                    </div>
                    <div class="card-text">
                        <p>
                            {{ badgifyCategories .Categories 5 }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <ul class="list-group list-group-flush d-flex justify-content-between">
            <li class="list-group-item d-flex justify-content-evenly align-items-center">
                <div class="ms-2 me-auto">
                    <i class="bi bi-trash3 me-3"></i>
                </div>
                <span class="badge rounded-pill {{ if hasPassed .ExpireAt }} bg-danger {{ else }} bg-primary {{ end }}">
                    {{ .ExpireAt | humanDate }}
                </span>
            </li>
            <li class="list-group-item d-flex justify-content-evenly align-items-center">
                <div class="ms-2 me-auto">
                    <i class="bi bi-upc-scan me-3"></i>
                </div>
                <span class="badge bg-primary rounded-pill">
                    {{ .ScannedAt | humanDateTime }}
                </span>
            </li>
            <li class="list-group-item d-flex justify-content-evenly align-items-center">
                <div class="ms-2 me-auto">
                    <i class="bi bi-bell me-3"></i>
                </div>
                <span class="badge bg-primary rounded-pill">
                    {{ .NotifiedAt | humanDateTime }}
                </span>
            </li>
        </ul>
        <div class="btn-group" role="group" aria-label="Basic example">
            <a class="btn btn-primary" href="/web/products/{{ .ID }}/edit">
                <i class="bi bi-pencil-square me-2"></i>Edit
            </a>
            <button class="btn btn-danger btn-product-delete" data-id="{{ .ID }}">
                <i class="bi bi-trash2 me-2"></i>Delete
            </button>
        </div>
    </div>
</div>

{{ end }}

{{ end }}