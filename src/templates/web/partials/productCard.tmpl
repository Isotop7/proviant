{{ define "productCard" }}

{{ with . }}

<div class="col">
    <div class="card product-card h-100" id="card-{{ .Model.ID }}">
        <div class="status-bar" style="background: var(--status-{{ expiryStatusClass .ExpireAt }}-bar);"></div>
        <div class="d-flex align-items-center gap-2 px-3 pt-2 pb-1">
            <input class="form-check-input flex-shrink-0" type="checkbox" id="checkbox-{{ .Model.ID }}" value=""
                aria-label="Select {{ .ProductName }}">
            <span class="badge bg-secondary ms-auto">#{{- .Model.ID -}}</span>
        </div>
        <div class="product-img">
            {{ if .ImageURL }}
            <img src="{{ .ImageURL }}" alt="{{ .ProductName }}" loading="lazy"
                 onload="this.style.opacity='1'; this.nextElementSibling.style.display='none';"
                 onerror="this.nextElementSibling.style.display='flex';">
            <div class="product-img-fallback">
                <i class="bi bi-box-seam"></i>
            </div>
            {{ else }}
            <div class="product-img-fallback">
                <i class="bi bi-box-seam"></i>
            </div>
            {{ end }}
        </div>
        <div class="card-body p-3">
            <div class="product-name">{{ .ProductName }}</div>
            <div class="product-cat mb-1">{{ badgifyCategories .Categories 3 }}</div>
            <div class="product-cat font-monospace mb-2">{{- .Barcode -}}</div>
            <span class="badge-status badge-{{ expiryStatusClass .ExpireAt }}">
                <i class="bi bi-{{ expiryStatusIcon .ExpireAt }}" aria-hidden="true"></i>
                {{ expiryStatusLabel .ExpireAt }}
            </span>
            <div class="product-meta mt-2">
                <i class="bi bi-calendar-event" aria-hidden="true"></i> {{ .ExpireAt | humanDate }}
            </div>
            {{ $urgency := expiryUrgencyText .ExpireAt }}
            {{ if $urgency }}
            <div class="product-meta mt-1 fw-semibold" style="color: var(--status-{{ expiryStatusClass .ExpireAt }});">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span class="urgency-text d-none d-sm-inline">{{ $urgency }}</span>
                <span class="urgency-days d-inline d-sm-none">{{ expiryDays .ExpireAt }}</span>
            </div>
            {{ end }}
        </div>
        <ul class="list-group list-group-flush">
            {{ if .StorageLocation }}
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-geo-alt me-2" aria-hidden="true"></i>Location
                </span>
                <span class="badge bg-light text-dark border">{{ .StorageLocation.Icon }} {{ .StorageLocation.Name }}</span>
            </li>
            {{ end }}
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-stack me-2" aria-hidden="true"></i>Amount
                </span>
                <span class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-proviant-secondary btn-amount-dec" data-product-id="{{ .Model.ID }}" aria-label="Decrease amount">-</button>
                    <span id="amount-{{ .Model.ID }}" class="mx-1">{{ .Amount }}</span>
                    <button class="btn btn-sm btn-proviant-secondary btn-amount-inc" data-product-id="{{ .Model.ID }}" aria-label="Increase amount">+</button>
                </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-upc-scan me-2" aria-hidden="true"></i>Scanned
                </span>
                <span class="product-meta">{{ .ScannedAt | humanDateTime }}</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <span class="text-secondary-custom small">
                    <i class="bi bi-bell me-2" aria-hidden="true"></i>Notified
                </span>
                <span class="product-meta">{{ .NotifiedAt | humanDateTime }}</span>
            </li>
        </ul>
    </div>
</div>

{{ end }}

{{ end }}
