{{ define "_settings_profile" }}
<div class="card card-section mb-7">
    <div class="card-header d-flex flex-row justify-content-between align-items-center py-5 px-7">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-chip" aria-hidden="true">
                <i class="bi bi-person"></i>
            </div>
            <h2 class="h5 mb-0 fw-semibold">{{ t "settings.personalDetails" }}</h2>
        </div>
        <button type="button" class="btn btn-solid theme-primary btn-sm" id="btnUpdatePersonalDetails">
            {{ t "settings.update" }}
        </button>
    </div>
    <div class="card-body px-7 py-7">
        <form id="userSettings" novalidate>
            <div class="row g-3">
                <div class="md:col-6">
                    <label for="inputDisplayName" class="form-label fw-medium">{{ t "settings.displayNameLabel" }}</label>
                    <input type="text" class="form-control" id="inputDisplayName"
                           value="{{ .User.DisplayName }}" autocomplete="nickname"
                           placeholder="{{ t "settings.displayNamePlaceholder" }}">
                    <div class="form-text">{{ t "settings.displayNameHelp" }}</div>
                </div>
                <div class="md:col-6">
                    <label for="inputMailAddress" class="form-label fw-medium">
                        {{ t "settings.mailAddressLabel" }} <span class="fg-danger" aria-hidden="true">*</span>
                    </label>
                    <input type="email" class="form-control" id="inputMailAddress"
                           value="{{ .User.MailAddress }}" aria-required="true" autocomplete="email">
                    <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "settings.mailAddressInvalid" }}</div>
                </div>
                <div class="md:col-6">
                    <label for="inputUsername" class="form-label fw-medium">{{ t "settings.usernameLabel" }}</label>
                    <input type="text" class="form-control" id="inputUsername"
                           value="{{ .User.Username }}" readonly autocomplete="username">
                    <div class="form-text fg-secondary">{{ t "settings.usernameHelp" }}</div>
                </div>
                <div class="md:col-6">
                    <label for="inputLanguage" class="form-label fw-medium">{{ t "settings.languageLabel" }}</label>
                    <select class="form-control" id="inputLanguage">
                        <option value="" {{ if eq .User.Language "" }}selected{{ end }}>{{ t "settings.languageAuto" }}</option>
                        {{ range .AvailableLanguages }}
                        <option value="{{ .Code }}" {{ if eq $.User.Language .Code }}selected{{ end }}>{{ .Name }}</option>
                        {{ end }}
                    </select>
                    <div class="form-text">{{ t "settings.languageHelp" }}</div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card card-section mb-7">
    <div class="card-header d-flex flex-row justify-content-between align-items-center py-5 px-7">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-chip" aria-hidden="true">
                <i class="bi bi-lock"></i>
            </div>
            <h2 class="h5 mb-0 fw-semibold">{{ t "settings.passwordTitle" }}</h2>
        </div>
        <button class="btn btn-solid theme-primary btn-sm" type="button" id="btnUpdatePassword">
            {{ t "settings.update" }}
        </button>
    </div>
    <div class="card-body px-7 py-7">
        <form id="passwordUpdate" novalidate>
            <div class="row g-3">
                <div class="md:col-6">
                    <label for="inputPassword" class="form-label fw-medium">
                        {{ t "settings.newPasswordLabel" }} <span class="fg-danger" aria-hidden="true">*</span>
                    </label>
                    <input id="inputPassword" type="password" class="form-control"
                           aria-required="true" autocomplete="new-password"
                           data-min-length="{{ .PasswordMinLength }}"
                           data-require-uppercase="{{ .PasswordRequireUppercase }}"
                           data-require-digit="{{ .PasswordRequireDigit }}"
                           data-require-special="{{ .PasswordRequireSpecial }}">
                    <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "settings.newPasswordInvalid" }}</div>
                    <ul class="list-unstyled small mt-1">
                        <li id="req-length"><i class="bi bi-circle me-1"></i>{{ t "settings.passwordReqLength" .PasswordMinLength }}</li>
                        {{ if .PasswordRequireUppercase }}
                        <li id="req-upper"><i class="bi bi-circle me-1"></i>{{ t "settings.passwordReqUppercase" }}</li>
                        {{ end }}
                        {{ if .PasswordRequireDigit }}
                        <li id="req-digit"><i class="bi bi-circle me-1"></i>{{ t "settings.passwordReqDigit" }}</li>
                        {{ end }}
                        {{ if .PasswordRequireSpecial }}
                        <li id="req-special"><i class="bi bi-circle me-1"></i>{{ t "settings.passwordReqSpecial" }}</li>
                        {{ end }}
                    </ul>
                </div>
                <div class="md:col-6">
                    <label for="inputPasswordVerification" class="form-label fw-medium">
                        {{ t "settings.confirmPasswordLabel" }} <span class="fg-danger" aria-hidden="true">*</span>
                    </label>
                    <input id="inputPasswordVerification" type="password" class="form-control"
                           aria-required="true" autocomplete="new-password">
                    <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "settings.passwordMismatch" }}</div>
                </div>
            </div>
        </form>
    </div>
</div>
{{ end }}