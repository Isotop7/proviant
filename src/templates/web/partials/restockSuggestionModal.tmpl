{{define "restockSuggestionModal"}}
<div id="restockSuggestionModal" class="modal fade" tabindex="-1"
     aria-labelledby="restockSuggestionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icon modal-icon-info" aria-hidden="true">
                    <i class="bi bi-cart-plus"></i>
                </div>
                <div class="modal-header-body">
                    <h5 id="restockSuggestionModalLabel" class="modal-title mb-0">Add to shopping list</h5>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="restockProductName" class="fw-semibold mb-2"></p>
                <p id="restockReason" class="text-secondary-custom small mb-3"></p>
                <div class="row g-2 align-items-end">
                    <div class="col-6">
                        <label for="restockQty" class="form-label small mb-1">Quantity</label>
                        <input type="number" min="1" step="1" id="restockQty" class="form-control" value="1">
                    </div>
                    <div class="col-6">
                        <label for="restockUnit" class="form-label small mb-1">Unit</label>
                        <input type="text" id="restockUnit" class="form-control" placeholder="e.g. L, kg, pcs">
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-end gap-2">
                <button type="button" class="btn btn-proviant-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-proviant-primary" id="restockConfirmBtn">Add to list</button>
            </div>
        </div>
    </div>
</div>
{{end}}
