{{define "restockSuggestionModal"}}
<dialog class="dialog" id="restockSuggestionModal" aria-labelledby="restockSuggestionModalLabel">
            <div class="dialog-header">
                <div class="dialog-icon dialog-icon-info" aria-hidden="true">
                    <i class="bi bi-cart-plus"></i>
                </div><h5 id="restockSuggestionModalLabel" class="dialog-title mb-0">{{ t "partial.restockSuggestionModal.title" }}</h5>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}"></button>
            </div>
            <div class="dialog-body">
                <p id="restockProductName" class="fw-semibold mb-3"></p>
                <p id="restockReason" class="fg-secondary small mb-5"></p>
                <div class="row g-2 align-items-end">
                    <div class="col-12">
                        <label for="restockQty" class="form-label small mb-1">{{ t "partial.restockSuggestionModal.quantity" }}</label>
                        <input type="number" min="1" step="1" id="restockQty" class="form-control" value="1">
                    </div>
                </div>
            </div>
            <div class="dialog-footer justify-content-end gap-3">
                <button type="button" class="btn btn-outline theme-secondary" data-bs-dismiss="dialog">{{ t "common.cancel" }}</button>
                <button type="button" class="btn btn-solid theme-primary" id="restockConfirmBtn">{{ t "partial.restockSuggestionModal.addToList" }}</button>
            </div>
        </dialog>
{{end}}
