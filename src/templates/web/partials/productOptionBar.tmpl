{{ define "productOptionBar" }}

<div class="btn-group" role="group" aria-label="{{ t "partial.productOptionBar.ariaLabel" }}">
    <button type="button" class="btn-bulk" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false">
        <i class="bi bi-download"></i> {{ t "partial.productOptionBar.export" }}
    </button>
    <div class="menu  export-menu">
      <a class="menu-item" href="#" id="export-products-csv">{{ t "partial.productOptionBar.exportProductsCsv" }}</a>
      <a class="menu-item" href="#" id="export-products-json">{{ t "partial.productOptionBar.exportProductsJson" }}</a>
      <a class="menu-item" href="#" id="export-archive-csv">{{ t "partial.productOptionBar.exportArchiveCsv" }}</a>
      <a class="menu-item" href="#" id="export-full-json">{{ t "partial.productOptionBar.exportFullJson" }}</a>
      <hr class="menu-divider">
      <a class="menu-item" href="#" id="btnImportProductsCSV"><i class="bi bi-upload me-2"></i>{{ t "partial.productOptionBar.importProducts" }}</a>
      <a class="menu-item" href="#" id="btnDownloadImportTemplate"><i class="bi bi-file-earmark-arrow-down me-2"></i>{{ t "partial.productOptionBar.downloadTemplate" }}</a>
{{ if .IsAdmin }}
      <hr class="menu-divider">
      <a class="menu-item" href="#" id="btnRestoreBackupJSON"><i class="bi bi-arrow-counterclockwise me-2"></i>{{ t "partial.productOptionBar.restoreBackup" }}</a>
{{ end }}
    
    </div>
</div>

{{ end }}
