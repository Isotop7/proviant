{{ define "productOptionBar" }}

<div class="btn-group" role="group" aria-label="Product card options bar">
    <button type="button" class="btn btn-proviant-secondary" id="edit-product" disabled>
        <i class="bi bi-pencil-square me-2"></i>Edit
    </button>
    <button type="button" class="btn btn-proviant-secondary btn-product-archive" id="archive-product">
        <i class="bi bi-archive me-2"></i>Archive
    </button>
    <button type="button" class="btn btn-proviant-danger btn-product-delete" id="delete-product">
        <i class="bi bi-calendar-x me-2"></i>Delete
    </button>
    <div class="btn-group" role="group">
        <button type="button" class="btn btn-proviant-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-download me-2"></i>Export
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#" id="export-products-csv">Products (CSV)</a></li>
            <li><a class="dropdown-item" href="#" id="export-products-json">Products (JSON)</a></li>
            <li><a class="dropdown-item" href="#" id="export-archive-csv">Archive (CSV)</a></li>
            <li><a class="dropdown-item" href="#" id="export-full-json">Full Export (JSON)</a></li>
        </ul>
    </div>
</div>

{{ end }}
