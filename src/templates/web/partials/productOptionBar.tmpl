{{ define "productOptionBar" }}

<div class="btn-group" role="group" aria-label="Product card options bar">
    <button type="button" class="btn btn-outline-info" id="edit-product" disabled>
        <i class="bi bi-pencil-square me-2"></i>Edit
    </button>
    <button type="button" class="btn btn-outline-warning btn-product-archive" id="archive-product">
        <i class="bi bi-archive me-2"></i>Archive
    </button>
    <button type="button" class="btn btn-outline-danger btn-product-delete" id="delete-product">
        <i class="bi bi-calendar-x me-2"></i>Delete
    </button>
</div>

{{ end }}
