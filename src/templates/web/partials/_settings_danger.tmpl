{{ define "_settings_danger" }}
<div class="card card-section card--danger mb-7" id="dangerZone">
    <div class="card-header d-flex flex-row align-items-center gap-3 py-5 px-7">
        <div class="icon-chip" aria-hidden="true">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <h2 class="h5 mb-0 fw-semibold text-status-expired">{{ t "household.dangerZone" }}</h2>
    </div>
    <div class="card-body px-7 py-7 d-flex flex-column gap-7">

        {{/* Create new household */}}
        <div>
            <label for="inputNewHouseholdName" class="form-label fw-medium">
                <i class="bi bi-house-add me-1"></i>{{ t "household.createNewHousehold" }}
            </label>
            <p class="text-fg-2 small mb-3">{{ t "household.createHouseholdHelp" }}</p>
            <div class="input-group input-width-480">
                <span class="input-group-text"><i class="bi bi-house"></i></span>
                <input type="text" class="form-control" id="inputNewHouseholdName"
                       placeholder="{{ t "household.householdName" }}" aria-label="{{ t "household.newHouseholdName" }}">
                <button type="button" class="btn btn-outline theme-secondary" id="btnCreateHousehold">
                    {{ t "household.createAndSwitch" }}
                </button>
            </div>
        </div>

        {{/* Leave household */}}
        <div class="d-flex justify-content-between align-items-start gap-5">
            <div>
                <p class="fw-medium mb-1"><i class="bi bi-box-arrow-left me-1"></i>{{ t "household.leaveHousehold" }}</p>
                <p class="text-fg-2 small mb-0">{{ t "household.leaveHouseholdHelp" }}</p>
            </div>
            <button type="button" class="btn btn-solid theme-danger flex-shrink-0" id="btnLeaveHousehold">{{ t "household.leave" }}</button>
        </div>

    </div>
</div>
{{ end }}
