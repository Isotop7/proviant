{{ define "emptyArchive" }}

<div class="d-flex justify-content-center py-5">
    <div class="empty">
        <div class="empty-icon empty-icon-accent">
            <i class="bi bi-clock-history" aria-hidden="true"></i>
        </div>
        <div class="empty-title">{{ t "partial.emptyArchive.title" }}</div>
        <div class="empty-desc">{{ t "partial.emptyArchive.desc" }}</div>
        <a class="btn btn-proviant-secondary btn-sm" href="/web/products">
            <i class="bi bi-arrow-return-left" aria-hidden="true"></i> {{ t "partial.emptyArchive.backToProducts" }}
        </a>
    </div>
</div>

{{ end }}
