{{ define "_settings_security" }}
<div class="card card-section mb-7">
    <div class="card-header d-flex flex-row justify-content-between align-items-center py-5 px-7">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-chip" aria-hidden="true">
                <i class="bi bi-key"></i>
            </div>
            <h2 class="h5 mb-0 fw-semibold">{{ t "settings.apiTokens" }}</h2>
        </div>
        <button type="button" class="btn btn-sm btn-outline theme-secondary" id="btnCreatePAT">
            {{ t "settings.createToken" }}
        </button>
    </div>
    <div class="card-body px-7 py-7">
        <p class="fg-secondary small mb-5">{{ t "settings.apiTokensHelp" }}</p>
        <ul class="list-group" id="patList">
            <li class="list-group-item text-center fg-secondary py-5" id="patLoading">
                <span class="spinner-border spinner-sm me-2" role="status" aria-hidden="true"></span>{{ t "common.loading" }}
            </li>
        </ul>
    </div>
</div>

<dialog class="dialog" id="createPatModal" aria-labelledby="createPatModalLabel">
            <div class="dialog-header">
                <h5 class="dialog-title" id="createPatModalLabel">{{ t "settings.createApiToken" }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="{{ t "a11y.close" }}"></button>
            </div>
            <div class="dialog-body">
                <form id="createPatForm">
                    <div class="mb-5">
                        <label for="inputPatName" class="form-label fw-medium">
                            {{ t "settings.tokenNameLabel" }} <span class="fg-danger" aria-hidden="true">*</span>
                        </label>
                        <input type="text" class="form-control" id="inputPatName" required>
                        <div class="invalid-feedback"><i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i>{{ t "settings.tokenNameInvalid" }}</div>
                    </div>
                    <div class="mb-5">
                        <label for="inputPatExpiry" class="form-label fw-medium">
                            {{ t "settings.tokenExpiresAtLabel" }} <span class="fg-secondary fw-normal">{{ t "settings.optional" }}</span>
                        </label>
                        <input type="datetime-local" class="form-control" id="inputPatExpiry">
                    </div>
                </form>
                <div id="newTokenDisplay" class="alert alert theme-success d-none">
                    <strong>{{ t "settings.tokenCreatedTitle" }}</strong> {{ t "settings.tokenCreatedHelp" }}
                    <pre class="mt-3 mb-0 font-monospace" id="newTokenValue"></pre>
                </div>
            </div>
            <div class="dialog-footer">
                <button type="button" class="btn btn-outline theme-secondary" data-bs-dismiss="dialog">{{ t "common.close" }}</button>
                <button type="button" class="btn btn-solid theme-primary" id="btnSavePAT">{{ t "settings.create" }}</button>
            </div>
        </dialog>

{{ if .IsAdmin }}
<div class="card card-section mb-7" id="auditLogSection">
    <div class="card-header d-flex flex-row justify-content-between align-items-center py-5 px-7">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-chip" aria-hidden="true">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h2 class="h5 mb-0 fw-semibold">{{ t "settings.activityLog" }}</h2>
        </div>
        <button type="button" class="btn btn-sm btn-outline theme-secondary" id="btnRefreshAuditLog"
                aria-label="{{ t "settings.refreshActivityLog" }}" title="{{ t "settings.refresh" }}">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </div>
    <div class="card-body p-0">
        <p class="fg-secondary small px-7 pt-5 mb-0">{{ t "settings.auditLogHelp" }}</p>
        <div class="audit-log-container" aria-live="polite" id="auditLogContainer">
            <ul class="list-group list-group-flush" id="auditLogList">
                <li class="list-group-item text-center fg-secondary py-7" id="auditLogLoading">
                    <span class="spinner-border spinner-sm me-2" role="status" aria-hidden="true"></span>
                    <span>{{ t "common.loading" }}</span>
                </li>
            </ul>
        </div>
        <div class="px-7 py-3 border-top bg-subtle">
            <small class="fg-secondary text-xs" id="auditLogMeta"></small>
        </div>
    </div>
</div>
{{ end }}
{{ end }}