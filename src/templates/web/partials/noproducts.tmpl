{{ define "noproducts" }}

<div class="d-flex justify-content-center py-5">
    <div class="empty">
        <div class="empty-icon empty-icon-accent">
            {{ if .QueryValue }}
            <i class="bi bi-search" aria-hidden="true"></i>
            {{ else }}
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            {{ end }}
        </div>
        {{ if .QueryValue }}
        <div class="empty-title">{{ t "partial.noProducts.noResultsTitle" }}</div>
        <div class="empty-desc">
            {{ t "partial.noProducts.noResultsMatched" }} "<strong>{{ .QueryValue }}</strong>".<br>
            {{ t "partial.noProducts.noResultsHint" }}
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="/web/products">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> {{ t "partial.noProducts.showAll" }}
        </a>
        {{ else }}
        <div class="empty-title">{{ t "partial.noProducts.emptyTitle" }}</div>
        <div class="empty-desc">{{ t "partial.noProducts.emptyDesc" }}</div>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <button class="btn btn-primary btn-sm" id="btnOpenAddProductModalEmpty">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ t "partial.noProducts.addProduct" }}
            </button>
            <button class="btn btn-outline-secondary btn-sm" id="btnImportProductsCSVEmpty">
                <i class="bi bi-upload" aria-hidden="true"></i> {{ t "partial.noProducts.importCsv" }}
            </button>
            {{ if .IsAdmin }}
            <button class="btn btn-outline-secondary btn-sm" id="btnRestoreBackupJSONEmpty">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> {{ t "partial.noProducts.restoreBackup" }}
            </button>
            {{ end }}
        </div>
        {{ end }}
    </div>
</div>

{{ end }}
