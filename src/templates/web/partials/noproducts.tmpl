{{ define "noproducts" }}

<div class="d-flex justify-content-center py-5">
    <div class="empty">
        <div class="empty-icon">
            {{ if .QueryValue }}
            <i class="bi bi-search" aria-hidden="true"></i>
            {{ else }}
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            {{ end }}
        </div>
        {{ if .QueryValue }}
        <div class="empty-title">No results found</div>
        <div class="empty-desc">
            No products matched "<strong>{{ .QueryValue }}</strong>".<br>
            Try a different search term or browse all products.
        </div>
        <a class="btn btn-proviant-secondary btn-sm" href="/web/products">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Show all products
        </a>
        {{ else }}
        <div class="empty-title">No products yet</div>
        <div class="empty-desc">Add your first product to start tracking expiry dates.</div>
        <a class="btn btn-proviant-primary btn-sm" href="/web/products/create">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add product
        </a>
        {{ end }}
    </div>
</div>

{{ end }}
