{{ define "nav" }}
<a href="/web" class="app__brand" aria-label="{{ t "a11y.goToHome" }}">
	<img src="/assets/icons/proviant_logo_192.png" alt="" class="app__brand-logo">
	<span class="app__brand-name">proviant</span>
</a>

<nav class="app__nav" aria-label="{{ t "a11y.primaryNavigation" }}">
		<a href="/web" class="nav-link{{ if eq .Title "Home" }} active{{ end }}"
			{{ if eq .Title "Home" }}aria-current="page"{{ end }}
			title="{{ t "nav.dashboard" }}">{{ t "nav.dashboard" }}
		</a>
		<a href="/web/products" class="nav-link{{ if eq .Title "Products" }} active{{ end }}"
			{{ if eq .Title "Products" }}aria-current="page"{{ end }}
			title="{{ t "nav.products" }}">{{ t "nav.products" }}
				{{ if .UrgentCount }}
				{{ if gt .UrgentCount 0 }}
				<span class="nav-badge">{{ .UrgentCount }}</span>
				{{ end }}
				{{ end }}
		</a>
		<a href="/web/shopping-list" class="nav-link{{ if eq .Title "Shopping List" }} active{{ end }}"
			{{ if eq .Title "Shopping List" }}aria-current="page"{{ end }}
			title="{{ t "nav.shoppingList" }}">{{ t "nav.shoppingList" }}
		</a>
		<a href="/web/mealplan" class="nav-link{{ if eq .Title "Meal Plan" }} active{{ end }}"
			{{ if eq .Title "Meal Plan" }}aria-current="page"{{ end }}
			title="{{ t "nav.mealPlan" }}">{{ t "nav.mealPlan" }}
		</a>
		<a href="/web/recipes" class="nav-link{{ if eq .Title "Recipes" }} active{{ end }}"
			{{ if eq .Title "Recipes" }}aria-current="page"{{ end }}
			title="{{ t "nav.recipes" }}">{{ t "nav.recipes" }}
		</a>
		<a href="/web/waste-analytics" class="nav-link{{ if eq .Title "Waste Analytics" }} active{{ end }}"
			{{ if eq .Title "Waste Analytics" }}aria-current="page"{{ end }}
			title="{{ t "nav.wasteAnalytics" }}">{{ t "nav.wasteAnalytics" }}
		</a>
		<a href="/web/user/settings" class="nav-link{{ if eq .Title "User Settings" }} active{{ end }}"
			{{ if eq .Title "User Settings" }}aria-current="page"{{ end }}
			title="{{ t "nav.settings" }}">{{ t "nav.settings" }}
		</a>
</nav>
{{ end }}