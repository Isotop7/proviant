{{ define "nav" }}
<nav class="pv-sidebar">
	<a href="/web" class="brand" aria-label="{{ t "a11y.goToHome" }}">
		<img src="/assets/icons/proviant_logo_192.png" alt="" class="brand-logo">
		<span class="brand-name">proviant</span>
	</a>
	<div class="nav-items">
		<a href="/web" class="pv-nav-item {{ if eq .Title "Home" }}active{{ end }}"
			{{ if eq .Title "Home" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.dashboard" }}">
			<i class="bi bi-speedometer2" aria-hidden="true"></i> {{ t "nav.dashboard" }}
		</a>
		<a href="/web/products" class="pv-nav-item {{ if eq .Title "Products" }}active{{ end }}"
			{{ if eq .Title "Products" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.products" }}">
			<i class="bi bi-box-seam" aria-hidden="true"></i> {{ t "nav.products" }}
			{{ if .UrgentCount }}
			{{ if gt .UrgentCount 0 }}
			<span class="nav-badge">{{ .UrgentCount }}</span>
			{{ end }}
			{{ end }}
		</a>
		<a href="/web/shopping-list" class="pv-nav-item {{ if eq .Title "Shopping List" }}active{{ end }}"
			{{ if eq .Title "Shopping List" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.shoppingList" }}">
			<i class="bi bi-cart3" aria-hidden="true"></i> {{ t "nav.shoppingList" }}
		</a>
		<a href="/web/mealplan" class="pv-nav-item {{ if eq .Title "Meal Plan" }}active{{ end }}"
			{{ if eq .Title "Meal Plan" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.mealPlan" }}">
			<i class="bi bi-calendar-week" aria-hidden="true"></i> {{ t "nav.mealPlan" }}
		</a>
		<a href="/web/recipes" class="pv-nav-item {{ if eq .Title "Recipes" }}active{{ end }}"
			{{ if eq .Title "Recipes" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.recipes" }}">
			<i class="bi bi-journal-richtext" aria-hidden="true"></i> {{ t "nav.recipes" }}
		</a>
		<a href="/web/waste-analytics" class="pv-nav-item {{ if eq .Title "Waste Analytics" }}active{{ end }}"
			{{ if eq .Title "Waste Analytics" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.wasteAnalytics" }}">
			<i class="bi bi-bar-chart-line" aria-hidden="true"></i> {{ t "nav.wasteAnalytics" }}
		</a>
		<a href="/web/user/settings" class="pv-nav-item {{ if eq .Title "User Settings" }}active{{ end }}"
			{{ if eq .Title "User Settings" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.settings" }}">
			<i class="bi bi-gear-wide-connected" aria-hidden="true"></i> {{ t "nav.settings" }}
		</a>
	</div>
	<div class="nav-version">
		<a href="https://github.com/Isotop7/proviant/releases/tag/{{ .Version }}"
		   target="_blank" rel="noopener" class="nav-version-link">
			{{ .Version }}
		</a>
	</div>
	<div class="nav-footer-section">
		<button class="pv-nav-item w-100" id="btnThemeToggle"
			aria-label="{{ t "a11y.toggleColorTheme" }}" title="{{ t "a11y.toggleColorTheme" }}">
			<i class="bi bi-circle-half" id="themeToggleIcon" aria-hidden="true"></i> {{ t "nav.theme" }}
		</button>
		<div class="position-relative">
			<button class="pv-nav-item w-100"
				data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ t "a11y.notifications" }}">
				<i class="bi bi-bell" aria-hidden="true"></i> {{ t "nav.notifications" }}
				<span class="nav-badge position-absolute d-none"
					id="notification-badge">0</span>
			</button>
			<div class="dropdown-menu p-0" id="notification-dropdown">
				<div class="px-3 py-2 border-bottom">
					<span class="fw-bold small">{{ t "nav.notifications" }}</span>
				</div>
				<div id="notification-items">
					<p class="text-body-secondary small px-3 py-2 mb-0">{{ t "common.loading" }}</p>
				</div>
			</div>
		</div>
		<a href="/web" id="btnLogout" class="pv-nav-item pv-nav-item--danger"
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.logout" }}">
			<i class="bi bi-escape" aria-hidden="true"></i> {{ t "nav.logout" }}
		</a>
	</div>
	<div class="nav-footer-meta d-flex flex-column gap-2">
		<a href="/web/licenses" class="nav-source-link {{ if eq .Title "Licenses" }}active{{ end }}"
			{{ if eq .Title "Licenses" }}aria-current="page"{{ end }}
			data-bs-toggle="tooltip" data-bs-placement="right" title="{{ t "nav.licenses" }}">
			<i class="bi bi-info-circle" aria-hidden="true"></i> {{ t "nav.licenses" }}
		</a>
		<a href="https://github.com/Isotop7/proviant" target="_blank" rel="noopener"
			class="nav-source-link"
			title="{{ t "nav.viewSource" }}">
			<i class="bi bi-git" aria-hidden="true"></i> proviant@GitHub
		</a>
	</div>
</nav>
{{ end }}