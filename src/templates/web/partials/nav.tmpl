{{ define "nav" }}
<nav class="pv-sidebar">
	<div class="brand">
		<img src="/assets/icons/header_transparent.png" alt="Proviant">
	</div>
	<div class="nav-items">
		<a href="/web" class="pv-nav-item {{ if eq .Title "Home" }}active{{ end }}"
			{{ if eq .Title "Home" }}aria-current="page"{{ end }}>
			<i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard
		</a>
		<a href="/web/products" class="pv-nav-item {{ if eq .Title "Products" }}active{{ end }}"
			{{ if eq .Title "Products" }}aria-current="page"{{ end }}>
			<i class="bi bi-box-seam" aria-hidden="true"></i> Products
			{{ if .UrgentCount }}
			{{ if gt .UrgentCount 0 }}
			<span class="nav-badge">{{ .UrgentCount }}</span>
			{{ end }}
			{{ end }}
		</a>
		<a href="/web/recipes" class="pv-nav-item {{ if eq .Title "Recipes" }}active{{ end }}"
			{{ if eq .Title "Recipes" }}aria-current="page"{{ end }}>
			<i class="bi bi-journal-richtext" aria-hidden="true"></i> Recipes
		</a>
		<a href="/web/user/settings" class="pv-nav-item {{ if eq .Title "User Settings" }}active{{ end }}"
			{{ if eq .Title "User Settings" }}aria-current="page"{{ end }}>
			<i class="bi bi-gear-wide-connected" aria-hidden="true"></i> Settings
		</a>
	</div>
	<div class="nav-footer-section">
		<div class="position-relative">
			<button class="pv-nav-item w-100"
				data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
				<i class="bi bi-bell" aria-hidden="true"></i> Notifications
				<span class="badge bg-danger rounded-pill position-absolute d-none"
					id="notification-badge">0</span>
			</button>
			<div class="dropdown-menu p-0" id="notification-dropdown">
				<div class="px-3 py-2 border-bottom">
					<span class="fw-bold small">Notifications</span>
				</div>
				<div id="notification-items">
					<p class="text-body-secondary small px-3 py-2 mb-0">Loading…</p>
				</div>
			</div>
		</div>
		<a href="/web" id="btnLogout" class="pv-nav-item pv-nav-item--danger">
			<i class="bi bi-escape" aria-hidden="true"></i> Logout
		</a>
	</div>
	<div class="nav-footer-meta">
		<a href="https://codeberg.org/Isotop7/proviant" target="_blank" rel="noopener"
			class="nav-source-link"
			title="View source on Codeberg">
			<i class="bi bi-git" aria-hidden="true"></i> proviant@Codeberg
		</a>
	</div>
</nav>
{{ end }}
