{{ define "nav" }}
<nav class="pv-sidebar">
	<div class="brand">
		<img src="/assets/icons/proviant_logo_256.png" alt="Proviant">
	</div>
	<div class="nav-items">
		<a href="/web" class="pv-nav-item {{ if eq .Title "Home" }}active{{ end }}"
			{{ if eq .Title "Home" }}aria-current="page"{{ end }}>
			<i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard
		</a>
		<a href="/web/products" class="pv-nav-item {{ if eq .Title "Products" }}active{{ end }}"
			{{ if eq .Title "Products" }}aria-current="page"{{ end }}>
			<i class="bi bi-box-seam" aria-hidden="true"></i> Products
		</a>
		<a href="/web/products/create" class="pv-nav-item {{ if or (eq .Title "Create product") (eq .Title "Scan Product") }}active{{ end }}"
			{{ if or (eq .Title "Create product") (eq .Title "Scan Product") }}aria-current="page"{{ end }}>
			<i class="bi bi-plus-circle" aria-hidden="true"></i> Add product
		</a>
		<a href="/web/products/archived" class="pv-nav-item {{ if eq .Title "ArchivedProducts" }}active{{ end }}"
			{{ if eq .Title "ArchivedProducts" }}aria-current="page"{{ end }}>
			<i class="bi bi-archive" aria-hidden="true"></i> Archive
		</a>
		<a href="/web/user/settings" class="pv-nav-item {{ if eq .Title "User Settings" }}active{{ end }}"
			{{ if eq .Title "User Settings" }}aria-current="page"{{ end }}>
			<i class="bi bi-gear-wide-connected" aria-hidden="true"></i> Settings
		</a>
	</div>
	<div style="padding: 8px; border-top: 1px solid var(--border-subtle);">
		<div class="position-relative" style="margin-bottom: 2px;">
			<button class="pv-nav-item w-100" style="background:none;border:none;text-align:left;cursor:pointer;"
				data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
				<i class="bi bi-bell" aria-hidden="true"></i> Notifications
				<span class="badge bg-danger rounded-pill position-absolute d-none"
					id="notification-badge" style="right:8px;top:50%;transform:translateY(-50%);">0</span>
			</button>
			<div class="dropdown-menu p-0" id="notification-dropdown">
				<div class="px-3 py-2 border-bottom">
					<span class="fw-bold small">Notifications</span>
				</div>
				<div id="notification-items">
					<p class="text-body-secondary small px-3 py-2 mb-0">Loading…</p>
				</div>
			</div>
		</div>
		<a href="/web" id="btnLogout" class="pv-nav-item" style="color: var(--status-expired);">
			<i class="bi bi-escape" aria-hidden="true"></i> Logout
		</a>
	</div>
	<div style="padding: 12px 16px; margin-top: auto; border-top: 1px solid var(--border-subtle);">
		<a href="https://codeberg.org/Isotop7/proviant" target="_blank" rel="noopener"
			style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--fg-3);text-decoration:none;"
			title="View source on Codeberg">
			<i class="bi bi-git" aria-hidden="true"></i> Codeberg
		</a>
	</div>
</nav>
{{ end }}
