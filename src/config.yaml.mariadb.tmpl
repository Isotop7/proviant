---
server:
  baseURL: "https://proviant.local.de"
  port: 5114
  host: ""
  maxUploadSizeMB: 5
  debug: false
  metricsEnabled: false
  authentication:
    tokenPassword: ""
    tokenLifetime: 8
    max_login_attempts: 3
    lockout_duration_mins: 10
    password_min_length: 12
    password_require_uppercase: false
    password_require_digit: false
    password_require_special: false
    password_check_breached: true
  twoFactor:
    enabled: false
    encryptionKey: "cHJvdmlhbnQtZGVmYXVsdC10b3RwLWtleS0wMDAwMDA="
    issuer: "Proviant"
    recoveryCodeCount: 10
  cors:
    allowAllOrigins: false
    allowedOrigins:
      - "http://localhost"
      - "http://myproviant.instance"
  securityHeaders:
    contentSecurityPolicy: "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
    csrf_token_max_age: 86400
  rateLimit:
    login_per_minute: 5
    signup_per_minute: 3
    export_per_minute: 1
    password_per_minute: 3
    scan_per_minute: 10
    recipes_per_minute: 6

calendar:
  tokenExpiryDays: 365
  expiringSoonDays: 30

database:
  engine: mariadb
  mariadb:
    host: 127.0.0.1
    port: 3306
    name: proviant
    user: root
    password: password

logging:
  enabled: true
  file: "proviant.log"

notification:
  enabled: true
  interval: 12
  smtp:
    host: 127.0.0.1
    port: 25
    ssl: false
    user: user
    fromAddress: sender@local.net
    password: password
  ntfy:
    url: https://ntfy.sh
    topic: default_topic
    timeout: 60
  monthlyWasteReport:
    day: 1
    hour: 8
  telegram:
    timeout: 10
  mailDigest:
    enabled: false
    defaultTime: "08:00"

openfoodfacts:
  url: https://world.openfoodfacts.org/api/v2/product
  timeout: 5
  cacheEnabled: true
  imageCacheEnabled: false
  imageCachePath: "data/images"
  dumpImportEnabled: false
  dumpImportExpiryDays: 7
  dumpUrl: https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
  dumpDeltaWindowDays: 14
  dumpStagingPath: data
  dumpDatabase: off_dump

ocr:
  enabled: true
  provider: "tesseract"
  languages: "deu+eng"
  timeout: 10
  receipt:
    enabled: false
    provider: "openai"
    apiKey: ""
    endpoint: ""
    model: ""
    timeout: 120

expiry:
  critical_threshold_days: 3
  soon_threshold_days: 7

recipe_api:
  provider: "themealdb"
  url: "https://www.themealdb.com/api/json/v1/1"
  timeout: 10
  cache_enabled: true
  cache_ttl: 24

shopping_list_sync:
  enabled: false
  interval_minutes: 15
  bring_enabled: false
  todoist_enabled: false

backup:
  enabled: false
  intervalHours: 24
  directory: "data/backups"
  retention: 7

restore:
  maxUploadSizeMB: 50
