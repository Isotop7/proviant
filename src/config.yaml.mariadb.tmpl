---
server:
  baseURL: "https://proviant.local.de"
  port: 5114
  # Bind address. Empty means every interface (needed in a container). Set to
  # 127.0.0.1 to serve loopback only.
  host: ""
  maxUploadSizeMB: 5
  debug: false
  authentication:
    tokenPassword: "secret key"
    tokenLifetime: 8
    max_login_attempts: 3
    lockout_duration_mins: 10
    password_min_length: 12
    password_require_uppercase: false
    password_require_digit: false
    password_require_special: false
    password_check_breached: true
  cors:
    allowAllOrigins: false
    allowedOrigins:
      - "http://localhost"
      - "http://myproviant.instance"
  # If proviant runs behind a reverse proxy (nginx, traefik, caddy), list the
  # proxy's IP CIDRs here so X-Forwarded-For / X-Real-IP headers are trusted
  # for rate limiting. Otherwise leave empty (or omit) — headers are ignored
  # and RemoteAddr is used instead.
  # trustedProxies:
  #   - "127.0.0.1/32"
  #   - "10.0.0.0/8"
  securityHeaders:
    contentSecurityPolicy: "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
    csrf_token_max_age: 86400
  rateLimit:
    login_per_minute: 5
    signup_per_minute: 3
    export_per_minute: 1
    password_per_minute: 3
    scan_per_minute: 10
    recipes_per_minute: 6

calendar:
  tokenExpiryDays: 365
  expiringSoonDays: 30

database:
  engine: mariadb
  mariadb:
    host: 127.0.0.1
    port: 3306
    name: proviant
    user: root
    password: password

logging:
  enabled: true
  file: "proviant.log"

notification:
  enabled: true
  interval: 12
  smtp:
    host: 127.0.0.1
    port: 25
    ssl: false
    user: user
    fromAddress: sender@local.net
    password: password
  ntfy:
    url: https://ntfy.sh
    topic: default_topic
    timeout: 60
  monthlyWasteReport:
    day: 1
    hour: 8
  telegram:
    timeout: 10
  mailDigest:
    enabled: false
    defaultTime: "08:00"

openfoodfacts:
  url: https://world.openfoodfacts.org/api/v2/product
  timeout: 5
  cacheEnabled: true
  imageCacheEnabled: false
  imageCachePath: "data/images"

ocr:
  enabled: true
  provider: "tesseract"
  languages: "deu+eng"
  timeout: 10

expiry:
  critical_threshold_days: 3
  soon_threshold_days: 7

recipe_api:
  provider: "themealdb"
  url: "https://www.themealdb.com/api/json/v1/1"
  timeout: 10
  cache_enabled: true
  cache_ttl: 24
  # Self-hosted providers (Mealie / Tandoor) — set provider, url and api_key
  # together. When enabling one you MUST also replace the url above: pointing a
  # self-hosted provider at the public TheMealDB URL would send your api_key and
  # your household's product names to a third party on every request.
  # provider: "mealie"
  # url: "https://mealie.example.com"
  # api_key: ""
  # or:
  # provider: "tandoor"
  # url: "https://tandoor.example.com"
  # api_key: ""
  #
  # A wrong self-hosted setup never stops the server from starting. It disables
  # recipe suggestions instead (the page returns no suggestions and no outbound
  # request is made) and logs a warning naming the problem, for both of:
  #   - a missing api_key, and
  #   - a url still pointing at the public TheMealDB host.
  # An http:// url is accepted but warns: the api_key and search keywords would
  # travel unencrypted, so prefer https:// unless the instance is LAN-only.
