{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "proviant — Design Tokens (W3C Design Tokens Format, 2026-06). Spiegel zu tokens.css. Single Source of Truth neben DESIGN.md.",
  "color": {
    "bg":            { "$value": "#FAF7F1", "$type": "color", "$description": "Crème-Papier, App-Hintergrund" },
    "surface":       { "$value": "#FFFFFF", "$type": "color", "$description": "Karten, Panels, Inset-Container" },
    "surface-warm":  { "$value": "#F1ECE0", "$type": "color", "$description": "Auth-Brand-Panel, Hervorhebung" },
    "fg":            { "$value": "#2A2A2A", "$type": "color", "$description": "Primäre Tinte, Überschriften" },
    "fg-2":          { "$value": "#4A4A4A", "$type": "color", "$description": "Sekundäre Tinte" },
    "muted":         { "$value": "#6B6B6B", "$type": "color", "$description": "Sekundärtext, Meta, Labels" },
    "meta":          { "$value": "#8A8A8A", "$type": "color", "$description": "Tertiärer Text, Zeitstempel" },
    "border":        { "$value": "#E5DFD3", "$type": "color", "$description": "Standard-Rahmen, Trennlinien" },
    "border-strong": { "$value": "#D5CDB8", "$type": "color", "$description": "Verstärkter Rahmen, Fokus-Feld" },
    "accent":        { "$value": "#5A8A7A", "$type": "color", "$description": "Salwei — primäre Aktion" },
    "accent-soft":   { "$value": "#DDE7E0", "$type": "color", "$description": "Salwei getintet, Hover-BG, Chips" },
    "accent-on":     { "$value": "#FFFFFF", "$type": "color", "$description": "Text auf Salwei" },
    "status-fresh":     { "$value": "#5A8A7A", "$type": "color", "$description": "Haltbarkeit > 7 Tage" },
    "status-soon":      { "$value": "#C2A24A", "$type": "color", "$description": "3 – 7 Tage" },
    "status-critical":  { "$value": "#C26A3F", "$type": "color", "$description": "1 – 2 Tage" },
    "status-expired":   { "$value": "#A24A4A", "$type": "color", "$description": "abgelaufen" },
    "success":  { "$value": "{color.status-fresh.$value}",  "$type": "color", "$description": "Alias" },
    "warn":     { "$value": "{color.status-soon.$value}",    "$type": "color", "$description": "Alias" },
    "danger":   { "$value": "{color.status-expired.$value}", "$type": "color", "$description": "Alias" },
    "info":     { "$value": "#5A7A8A", "$type": "color", "$description": "Hinweise, gedeckt" }
  },
  "shadow": {
    "flat":    { "$value": "none", "$type": "shadow" },
    "raised":  {
      "$value": "0 1px 2px rgba(80,60,30,0.06), 0 4px 12px rgba(80,60,30,0.08)",
      "$type": "shadow",
      "$description": "Hover-Karten, Dropdowns (Sepia, nicht neutral)"
    },
    "overlay": {
      "$value": "0 8px 24px rgba(80,60,30,0.12), 0 24px 48px rgba(80,60,30,0.10)",
      "$type": "shadow",
      "$description": "Modals, Toasts, Menüs"
    },
    "inset":   {
      "$value": "inset 0 0 0 1px {color.border.$value}",
      "$type": "shadow",
      "$description": "Fokussierte Felder, ausgewählte Listen-Items"
    },
    "focus":   {
      "$value": "inset 0 0 0 1px {color.accent.$value}",
      "$type": "shadow",
      "$description": "Aktives Feld"
    }
  },
  "focus": {
    "ring": {
      "$value": "0 0 0 3px {color.accent-soft.$value}",
      "$type": "shadow",
      "$description": "Tastatur-Fokus-Ring"
    }
  },
  "typography": {
    "font": {
      "display": { "$value": ["VendSans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "sans-serif"], "$type": "fontFamily" },
      "body":    { "$value": ["VendSans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "sans-serif"], "$type": "fontFamily" },
      "mono":    { "$value": ["DMMono", "ui-monospace", "SFMono-Regular", "JetBrains Mono", "Menlo", "monospace"], "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "display":  { "$value": "32px", "$type": "dimension" },
      "h1":       { "$value": "24px", "$type": "dimension" },
      "h2":       { "$value": "20px", "$type": "dimension" },
      "h3":       { "$value": "18px", "$type": "dimension" },
      "base":     { "$value": "15px", "$type": "dimension" },
      "base-bold":{ "$value": "15px", "$type": "dimension" },
      "sm":       { "$value": "13px", "$type": "dimension" },
      "xs":       { "$value": "11px", "$type": "dimension" },
      "eyebrow":  { "$value": "11px", "$type": "dimension" },
      "mono":     { "$value": "13px", "$type": "dimension" }
    },
    "leading": {
      "tight": { "$value": "1.20", "$type": "number" },
      "snug":  { "$value": "1.30", "$type": "number" },
      "body":  { "$value": "1.55", "$type": "number" },
      "mono":  { "$value": "1.40", "$type": "number" }
    },
    "tracking": {
      "tight":   { "$value": "-0.01em", "$type": "dimension" },
      "flat":    { "$value": "0",       "$type": "dimension" },
      "button":  { "$value": "0.04em",  "$type": "dimension" },
      "eyebrow": { "$value": "0.10em",  "$type": "dimension" }
    }
  },
  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",  "$type": "dimension" },
    "md":   { "$value": "8px",  "$type": "dimension" },
    "lg":   { "$value": "12px", "$type": "dimension" },
    "pill": { "$value": "999px","$type": "dimension" }
  },
  "motion": {
    "fast":  { "$value": "120ms", "$type": "duration" },
    "base":  { "$value": "180ms", "$type": "duration" },
    "slow":  { "$value": "240ms", "$type": "duration" },
    "ease":  { "$value": "cubic-bezier(0.23, 1, 0.32, 1)", "$type": "cubicBezier" }
  },
  "layout": {
    "container": {
      "max":        { "$value": "1120px", "$type": "dimension" },
      "gutter-desktop": { "$value": "48px", "$type": "dimension" },
      "gutter-tablet":  { "$value": "24px", "$type": "dimension" },
      "gutter-phone":   { "$value": "16px", "$type": "dimension" }
    },
    "sidebar-width":  { "$value": "240px", "$type": "dimension" },
    "topbar-height":  { "$value": "56px",  "$type": "dimension" },
    "field-height":   { "$value": "40px",  "$type": "dimension" },
    "field-height-hero":  { "$value": "48px", "$type": "dimension" },
    "field-height-compact":{ "$value": "32px", "$type": "dimension" }
  },
  "breakpoint": {
    "phone":   { "$value": "360px",  "$type": "dimension" },
    "tablet":  { "$value": "768px",  "$type": "dimension" },
    "desktop": { "$value": "1024px", "$type": "dimension" },
    "wide":    { "$value": "1440px", "$type": "dimension" }
  }
}
