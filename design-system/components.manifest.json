{
  "$schema": "https://opendesign.dev/schemas/components.manifest/v1",
  "name": "proviant",
  "version": "2026-10",
  "description": "Komponenten-Inventar für proviant-Frontend. Bootstrap 5.3 als Basis; Marken-Palette wird über --bs-*-Variablen eingespielt, eigene Helper-Klassen nur dort, wo Bootstrap keine passende Komponente bietet.",
  "tokenSource": "_tokens.scss",
  "tokenFile": "tokens.css",
  "tokenContract": "tokens.json",
  "deviations": "deviations.md",
  "base": {
    "framework": "Bootstrap 5.3.8",
    "source": "node_modules/bootstrap/scss, per `task css` nach src/assets/css/main.css kompiliert — kein CDN.",
    "iconLibrary": "bootstrap-icons 1.13.1, selbst gehostet (src/assets/fonts)",
    "colorBinding": "Salwei-Palette ist in --bs-primary, --bs-success, --bs-warning, --bs-danger, --bs-info, --bs-body-bg, --bs-body-color, --bs-border-color, --bs-border-radius-* gespiegelt. Komponenten erben daraus automatisch."
  },
  "classMapping": {
    "_comment": "Mapping eigener Klassen (alte Spec-Sheet) → Bootstrap-5.3-Klassen. Eigene Klassen sind NICHT 1:1 weiterzuführen, sondern durch Bootstrap-Klassen zu ersetzen.",
