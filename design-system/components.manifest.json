  "utilities": {
    "_comment": "Eigene Helper-Klassen, die nicht durch Bootstrap-Standard-Utilities abgedeckt sind.",
    "stack-2": "gap: var(--space-2); display: flex; flex-direction: column;",
    "stack-3": "gap: var(--space-3); display: flex; flex-direction: column;",
    "stack-4": "gap: var(--space-4); display: flex; flex-direction: column;",
    "stack-6": "gap: var(--space-6); display: flex; flex-direction: column;",
    "eyebrow": "font: var(--weight-semibold) var(--text-eyebrow)/var(--leading-tight) var(--font-body); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted);",
    "page-header": "page-header (eigene Klasse, da Bootstrap keine Brand-Pattern-Header kennt)",
    "page-header__brand": "page-header__brand (Wortmarke, kein h1)",
    "page-header__lead": "min-width: 0;",
    "page-header__count": "font: var(--weight-semibold) var(--text-display) / 1.15 var(--font-body); letter-spacing: var(--tracking-tight); font-variant-numeric: tabular-nums; color: var(--fg);",
    "page-header__sub": "font-size: var(--text-sm); color: var(--fg-2);",
    "page-header__meta": "font: var(--weight-semibold) var(--text-xs) / var(--leading-tight) var(--font-body); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted);",
    "page-header__title": "font: var(--weight-semibold) var(--text-h1) / var(--leading-tight) var(--font-body); letter-spacing: var(--tracking-tight); color: var(--fg);",
    "page-header__aside": "display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-3);",
    "page-nav": "page-nav (eigene Klasse, sticky Anker-Sektion-Navigation)",
    "app": "app (die Seite: Topnav, Inhalt, Fußzeile)",
    "bottom-nav": "bottom-nav (eigene Komponente, sticky mobile)",
    "modal--demo": "modal--demo (Demo-Modal ohne JS im Spec-Sheet sichtbar)",
