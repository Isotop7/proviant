{
  "scripts": {
    "build": "npm run css",
    "css-compile": "sass --style compressed --source-map --embed-sources --no-error-css --load-path=node_modules src/templates/scss/:src/assets/css/",
    "css-lint": "stylelint src/templates/scss/",
    "css-prefix": "postcss --replace src/assets/css/main.css --use autoprefixer --map",
    "css": "npm-run-all css-compile css-prefix",
    "test": "npm-run-all css-lint css"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.0.3",
    "@fontsource/pacifico": "^5.1.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.0",
    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "sass": "^1.69.6",
    "stylelint": "^16.1.0",
    "stylelint-config-twbs-bootstrap": "^13.0.0"
  }
}
