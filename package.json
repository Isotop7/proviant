{
  "scripts": {
    "build": "npm run css",
    "css-compile": "sass --style compressed --source-map --embed-sources --no-error-css --load-path=node_modules src/templates/web/scss/:src/static/css/",
    "css-lint": "stylelint src/templates/web/scss/",
    "css-prefix": "postcss --replace src/static/css/styles.css --use autoprefixer --map",
    "css": "npm-run-all css-compile css-prefix",
    "test": "npm-run-all css-lint css"
  },
  "dependencies": {
    "bootstrap": "^5.3.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "sass": "^1.69.6",
    "npm-run-all": "^4.1.5",
    "stylelint": "^16.1.0",
    "stylelint-config-twbs-bootstrap": "^13.0.0"
  }
}
