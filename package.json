{
  "scripts": {
    "build": "npm run css",
    "css-compile": "sass --style compressed --source-map --embed-sources --no-error-css --load-path=node_modules src/templates/scss/:src/assets/css/",
    "css-prefix": "postcss --replace src/assets/css/main.css --use autoprefixer --map",
    "css": "npm-run-all css-compile css-prefix",
    "lint-css": "stylelint src/templates/scss/",
    "lint-js": "eslint src/assets/js/",
    "lint-html": "htmlhint \"src/templates/web/**/*.tmpl\"",
    "test": "npm-run-all lint-css css"
  },
  "dependencies": {
    "@fontsource-variable/vend-sans": "^5.2.2",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/pacifico": "^5.2.7",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "htmlhint": "^1.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "sass": "^1.69.6",
    "stylelint": "^16.1.0",
    "stylelint-config-twbs-bootstrap": "^16.1.0"
  }
}
